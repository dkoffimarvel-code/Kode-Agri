<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 2.4 — Réception magasin avec gestion de la réception partielle -->
<record id="view_ka_reception_form" model="ir.ui.view">
    <field name="name">ka.reception.ka.form</field>
    <field name="model">ka.reception</field>
    <field name="arch" type="xml">
        <form string="Réception" class="o_ka_form">
            <header>
                <button string="Valider" name="action_valider" type="object" class="btn-primary" invisible="state == 'complete'"/>
                <button string="Réception partielle" name="action_reliquat" type="object" class="btn-secondary" invisible="state != 'partielle'"/>
                <button string="Imprimer étiquettes" name="action_etiquettes" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,partielle,complete"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group invisible="id">
                    <group><field name="commande_id" string="Commande"/></group>
                </group>
                <div class="o_ka_h3">Lignes de réception</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="product_id" string="Article"/>
                        <field name="commande" string="Commandé"/>
                        <field name="recu" string="Reçu"/>
                        <field name="reliquat" string="Reste à recevoir"/>
                        <field name="emplacement" string="Emplacement"/>
                        <field name="statut" string="Statut" optional="hide"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span><field name="info" readonly="1"/></div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.7 — Pièces jointes sur un document d'achat -->
<record id="view_ka_facture_form" model="ir.ui.view">
    <field name="name">ka.facture.ka.form</field>
    <field name="model">ka.facture</field>
    <field name="arch" type="xml">
        <form string="Facture fournisseur" class="o_ka_form">
            <header>
                <button string="Joindre un document" name="action_joindre" type="object" class="btn-primary" invisible="not id"/>
                <button string="Télécharger" name="action_telecharger" type="object" class="btn-secondary" invisible="not id"/>
                <button string="Confirmer" name="action_valider" type="object" class="btn-secondary" invisible="state == 'validee'"/>
                <button string="Contrôle facture" name="action_controle" type="object" class="btn-secondary" invisible="not id"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,provisoire,validee"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_docs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_docs"/></span><span class="o_stat_text">Pièces jointes</span></div>
                    </button>
                    <button name="action_controle" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="requis_txt"/></span><span class="o_stat_text">Pièces requises</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub">Document d'achat · pièces jointes</div>
                </div>
                <group invisible="id">
                    <group><field name="commande_id" string="Commande"/></group>
                </group>
                <div class="o_ka_info">Tout document d'achat (ticket, commande, réception, facture) peut recevoir des pièces jointes. Des pièces obligatoires peuvent être exigées avant validation.</div>
                <div class="o_ka_h3">Pièces jointes au document</div>
                <field name="doc_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="name" string="Document"/>
                        <field name="type" string="Type"/>
                        <field name="user_id" string="Ajouté par"/>
                        <field name="date" string="Date"/>
                        <field name="statut" string="Statut"/>
                        <field name="requis" string="Obligatoire" optional="hide"/>
                        <field name="fourni" string="Fournie" optional="hide"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Les pièces jointes sont conservées avec le document (auteur, date). Le rapprochement et la validation peuvent s'appuyer sur ces justificatifs.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.5 — Transfert entre entrepôts -->
<record id="view_ka_transfert_form" model="ir.ui.view">
    <field name="name">ka.transfert.ka.form</field>
    <field name="model">ka.transfert</field>
    <field name="arch" type="xml">
        <form string="Transfert" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Valider le transfert" name="action_valider" type="object" class="btn-primary" invisible="state == 'valide'"/>
                <button string="Imprimer le bon" name="action_imprimer" type="object" class="btn-secondary" invisible="not id"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,a_valider,valide"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">La validation génère une réception entrepôt et une expédition de stock enregistrée.</div>
                <group>
                    <group>
                        <field name="emetteur_id" string="Source"/>
                        <field name="destinataire_id" string="Destination"/>
                    </group>
                    <group>
                        <field name="date_prevue" string="Date prévue"/>
                        <field name="responsable" string="Responsable"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="product_id" string="Article"/>
                        <field name="qty" string="Quantité"/>
                        <field name="uom_id" string="UoM"/>
                        <field name="lot_id" string="Lot / Série"/>
                        <field name="statut" string="Statut" optional="hide"/>
                    </list>
                </field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.6 — Commande d'inventaire -->
<record id="view_ka_inventaire_form" model="ir.ui.view">
    <field name="name">ka.inventaire.ka.form</field>
    <field name="model">ka.inventaire</field>
    <field name="arch" type="xml">
        <form string="Inventaire" class="o_ka_form">
            <header>
                <button string="Démarrer le comptage" name="action_demarrer" type="object" class="btn-primary" invisible="state != 'session'"/>
                <button string="Valider l'inventaire" name="action_valider" type="object" class="btn-secondary" invisible="state == 'validee'"/>
                <button string="Imprimer les fiches de comptage" name="action_imprimer" type="object" class="btn-secondary" invisible="not id"/>
                <field name="state" widget="statusbar" statusbar_visible="session,comptage,validee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group invisible="id">
                    <group><field name="libelle" string="Libellé"/></group>
                    <group><field name="depot_id" string="Dépôt"/></group>
                </group>
                <div class="o_ka_h3">Lignes d'inventaire</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="product_id" string="Article"/>
                        <field name="location_id" string="Emplacement"/>
                        <field name="theorique" string="Théorique"/>
                        <field name="compte" string="Compté"/>
                        <field name="ecart" string="Écart"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>La validation génère les écritures d'ajustement valorisées et alimente le journal analytique via la routine.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_reception_tree" model="ir.ui.view">
    <field name="name">ka.reception.ka.tree</field>
    <field name="model">ka.reception</field>
    <field name="arch" type="xml"><list string="Réceptions"><field name="name"/><field name="commande_id"/><field name="reliquat_total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_facture_tree" model="ir.ui.view">
    <field name="name">ka.facture.ka.tree</field>
    <field name="model">ka.facture</field>
    <field name="arch" type="xml"><list string="Factures fournisseurs"><field name="name"/><field name="partner_id"/><field name="nb_docs"/><field name="requis_txt"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_transfert_tree" model="ir.ui.view">
    <field name="name">ka.transfert.ka.tree</field>
    <field name="model">ka.transfert</field>
    <field name="arch" type="xml"><list string="Transferts"><field name="name"/><field name="emetteur_id"/><field name="destinataire_id"/><field name="date_prevue"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_inventaire_tree" model="ir.ui.view">
    <field name="name">ka.inventaire.ka.tree</field>
    <field name="model">ka.inventaire</field>
    <field name="arch" type="xml"><list string="Inventaires"><field name="name"/><field name="libelle"/><field name="depot_id"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_reception" model="ir.actions.act_window"><field name="name">Réceptions</field><field name="res_model">ka.reception</field><field name="view_mode">list,form</field></record>
<record id="action_ka_facture" model="ir.actions.act_window"><field name="name">Factures fournisseurs</field><field name="res_model">ka.facture</field><field name="view_mode">list,form</field></record>
<record id="action_ka_transfert" model="ir.actions.act_window"><field name="name">Transferts</field><field name="res_model">ka.transfert</field><field name="view_mode">list,form</field></record>
<record id="action_ka_inventaire" model="ir.actions.act_window"><field name="name">Inventaire</field><field name="res_model">ka.inventaire</field><field name="view_mode">list,form</field></record>
<record id="action_ka_expedition" model="ir.actions.act_window"><field name="name">Expéditions</field><field name="res_model">stock.picking</field><field name="view_mode">list,form</field><field name="domain">[('picking_type_code', '=', 'outgoing')]</field></record>
<record id="action_ka_stock_etat" model="ir.actions.act_window"><field name="name">Stock par emplacement</field><field name="res_model">stock.quant</field><field name="view_mode">list</field><field name="domain">[('location_id.usage', '=', 'internal')]</field><field name="context">{'group_by': ['location_id']}</field></record>
</odoo>
