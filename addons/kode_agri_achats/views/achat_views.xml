<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 2.1 — Demande d'achat -->
<record id="view_ka_da_form" model="ir.ui.view">
    <field name="name">ka.da.ka.form</field>
    <field name="model">ka.da</field>
    <field name="arch" type="xml">
        <form string="Demande d'achat" class="o_ka_form">
            <header>
                <button string="Nouveau" name="action_creer" type="object" class="btn-primary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Lancer appel d'offres" name="action_demande_prix" type="object" class="btn-secondary" invisible="state not in ('en_cours', 'a_signer', 'signee')"/>
                <button string="Soumettre à signature" name="action_soumettre" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <button string="Signer" name="action_signer" type="object" class="btn-secondary" invisible="state != 'a_signer'"/>
                <button string="Transformer en commande" name="action_transformer" type="object" class="btn-secondary" invisible="state not in ('signee', 'appel_offres')"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,appel_offres,soldee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="objet" placeholder="Objet de la demande"/></div>
                </div>
                <group>
                    <group>
                        <field name="partner_id" string="Fournisseur de demande" required="1"/>
                        <field name="demandeur" string="Demandeur"/>
                        <field name="date_besoin" string="Date besoin"/>
                        <field name="site_id" string="Site demandeur"/>
                    </group>
                    <group>
                        <field name="depot_id" string="Entrepôt" required="1"/>
                        <field name="priorite" string="Priorité"/>
                        <field name="section_txt" string="Centre de coûts"/>
                    </group>
                </group>
                <div class="o_ka_h3">Articles demandés</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="product_id" string="Article"/>
                        <field name="designation" string="Description"/>
                        <field name="qty" string="Qté"/>
                        <field name="uom_id" string="UoM"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="montant" string="Estimation"/>
                    </list>
                </field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.2 — Appel d'offres — tableau comparatif des offres -->
<record id="view_ka_ao_form" model="ir.ui.view">
    <field name="name">ka.ao.ka.form</field>
    <field name="model">ka.ao</field>
    <field name="arch" type="xml">
        <form string="Appel d'offres" class="o_ka_form">
            <header>
                <button string="Comparer" name="action_comparer" type="object" class="btn-secondary" invisible="state != 'ouverte'"/>
                <button string="Sélectionner fournisseur" name="action_retenir" type="object" class="btn-primary" invisible="state not in ('ouverte', 'comparee')"/>
                <button string="Générer commande" name="action_generer_commande" type="object" class="btn-secondary" invisible="state != 'retenue'"/>
                <button string="Relancer un fournisseur" name="action_relancer" type="object" class="btn-secondary" invisible="state not in ('ouverte', 'comparee')"/>
                <field name="state" widget="statusbar" statusbar_visible="ouverte,comparee,retenue"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group invisible="id">
                    <group><field name="da_id" string="Demande d'achat"/></group>
                </group>
                <group invisible="not commande_id">
                    <group><field name="commande_id" string="Commande générée" readonly="1"/></group>
                </group>
                <div class="o_ka_info">La sélection du fournisseur le mieux-disant génère la commande d'achat.</div>
                <div class="o_ka_h3">Comparatif des offres</div>
                <field name="comparatif_html" nolabel="1" readonly="1"/>
                <div class="o_ka_h3">Réponses fournisseurs</div>
                <field name="offre_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="partner_id" string="Fournisseur"/>
                        <field name="delai" string="Délai (j)"/>
                        <field name="detail" string="Prix unitaires"/>
                        <field name="total" string="Total HT"/>
                        <field name="choix" string="Retenu"/>
                    </list>
                    <form string="Réponse fournisseur">
                        <group>
                            <group><field name="partner_id" string="Fournisseur"/><field name="delai" string="Délai (j)"/></group>
                            <group><field name="total" string="Total HT"/><field name="choix" string="Retenu"/></group>
                        </group>
                        <field name="ligne_ids" nolabel="1">
                            <list editable="bottom"><field name="da_ligne_id" string="Article"/><field name="prix" string="Prix unitaire"/></list>
                        </field>
                    </form>
                </field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.3 — Commande d'achat — validation du workflow -->
<record id="view_ka_commande_form" model="ir.ui.view">
    <field name="name">ka.commande.ka.form</field>
    <field name="model">ka.commande</field>
    <field name="arch" type="xml">
        <form string="Commande d'achat" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Confirmer la commande" name="action_signer" type="object" class="btn-primary" invisible="state not in ('en_cours', 'a_signer')"/>
                <button string="Annuler" name="action_annuler" type="object" class="btn-secondary" invisible="not id or state in ('recue', 'facturee', 'annulee')"/>
                <button string="Soumettre" name="action_soumettre" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <button string="Créer la réception" name="action_creer_reception" type="object" class="btn-secondary" invisible="state != 'signee'"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary" invisible="not id"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,a_signer,signee,recue"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_receptions" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_receptions"/></span><span class="o_stat_text">Réception</span></div>
                    </button>
                    <button name="action_open_factures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_factures"/></span><span class="o_stat_text">Facture</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">À la validation : réception entrepôt (articles stockables) ou réception de bon de travaux (maintenance).</div>
                <group>
                    <group>
                        <field name="partner_id" string="Fournisseur"/>
                        <field name="depot_id" string="Entrepôt"/>
                        <field name="type_lignes_txt" string="Type ligne"/>
                        <field name="site_id" string="Site de commande"/>
                    </group>
                    <group>
                        <field name="date_commande" string="Date commande"/>
                        <field name="incoterm" string="Incoterm"/>
                        <field name="section_txt" string="Centre de coûts"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="product_id" string="Article / Service"/>
                        <field name="type" string="Type"/>
                        <field name="qty" string="Qté"/>
                        <field name="prix" string="PU"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="montant" string="Sous-total" sum="Total HT"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Workflow : Brouillon → À confirmer → Confirmée. La confirmation déclenche la génération automatique des réceptions.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_da_tree" model="ir.ui.view">
    <field name="name">ka.da.ka.tree</field>
    <field name="model">ka.da</field>
    <field name="arch" type="xml"><list string="Demandes d'achat"><field name="name"/><field name="objet"/><field name="site_id"/><field name="demandeur"/><field name="date_besoin"/><field name="currency_id" column_invisible="1"/><field name="total" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_ao_tree" model="ir.ui.view">
    <field name="name">ka.ao.ka.tree</field>
    <field name="model">ka.ao</field>
    <field name="arch" type="xml"><list string="Appels d'offres"><field name="name"/><field name="da_id"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_commande_tree" model="ir.ui.view">
    <field name="name">ka.commande.ka.tree</field>
    <field name="model">ka.commande</field>
    <field name="arch" type="xml"><list string="Commandes d'achat"><field name="name"/><field name="partner_id"/><field name="date_commande"/><field name="currency_id" column_invisible="1"/><field name="total" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_da" model="ir.actions.act_window"><field name="name">Demandes d'achat</field><field name="res_model">ka.da</field><field name="view_mode">list,form</field></record>
<record id="action_ka_ao" model="ir.actions.act_window"><field name="name">Appels d'offres</field><field name="res_model">ka.ao</field><field name="view_mode">list,form</field></record>
<record id="action_ka_commande" model="ir.actions.act_window"><field name="name">Commandes d'achat</field><field name="res_model">ka.commande</field><field name="view_mode">list,form</field></record>
</odoo>
