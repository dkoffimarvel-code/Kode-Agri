<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 2.8 — Saisie d'un dossier d'import -->
<record id="view_ka_dossier_form" model="ir.ui.view">
    <field name="name">ka.dossier.import.ka.form</field>
    <field name="model">ka.dossier.import</field>
    <field name="arch" type="xml">
        <form string="Dossier d'import" class="o_ka_form">
            <header>
                <button string="Valider" name="action_valider" type="object" class="btn-primary" invisible="state != 'en_cours'"/>
                <button string="Ventiler les frais" name="action_ouvrir_ventilation" type="object" class="btn-secondary" invisible="not id or state != 'en_cours'"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary" invisible="not id"/>
                <button string="Clôturer" name="action_cloturer" type="object" class="btn-secondary" invisible="state != 'valide'"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,valide,cloture"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_articles" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_articles"/></span><span class="o_stat_text">Articles</span></div>
                    </button>
                    <button name="action_open_factures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_frais"/></span><span class="o_stat_text">Frais</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <div class="text-uppercase fw-bold small text-primary">Dossier d'import</div>
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group>
                        <field name="partner_id" string="Fournisseur étranger"/>
                        <field name="transitaire_id" string="Transitaire"/>
                        <field name="commande_id" string="Commande rattachée"/>
                        <field name="site_id" string="Site"/>
                    </group>
                    <group>
                        <field name="currency_id" string="Devise"/>
                        <field name="cours" string="Taux de change"/>
                        <field name="date_ouverture" string="Date d'ouverture"/>
                        <field name="section_txt" string="Centre de coûts" class="fst-italic"/>
                        <field name="company_currency_id" invisible="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Articles importés" name="articles">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id" string="Article"/>
                                <field name="qty" string="Qté"/>
                                <field name="poids" string="Poids (kg)" optional="hide"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="fob" string="Valeur FOB (XOF)" sum="Total"/>
                                <field name="frais" string="Frais ventilés" sum="Total"/>
                                <field name="cout_complet" string="Coût complet entrée" sum="Total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Frais d'approche" name="frais">
                        <field name="frais_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="type" string="Nature"/>
                                <field name="libelle" string="Libellé"/>
                                <field name="facture_ref" string="Facture du transitaire"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="montant" string="Montant (XOF)" sum="Total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Pièces jointes" name="pieces">
                        <div class="o_ka_info">Pièces justificatives du dossier (facture du transitaire, déclaration, certificat) : au moins une pièce est exigée avant validation (RG-2.2).</div>
                        <group><group><field name="nb_docs" string="Pièces jointes" readonly="1"/></group></group>
                    </page>
                </notebook>
                <div class="d-flex align-items-center gap-2">
                    <field name="attachment_ids" nolabel="1" widget="many2many_tags" readonly="1"/>
                    <button string="+ Joindre une pièce" name="action_joindre" type="object" class="btn-link" invisible="not id"/>
                </div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 2.10 — Ventilation des frais d'approche -->
<record id="view_ka_ventilation_form" model="ir.ui.view">
    <field name="name">ka.dossier.import.ka.ventilation.form</field>
    <field name="model">ka.dossier.import</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
        <form string="Ventilation des frais" class="o_ka_form">
            <header>
                <button string="Recalculer" name="action_recalculer" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <button string="Appliquer" name="action_ventiler" type="object" class="btn-primary" invisible="state != 'en_cours'"/>
                <button string="Annuler la ventilation" name="action_annuler_ventilation" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <button string="Retour au dossier" name="action_retour_dossier" type="object" class="btn-secondary"/>
                <field name="state" invisible="1"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="text-uppercase fw-bold small text-primary">Ventilation des frais d'approche</div>
                    <h1><field name="name" readonly="1"/></h1>
                </div>
                <group>
                    <group>
                        <field name="cle" string="Clé de répartition"/>
                    </group>
                    <group>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="total_frais" string="Total frais d'approche" class="fw-bold"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="product_id" string="Article"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="fob" string="Valeur FOB" sum="Total"/>
                        <field name="coef" string="Coefficient" sum="Total"/>
                        <field name="frais" string="Frais ventilés" sum="Total"/>
                        <field name="cout_complet" string="Coût complet" sum="Total"/>
                    </list>
                </field>
                <div class="o_ka_info o_ka_noicon">∑ Frais ventilés = total des frais d'approche × (valeur FOB de l'article / valeur FOB totale). <b>Recalcul automatique au changement de clé.</b></div>
                <group>
                    <group><field name="factures_txt" string="Factures de frais"/></group>
                    <group><field name="ajustement" string="Ajustement de valorisation"/></group>
                </group>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 2.9 — Liste des dossiers d'import -->
<record id="view_ka_dossier_liste_form" model="ir.ui.view">
    <field name="name">ka.dossier.liste.ka.form</field>
    <field name="model">ka.dossier.liste</field>
    <field name="arch" type="xml">
        <form string="Dossiers d'import" class="o_ka_form">
            <header>
                <button string="Nouveau" name="action_creer" type="object" class="btn-primary"/>
                <button string="Filtrer" name="action_filtrer" type="object" class="btn-secondary"/>
                <button string="Exporter" name="action_exporter" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_voir_en_cours" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_en_cours"/></span><span class="o_stat_text">En cours</span></div>
                    </button>
                    <button name="action_voir_valides" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_valides"/></span><span class="o_stat_text">Validés</span></div>
                    </button>
                    <button name="action_voir_clotures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_clotures"/></span><span class="o_stat_text">Clôturés ce mois</span></div>
                    </button>
                    <button name="action_voir_a_ventiler" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_a_ventiler"/></span><span class="o_stat_text">Frais à ventiler</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Dossiers d'import</h1>
                </div>
                <group>
                    <group>
                        <field name="statut" string="Statut"/>
                        <field name="transitaire_id" string="Transitaire"/>
                    </group>
                    <group>
                        <field name="regroupement" string="Regrouper par"/>
                        <field name="periode" string="Période"/>
                    </group>
                </group>
                <field name="dossier_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="name" string="N° dossier"/>
                        <field name="partner_id" string="Fournisseur étranger"/>
                        <field name="transitaire_id" string="Transitaire"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="cout_complet" string="Coût complet (XOF)"/>
                        <field name="state" string="Statut" widget="badge" decoration-warning="state == 'en_cours'" decoration-success="state == 'valide'" decoration-muted="state == 'cloture'"/>
                    </list>
                </field>
                <div class="text-end o_ka_hint"><field name="nb_txt" readonly="1"/></div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_dossier_tree" model="ir.ui.view">
    <field name="name">ka.dossier.import.ka.tree</field>
    <field name="model">ka.dossier.import</field>
    <field name="arch" type="xml"><list string="Dossiers d'import"><field name="name"/><field name="partner_id"/><field name="transitaire_id"/><field name="company_currency_id" column_invisible="1"/><field name="cout_complet"/><field name="state" widget="badge" decoration-warning="state == 'en_cours'" decoration-success="state == 'valide'" decoration-muted="state == 'cloture'"/></list></field>
</record>
<record id="action_ka_dossier" model="ir.actions.act_window"><field name="name">Dossiers d'import</field><field name="res_model">ka.dossier.import</field><field name="view_mode">list,form</field></record><record id="action_ka_dossier_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_dossier"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_dossier_tree"/></record><record id="action_ka_dossier_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_dossier"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_dossier_form"/></record>
<record id="action_ka_dossier_liste" model="ir.actions.act_window"><field name="name">Dossiers d'import</field><field name="res_model">ka.dossier.liste</field><field name="view_mode">form</field><field name="target">current</field></record>
</odoo>
