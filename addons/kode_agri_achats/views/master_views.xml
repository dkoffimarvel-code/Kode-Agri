<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_article_form" model="ir.ui.view">
    <field name="name">product.template.ka.form</field>
    <field name="model">product.template</field>
    <field name="arch" type="xml">
        <form string="Article" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Données de base</span><span class="o_ka_c">Articles</span><span class="o_ka_cur">Articles</span><span class="o_ka_fn">Fonction : GESITM</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Article</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="ka_statut" widget="badge" decoration-success="ka_statut in ('actif')"/>
                        </div>
                        <div class="o_ka_grid"><div class="o_ka_f"><label for="default_code" string="Article" class="o_ka_req"/><field name="default_code"/></div><div class="o_ka_f"><label for="name" string="Désignation" class="o_ka_req"/><field name="name"/></div><div class="o_ka_f"><label for="categ_id" string="Catégorie" class="o_ka_req"/><field name="categ_id"/></div><div class="o_ka_f"><label for="ka_statut" string="Statut"/><field name="ka_statut" readonly="1"/></div><div class="o_ka_f"><label for="ka_gestion" string="Gestion de stock" class="o_ka_req"/><field name="ka_gestion"/></div><div class="o_ka_f"><label for="tracking" string="Mode de gestion"/><field name="tracking"/></div><div class="o_ka_f"><label for="uom_id" string="Unité de stock" class="o_ka_req"/><field name="uom_id"/></div><div class="o_ka_f"><label for="ka_uom_achat_id" string="Unité d'achat" class="o_ka_req"/><field name="ka_uom_achat_id"/></div></div><notebook><page string="Identification"><div class="o_ka_info">Référence interne, désignation et catégorie de l'article.</div></page><page string="Gestion"><div class="o_ka_sec">Gestion et comptabilisation</div><div class="o_ka_grid"><div class="o_ka_f"><label for="ka_methode" string="Méthode de valorisation" class="o_ka_req"/><field name="ka_methode"/></div><div class="o_ka_f"><label for="ka_code_comptable_id" string="Code comptable" class="o_ka_req"/><field name="ka_code_comptable_id"/></div><div class="o_ka_f"><label for="ka_analytic_id" string="Section analytique"/><field name="ka_analytic_id" readonly="1"/></div><div class="o_ka_f"><label for="ka_niveau_taxe" string="Niveau de taxe"/><field name="ka_niveau_taxe"/></div></div><div class="o_ka_h3">Article-fournisseur</div><field name="seller_ids" nolabel="1"><list editable="bottom"><field name="partner_id" string="Fournisseur"/><field name="product_code" string="Réf. fournisseur"/><field name="price" string="Prix"/><field name="currency_id" string="Devise"/><field name="delay" string="Délai (j)"/></list></field><div class="o_ka_info">Les articles gérés en stock reçoivent la section « Achats stockés » par les règles de ventilation par défaut ; elle n'est pas modifiable en saisie.</div></page><page string="Unités"><div class="o_ka_info">L'unité de stock est celle de la fiche ; l'unité d'achat est reprise sur les commandes.</div></page><page string="Achats"><div class="o_ka_info">Les prix et délais fournisseurs sont saisis dans l'onglet Gestion (article-fournisseur).</div></page><page string="Comptabilité"><div class="o_ka_info">Les comptes (stock, charge, variation) sont hérités du code comptable de la catégorie.</div></page></notebook>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Créer" name="action_creer" type="object" class="o_ka_btn o_ka_primary"/><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Dupliquer" name="action_dupliquer" type="object" class="o_ka_btn"/><button string="Article-site" name="action_stock_par_site" type="object" class="o_ka_btn"/><button string="Article-fournisseur" name="action_historique_prix" type="object" class="o_ka_btn"/><div class="o_ka_side_t">Liens</div><button string="Stock par site" name="action_stock_par_site" type="object" class="o_ka_link"/><button string="Historique des prix" name="action_historique_prix" type="object" class="o_ka_link"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_categorie_form" model="ir.ui.view">
    <field name="name">product.category.ka.form</field>
    <field name="model">product.category</field>
    <field name="arch" type="xml">
        <form string="Catégorie article" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Paramétrage</span><span class="o_ka_c">Stocks</span><span class="o_ka_cur">Catégories article</span><span class="o_ka_fn">Fonction : GESTCS</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Catégorie article</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            
                        </div>
                        <div class="o_ka_kpis"><div class="o_ka_kpi"><field name="product_count" nolabel="1"/><span class="o_ka_kl">Articles rattachés</span></div></div><div class="o_ka_sec">Valeurs par défaut transmises aux articles</div><div class="o_ka_grid"><div class="o_ka_f"><label for="ka_code" string="Catégorie" class="o_ka_req"/><field name="ka_code"/></div><div class="o_ka_f"><label for="name" string="Intitulé" class="o_ka_req"/><field name="name"/></div><div class="o_ka_f"><label for="ka_gestion" string="Gestion de stock"/><field name="ka_gestion"/></div><div class="o_ka_f"><label for="ka_mode" string="Mode de gestion"/><field name="ka_mode"/></div><div class="o_ka_f"><label for="ka_methode" string="Méthode de valorisation" class="o_ka_req"/><field name="ka_methode"/></div><div class="o_ka_f"><label for="ka_code_comptable_id" string="Code comptable" class="o_ka_req"/><field name="ka_code_comptable_id"/></div><div class="o_ka_f"><label for="ka_analytic_id" string="Section analytique"/><field name="ka_analytic_id"/></div><div class="o_ka_f"><label for="ka_compteur_lot" string="Compteur lot"/><field name="ka_compteur_lot"/></div></div><div class="o_ka_h3">Code comptable — comptes associés</div><table class="o_ka_tbl"><thead><tr><th>Type de compte</th><th>Compte</th></tr></thead><tbody><tr><td>Stock</td><td><field name="ka_cpt_stock" nolabel="1" readonly="1"/></td></tr><tr><td>Achat (charge)</td><td><field name="ka_cpt_charge" nolabel="1" readonly="1"/></td></tr><tr><td>Variation de stock</td><td><field name="ka_cpt_variation" nolabel="1" readonly="1"/></td></tr></tbody></table><p class="o_ka_note">Méthode de valorisation, code comptable et section analytique sont proposés sur chaque article créé dans cette catégorie et restent modifiables sur la fiche article (sauf la section « Achats stockés »).</p>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Créer" name="action_creer" type="object" class="o_ka_btn o_ka_primary"/><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Dupliquer" name="action_dupliquer" type="object" class="o_ka_btn"/><button string="Articles rattachés" name="action_articles" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_fournisseur_form" model="ir.ui.view">
    <field name="name">res.partner.ka.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <form string="Fournisseur" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Données de base</span><span class="o_ka_c">Tiers</span><span class="o_ka_cur">Fournisseurs</span><span class="o_ka_fn">Fonction : GESBPS</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Fournisseur</h1><div class="o_ka_sub"><field name="ka_subtitle_frn" nolabel="1" readonly="1"/></div></div>
                            <field name="ka_statut" widget="badge" decoration-success="ka_statut in ('actif')"/>
                        </div>
                        <div class="o_ka_grid"><div class="o_ka_f"><label for="ka_code_frn" string="Fournisseur" class="o_ka_req"/><field name="ka_code_frn" readonly="1"/></div><div class="o_ka_f"><label for="name" string="Raison sociale" class="o_ka_req"/><field name="name"/></div><div class="o_ka_f"><label for="ka_categorie" string="Catégorie fournisseur" class="o_ka_req"/><field name="ka_categorie"/></div><div class="o_ka_f"><label for="vat" string="N° contribuable"/><field name="vat"/></div><div class="o_ka_f"><label for="ka_devise_achat_id" string="Devise" class="o_ka_req"/><field name="ka_devise_achat_id"/></div><div class="o_ka_f"><label for="property_supplier_payment_term_id" string="Condition de paiement"/><field name="property_supplier_payment_term_id"/></div><div class="o_ka_f"><label for="property_account_payable_id" string="Collectif" class="o_ka_req"/><field name="property_account_payable_id"/></div><div class="o_ka_f"><label for="property_account_position_id" string="Régime de taxe"/><field name="property_account_position_id"/></div></div><notebook><page string="Identité"><div class="o_ka_info">Identité et coordonnées principales du fournisseur.</div></page><page string="Adresses"><div class="o_ka_info">Adresses de livraison et de facturation : voir les contacts rattachés.</div></page><page string="Contacts"><div class="o_ka_h3">Contacts</div><field name="child_ids" nolabel="1"><list><field name="name" string="Nom"/><field name="function" string="Fonction"/><field name="phone" string="Téléphone"/><field name="email" string="E-mail"/></list></field></page><page string="Commande"><div class="o_ka_info">Conditions de commande : délai et incoterm par défaut repris sur les commandes.</div></page><page string="Comptabilité"><div class="o_ka_info">Collectif, régime de taxe et conditions de paiement sont repris sur les factures.</div></page></notebook><div class="o_ka_info">La catégorie « Frais généraux » n'ouvre ni compte d'avances ni règles de récupération, réservés à la catégorie Planteur &amp; coopérative.</div>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Créer" name="action_creer_frn" type="object" class="o_ka_btn o_ka_primary"/><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Dupliquer" name="action_dupliquer_frn" type="object" class="o_ka_btn"/><button string="Imprimer" name="action_imprimer_frn" type="object" class="o_ka_btn"/><div class="o_ka_side_t">Liens</div><button string="Commandes" name="action_open_commandes_frn" type="object" class="o_ka_link"/><button string="Factures" name="action_open_factures_frn" type="object" class="o_ka_link"/><button string="Balance âgée" name="action_open_balance_frn" type="object" class="o_ka_link"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_depot_form" model="ir.ui.view">
    <field name="name">stock.warehouse.ka.form</field>
    <field name="model">stock.warehouse</field>
    <field name="arch" type="xml">
        <form string="Dépôt" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Paramétrage</span><span class="o_ka_c">Stocks</span><span class="o_ka_cur">Dépôts</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Dépôt</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="ka_statut" widget="badge" decoration-success="ka_statut in ('actif')"/>
                        </div>
                        <div class="o_ka_sec">Identification</div><div class="o_ka_grid"><div class="o_ka_f"><label for="ka_site_id" string="Site" class="o_ka_req"/><field name="ka_site_id"/></div><div class="o_ka_f"><label for="code" string="Dépôt" class="o_ka_req"/><field name="code"/></div><div class="o_ka_f"><label for="name" string="Intitulé" class="o_ka_req"/><field name="name"/></div><div class="o_ka_f"><label for="company_id" string="Société"/><field name="company_id" readonly="1"/></div><div class="o_ka_f"><label for="ka_adresse" string="Adresse"/><field name="ka_adresse"/></div><div class="o_ka_f"><label for="reception_steps" string="Réception"/><field name="reception_steps"/></div><div class="o_ka_f"><label for="ka_reappro" string="Réapprovisionnement"/><field name="ka_reappro"/></div><div class="o_ka_f"><label for="ka_statut_reception" string="Statut à la réception"/><field name="ka_statut_reception"/></div></div><div class="o_ka_h3">Emplacements du site</div><field name="ka_location_ids" nolabel="1" readonly="1"><list><field name="name" string="Emplacement"/><field name="ka_type" string="Type"/><field name="warehouse_id" string="Dépôt"/><field name="ka_statuts" string="Statuts autorisés"/><field name="ka_usage" string="Usage"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Créer" name="action_creer" type="object" class="o_ka_btn o_ka_primary"/><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Emplacements" name="action_emplacements" type="object" class="o_ka_btn"/><button string="Types d'emplacement" name="action_types_emplacement" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_structure_form" model="ir.ui.view">
    <field name="name">ka.structure.ka.form</field>
    <field name="model">ka.structure</field>
    <field name="arch" type="xml">
        <form string="Données de structure — achats et stocks" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Paramétrage</span><span class="o_ka_c">Structure</span><span class="o_ka_cur">Sociétés, sites et compteurs</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Données de structure — achats et stocks</h1><div class="o_ka_sub"></div></div>
                            
                        </div>
                        <div class="o_ka_info">Données partagées par tous les modules : elles conditionnent l'imputation analytique et la numérotation des documents d'achat.</div><div class="o_ka_h3">Sociétés et sites</div><field name="site_ids" nolabel="1"><list editable="bottom"><field name="code" string="Code"/><field name="name" string="Intitulé"/><field name="type" string="Type"/><field name="legislation" string="Législation"/></list></field><div class="o_ka_h3">Sections analytiques (axe ACTIVITE)</div><field name="section_ids" nolabel="1"><list editable="bottom"><field name="code" string="Section"/><field name="name" string="Intitulé"/><field name="nature" string="Nature"/><field name="modifiable" string="Modifiable en saisie"/></list></field><div class="o_ka_h3">Compteurs et devise</div><field name="compteur_ids" nolabel="1"><list editable="bottom"><field name="objet" string="Objet"/><field name="compteur" string="Compteur"/><field name="exemple" string="Exemple"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Exporter" name="action_exporter" type="object" class="o_ka_btn"/><button string="Importer" name="action_importer" type="object" class="o_ka_btn"/><button string="Contrôler le paramétrage" name="action_controler" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
