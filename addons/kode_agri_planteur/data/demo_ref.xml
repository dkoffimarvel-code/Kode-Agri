<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_fdt_hevea" model="product.product">
        <field name="name">Fond de tasse Hevea</field>
        <field name="default_code">FDT-HEVEA</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">lot</field>
        <field name="purchase_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
    </record>
    <record id="regle_taux30" model="ka.avance.regle"><field name="name">Taux fixe 30 %</field><field name="mode">taux</field><field name="taux">30</field></record>
    <record id="regle_total" model="ka.avance.regle"><field name="name">100 % sur le prochain décompte</field><field name="mode">total</field><field name="taux">100</field></record>
    <record id="regle_plafond" model="ka.avance.regle"><field name="name">Plafond par décompte</field><field name="mode">plafond</field></record>
    <record id="cron_generation_batch" model="ir.cron">
        <field name="name">Kode Agri — Génération réceptions et factures (batch)</field>
        <field name="model_id" ref="model_ka_generation"/>
        <field name="state">code</field>
        <field name="code">model.cron_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
