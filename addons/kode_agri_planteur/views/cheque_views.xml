<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_cheque_form" model="ir.ui.view">
    <field name="name">ka.cheque.ka.form</field>
    <field name="model">ka.cheque</field>
    <field name="arch" type="xml">
        <form string="Règlement fournisseur — chèque" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Comptabilité</span><span class="o_ka_c">Règlements</span><span class="o_ka_cur">Saisie des règlements</span><span class="o_ka_fn">Fonction : GESPAY</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Règlement fournisseur — chèque</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-warning="state in ('a_imprimer')" decoration-success="state in ('imprime','comptabilise','lettre')"/>
                        </div>
                        <div class="o_ka_info">Chèque émis pour un apporteur en mode de règlement « chèque ». Le montant est le net à payer du décompte (apports + primes − avances − retenues).</div><div class="o_ka_sec">En-tête</div><div class="o_ka_grid"><div class="o_ka_f"><label for="type_reglement" string="Type de règlement" class="o_ka_req"/><field name="type_reglement"/></div><div class="o_ka_f"><label for="partner_id" string="Tiers" class="o_ka_req"/><field name="partner_id"/></div><div class="o_ka_f"><label for="journal_id" string="Banque" class="o_ka_req"/><field name="journal_id"/></div><div class="o_ka_f"><label for="date" string="Date" class="o_ka_req"/><field name="date"/></div><div class="o_ka_f"><label for="numero_cheque" string="N° de chèque" class="o_ka_req"/><field name="numero_cheque"/></div><div class="o_ka_f"><label for="amount" string="Montant" class="o_ka_req"/><field name="amount" readonly="1"/></div><div class="o_ka_f"><label for="amount_words" string="Montant en lettres"/><field name="amount_words" readonly="1"/></div><div class="o_ka_f"><label for="decompte" string="Décompte"/><field name="decompte"/></div></div><div class="o_ka_h3">Détail du net réglé</div><field name="detail_ids" nolabel="1"><list editable="bottom"><field name="element" string="Élément"/><field name="detail" string="Détail"/><field name="montant" string="Montant" sum="Net du chèque"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Imprimer le chèque" name="action_imprimer" type="object" class="o_ka_btn o_ka_primary"/><button string="Comptabiliser" name="action_comptabiliser" type="object" class="o_ka_btn"/><button string="Lettrer" name="action_lettrer" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_cheque_tree" model="ir.ui.view">
    <field name="name">ka.cheque.ka.tree</field>
    <field name="model">ka.cheque</field>
    <field name="arch" type="xml"><list string="ka_cheque"><field name="name"/><field name="partner_id"/><field name="numero_cheque"/><field name="date"/><field name="amount" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_cheque" model="ir.actions.act_window">
    <field name="name">Règlements fournisseurs — chèques</field>
    <field name="res_model">ka.cheque</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
