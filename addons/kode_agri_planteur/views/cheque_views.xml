<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_cheque_form" model="ir.ui.view">
    <field name="name">ka.cheque.ka.form</field>
    <field name="model">ka.cheque</field>
    <field name="arch" type="xml">
        <form string="Chèque" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Approuver" name="action_approuver" type="object" class="btn-primary" invisible="state not in ('brouillon', 'a_approuver')"/>
                <button string="Imprimer le chèque" name="action_imprimer" type="object" class="btn-secondary"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-secondary" invisible="payment_id"/>
                <button string="Soumettre" name="action_soumettre" type="object" class="btn-secondary" invisible="state != 'brouillon'"/>
                <button string="Lettrer" name="action_lettrer" type="object" class="btn-secondary" invisible="state != 'comptabilise'"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,a_approuver,imprime,comptabilise"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_partner" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="type_reglement"/></span><span class="o_stat_text">Mode règlement</span></div>
                    </button>
                    <button name="action_open_decompte" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="amount_txt"/></span><span class="o_stat_text">Montant</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Chèque <field name="name" readonly="1" class="oe_inline"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Chèque émis pour un planteur en mode de règlement « chèque ». Le montant correspond au net à payer du décompte (livraisons + primes − avances − retenues).</div>
                <group>
                    <group>
                        <field name="partner_id" string="Bénéficiaire" required="1"/>
                        <field name="type_tiers" string="Type de tiers" widget="badge"/>
                        <field name="type_reglement" string="Mode de règlement" widget="badge" decoration-success="type_reglement == 'chq'" required="1"/>
                        <field name="decompte" string="Décompte réglé"/>
                    </group>
                    <group>
                        <field name="journal_id" string="Banque émettrice" required="1"/>
                        <field name="numero_cheque" string="N° de chèque" required="1" class="fw-bold"/>
                        <field name="date" string="Date d'émission" required="1"/>
                        <field name="amount_words" string="Montant en lettres" readonly="1"/>
                        <field name="payment_id" string="Paiement" invisible="not payment_id"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="o_ka_h3"><field name="detail_titre" readonly="1"/></div>
                <field name="detail_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="element" string="Élément"/>
                        <field name="detail" string="Détail"/>
                        <field name="montant" string="Montant" sum="Net du chèque"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Approbation trésorerie → impression du chèque → remise au bénéficiaire → comptabilisation et lettrage de la facture d'achat réglée.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_cheque_tree" model="ir.ui.view">
    <field name="name">ka.cheque.ka.tree</field>
    <field name="model">ka.cheque</field>
    <field name="arch" type="xml"><list string="ka_cheque"><field name="name"/><field name="partner_id"/><field name="numero_cheque"/><field name="date"/><field name="amount" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_cheque" model="ir.actions.act_window">
    <field name="name">Paiements</field>
    <field name="res_model">ka.cheque</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
