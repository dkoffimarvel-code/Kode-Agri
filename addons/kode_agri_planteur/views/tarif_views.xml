<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_tarif_form" model="ir.ui.view">
    <field name="name">ka.tarif.ka.form</field>
    <field name="model">ka.tarif</field>
    <field name="arch" type="xml">
        <form string="Prix Apromac" class="o_ka_form">
            <header>
                <button string="Nouveau mois" name="action_nouveau_mois" type="object" class="btn-primary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Activer" name="action_activer" type="object" class="btn-secondary" invisible="state == 'actif'"/>
                <button string="Fermer la période" name="action_fermer" type="object" class="btn-secondary" invisible="state != 'actif'"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,actif"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="ka_titre" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Le prix Apromac est défini chaque mois. Le ticket est facturé au prix du mois concerné selon le lieu de livraison.</div>
                <div class="o_ka_h3">Barèmes du mois</div>
                <field name="bareme_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="name" string="Barème"/>
                        <field name="lieu" string="Lieu de livraison"/>
                        <field name="prix_kg" string="Prix au kg humide"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <notebook>
                    <page string="Période et critères" name="periode">
                        <group>
                            <group>
                                <field name="date_start" string="Date début validité" required="1"/>
                                <field name="date_end" string="Date fin validité" required="1"/>
                                <field name="code" string="Code tarif" readonly="1"/>
                                <field name="product_id" string="Article"/>
                            </group>
                            <group>
                                <field name="critere" string="Critère"/>
                                <field name="uom_label" string="Unité" readonly="1"/>
                                <field name="currency_id" string="Devise"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_tarif_tree" model="ir.ui.view">
    <field name="name">ka.tarif.ka.tree</field>
    <field name="model">ka.tarif</field>
    <field name="arch" type="xml"><list string="ka_tarif"><field name="code"/><field name="date_start"/><field name="date_end"/><field name="state" widget="badge" decoration-success="state=='actif'"/></list></field>
</record>
<record id="action_ka_tarif" model="ir.actions.act_window">
    <field name="name">Prix Apromac</field>
    <field name="res_model">ka.tarif</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
