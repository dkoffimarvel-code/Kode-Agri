<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_planteur_form" model="ir.ui.view">
    <field name="name">res.partner.ka.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <form string="Planteur ou coopérative" class="o_ka_form">
            <header>
                <button string="Nouveau" name="action_creer_partner" type="object" class="btn-primary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Octroyer avance" name="action_octroyer_avance" type="object" class="btn-secondary"/>
                <button string="Imprimer" name="action_imprimer_fiche" type="object" class="btn-secondary"/>
                <field name="ka_statut" widget="statusbar" statusbar_visible="brouillon,actif,archive"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_tickets" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ka_nb_apports"/></span><span class="o_stat_text">Livraisons</span></div>
                    </button>
                    <button name="action_open_avances" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ka_solde_avance_k"/></span><span class="o_stat_text">Solde avance</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" placeholder="Nom du planteur ou de la coopérative"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="ka_code" string="Code planteur" readonly="1"/>
                        <field name="ka_categorie" string="Type fournisseur" widget="badge" required="1"/>
                        <field name="ka_cooperative_id" string="Coopérative"/>
                        <field name="phone" string="Téléphone"/>
                    </group>
                    <group>
                        <field name="ka_bareme_id" string="Prix kg humide" required="1"/>
                        <field name="ka_mode_reglement" string="Mode règlement" required="1"/>
                        <field name="ka_visible_collecte" string="Visible collecte"/>
                        <field name="ka_parcelles_txt" string="Parcelles EUDR"/>
                    </group>
                </group>
                <notebook>
                    <page string="Conditions de livraison" name="conditions">
                        <div class="o_ka_h3">Parcelles d'origine (EUDR)</div>
                        <field name="ka_parcelle_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="name" string="Référence"/>
                                <field name="surface" string="Surface (ha)"/>
                                <field name="latitude" string="Latitude"/>
                                <field name="longitude" string="Longitude"/>
                                <field name="clone" string="Clone"/>
                                <field name="statut_eudr" string="Statut" widget="badge" decoration-success="statut_eudr=='conforme'" decoration-warning="statut_eudr=='a_verifier'" decoration-danger="statut_eudr=='non_conforme'"/>
                            </list>
                        </field>
                    </page>
                    <page string="Compte courant" name="compte_courant">
                        <div class="o_ka_h3">Avances de campagne</div>
                        <field name="ka_avance_ids" nolabel="1" readonly="1">
                            <list><field name="name"/><field name="nature"/><field name="amount"/><field name="date_octroi"/><field name="state" widget="badge"/></list>
                        </field>
                    </page>
                    <page string="Parcelles EUDR" name="eudr">
                        <div class="o_ka_info">Le statut EUDR de la livraison et du lot est l'ET logique des statuts des parcelles d'origine (RG-1.12) ; il est propagé au mélange, aux OF et aux colis.</div>
                    </page>
                    <page string="Comptabilité" name="compta">
                        <group>
                            <group>
                                <field name="property_account_payable_id" string="Compte fournisseur"/>
                                <field name="property_account_position_id" string="Position fiscale"/>
                            </group>
                            <group>
                                <field name="property_supplier_payment_term_id" string="Conditions de paiement"/>
                                <field name="ka_code_acces" string="Code d'accès"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_planteur_tree" model="ir.ui.view">
    <field name="name">res.partner.ka.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml"><list string="ka_planteur"><field name="ka_code"/><field name="name"/><field name="ka_categorie"/><field name="ka_cooperative_id"/><field name="phone"/><field name="ka_mode_reglement"/><field name="ka_solde_avance"/></list></field>
</record>
<record id="action_ka_planteur" model="ir.actions.act_window">
    <field name="name">Planteurs et coopératives</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('ka_categorie', '=', 'planteur_coop')]</field>
    <field name="context">{'default_ka_categorie': 'planteur_coop', 'default_supplier_rank': 1}</field>
</record>
<record id="action_ka_planteur_tree" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_planteur"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_planteur_tree"/></record>
<record id="action_ka_planteur_form" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_planteur"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_planteur_form"/></record>
</odoo>
