<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_proposition_form" model="ir.ui.view">
    <field name="name">ka.proposition.ka.form</field>
    <field name="model">ka.proposition</field>
    <field name="arch" type="xml">
        <form string="Ordre de virement multiple" class="o_ka_form">
            <header>
                <button string="Lancer la routine" name="action_lancer_routine" type="object" class="btn-secondary" invisible="state not in ('brouillon', 'a_approuver')"/>
                <button string="Approuver" name="action_approuver" type="object" class="btn-primary" invisible="state not in ('brouillon', 'a_approuver')"/>
                <button string="Générer fichier virement" name="action_fichier_virement" type="object" class="btn-secondary"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-secondary"/>
                <button string="Générer les règlements" name="action_generer_reglements" type="object" class="btn-secondary" invisible="state != 'approuvee'"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,a_approuver,approuvee,transmise"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_beneficiaires" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_beneficiaires"/></span><span class="o_stat_text">Bénéficiaires</span></div>
                    </button>
                    <button name="action_open_factures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="total_txt"/></span><span class="o_stat_text">Net total</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Ordre de virement multiple <field name="name" readonly="1" class="oe_inline"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Routine : groupe les nets à payer de la période pour les planteurs en mode « virement bancaire » sur un seul ordre de virement multiple.</div>
                <group>
                    <group>
                        <field name="journal_id" string="Banque émettrice" widget="badge" invisible="state in ('brouillon', 'a_approuver')"/>
                        <field name="journal_id" string="Banque émettrice" required="1" invisible="state not in ('brouillon', 'a_approuver')"/>
                        <field name="date_debut" string="Date début période" required="1"/>
                        <field name="date_fin" string="Date fin période" required="1"/>
                        <field name="mode" string="Mode de règlement filtré" widget="badge"/>
                        <field name="libelle" string="Libellé de la routine"/>
                    </group>
                    <group>
                        <field name="compte_emetteur" string="N° compte émetteur"/>
                        <field name="nb_beneficiaires_txt" string="Bénéficiaires" class="fw-bold"/>
                        <field name="exclus" string="Exclus" readonly="1"/>
                        <field name="circuit" string="Validation" readonly="1"/>
                        <field name="format_bancaire" string="Format bancaire"/>
                        <field name="fichier" string="Fichier de virement" filename="fichier_nom" invisible="not fichier"/>
                        <field name="fichier_nom" invisible="1"/>
                    </group>
                </group>
                <div class="o_ka_h3">Lignes du virement multiple (mode « virement bancaire »)</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="partner_id" string="Bénéficiaire"/>
                        <field name="banque" string="Banque / IBAN"/>
                        <field name="move_id" string="Facture" optional="hide"/>
                        <field name="net" string="Net à payer" sum="Total de l'ordre"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Approbation trésorerie → génération d'un fichier de virement de masse unique → transmission banque → comptabilisation et lettrage des factures réglées.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_proposition_tree" model="ir.ui.view">
    <field name="name">ka.proposition.ka.tree</field>
    <field name="model">ka.proposition</field>
    <field name="arch" type="xml"><list string="ka_proposition"><field name="name"/><field name="date_debut"/><field name="date_fin"/><field name="nb_beneficiaires"/><field name="total" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_proposition" model="ir.actions.act_window">
    <field name="name">Paiements</field>
    <field name="res_model">ka.proposition</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
