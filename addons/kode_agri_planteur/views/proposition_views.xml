<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_proposition_form" model="ir.ui.view">
    <field name="name">ka.proposition.ka.form</field>
    <field name="model">ka.proposition</field>
    <field name="arch" type="xml">
        <form string="Proposition de règlement — virement multiple" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Comptabilité</span><span class="o_ka_c">Règlements</span><span class="o_ka_cur">Propositions de règlement</span><span class="o_ka_fn">Fonction : PROPOSITION</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Proposition de règlement — virement multiple</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-success="state in ('approuvee','remise','transmise')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills"/><div class="o_ka_kpis"><div class="o_ka_kpi"><field name="nb_beneficiaires" nolabel="1"/><span class="o_ka_kl">Bénéficiaires</span></div><div class="o_ka_kpi"><field name="total" nolabel="1"/><span class="o_ka_kl">Net total</span></div></div><div class="o_ka_info">Sélection des nets à payer de la période pour la catégorie Planteur &amp; coopérative en mode de règlement « virement bancaire », regroupés sur une seule remise.</div><div class="o_ka_sec">Critères</div><div class="o_ka_grid"><div class="o_ka_f"><label for="journal_id" string="Banque émettrice" class="o_ka_req"/><field name="journal_id"/></div><div class="o_ka_f"><label for="mode" string="Mode de règlement" class="o_ka_req"/><field name="mode"/></div><div class="o_ka_f"><label for="date_debut" string="Date début" class="o_ka_req"/><field name="date_debut"/></div><div class="o_ka_f"><label for="date_fin" string="Date fin" class="o_ka_req"/><field name="date_fin"/></div><div class="o_ka_f"><label for="categorie" string="Catégorie fournisseur"/><field name="categorie"/></div><div class="o_ka_f"><label for="exclus" string="Exclus"/><field name="exclus" readonly="1"/></div><div class="o_ka_f"><label for="format_bancaire" string="Format bancaire"/><field name="format_bancaire"/></div><div class="o_ka_f"><label for="circuit" string="Circuit"/><field name="circuit" readonly="1"/></div></div><div class="o_ka_h3">Lignes de la proposition</div><field name="line_ids" nolabel="1"><tree editable="bottom"><field name="partner_id" string="Bénéficiaire"/><field name="banque" string="Banque / IBAN"/><field name="move_id" string="Facture"/><field name="net" string="Net à payer" sum="Total de la proposition"/></tree></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Approuver" name="action_approuver" type="object" class="o_ka_btn"/><button string="Générer les règlements" name="action_generer_reglements" type="object" class="o_ka_btn o_ka_primary"/><button string="Générer le fichier de virement" name="action_fichier_virement" type="object" class="o_ka_btn"/><button string="Comptabiliser" name="action_comptabiliser" type="object" class="o_ka_btn"/><div class="o_ka_side_t">Liens</div><button string="Remise bancaire" name="action_creer" type="object" class="o_ka_link"/><button string="Lettrage des factures" name="action_creer" type="object" class="o_ka_link"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_proposition_tree" model="ir.ui.view">
    <field name="name">ka.proposition.ka.tree</field>
    <field name="model">ka.proposition</field>
    <field name="arch" type="xml"><tree string="ka_proposition"><field name="name"/><field name="date_debut"/><field name="date_fin"/><field name="nb_beneficiaires"/><field name="total" sum="Total"/><field name="state" widget="badge"/></tree></field>
</record>
<record id="action_ka_proposition" model="ir.actions.act_window">
    <field name="name">Propositions de règlement</field>
    <field name="res_model">ka.proposition</field>
    <field name="view_mode">tree,form</field>
</record>
</odoo>
