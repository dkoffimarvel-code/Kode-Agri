<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_ticket_import_form" model="ir.ui.view">
    <field name="name">ka.ticket.import.ka.form</field>
    <field name="model">ka.ticket.import</field>
    <field name="arch" type="xml">
        <form string="Tickets de pesée — import et validation" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Achats</span><span class="o_ka_c">Fond de tasse</span><span class="o_ka_cur">Tickets de pesée</span><span class="o_ka_fn">Fonction : YTKT · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Tickets de pesée — import et validation</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-info="state in ('controle')" decoration-success="state in ('importe','valide')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills"/><div class="o_ka_kpis"><div class="o_ka_kpi"><field name="nb_tickets" nolabel="1"/><span class="o_ka_kl">Tickets</span></div><div class="o_ka_kpi"><field name="poids_t" nolabel="1"/><span class="o_ka_kl">Poids net humide</span></div></div><div class="o_ka_info">Modèle d'import : CodeFournisseur → fournisseur, Poids N → poids net humide, N_Lot → lot, EUDR → parcelle. La validation génère une commande d'achat par ticket (avances et primes).</div><div class="o_ka_f"><label for="file" string="Fichier du pont-bascule (CSV)"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></div><div class="o_ka_h3">Tickets importés depuis le fichier du pont-bascule (avant validation)</div><field name="ticket_ids" nolabel="1"><list><field name="name" string="N° ticket"/><field name="date_pesee"/><field name="partner_id" string="Fournisseur"/><field name="product_id" string="Article"/><field name="poids_net" string="Poids net (kg)"/><field name="site"/><field name="lot_name" string="Lot"/><field name="state" widget="badge" decoration-info="state=='controle'" decoration-warning="state=='a_controler'" decoration-success="state=='valide'"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Importer le fichier" name="action_importer" type="object" class="o_ka_btn"/><button string="Supprimer et réimporter" name="action_supprimer_reimporter" type="object" class="o_ka_btn"/><button string="Vérifier" name="action_verifier" type="object" class="o_ka_btn"/><button string="Valider et générer les commandes" name="action_valider" type="object" class="o_ka_btn o_ka_primary"/><div class="o_ka_side_t">Liens</div><button string="Modèle d'import YTKT" name="action_creer" type="object" class="o_ka_link"/><button string="Commandes d'achat générées" name="action_open_commandes" type="object" class="o_ka_link"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_ticket_import_tree" model="ir.ui.view">
    <field name="name">ka.ticket.import.ka.tree</field>
    <field name="model">ka.ticket.import</field>
    <field name="arch" type="xml"><list string="ka_ticket_import"><field name="name"/><field name="date"/><field name="source"/><field name="nb_tickets"/><field name="poids_t"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_ticket_import" model="ir.actions.act_window">
    <field name="name">Tickets de pesée</field>
    <field name="res_model">ka.ticket.import</field>
    <field name="view_mode">list,form</field>
</record>
<record id="view_ka_ticket_tree" model="ir.ui.view">
    <field name="name">ka.ticket.ka.tree</field>
    <field name="model">ka.ticket</field>
    <field name="arch" type="xml"><list string="ka_ticket"><field name="name"/><field name="date_pesee"/><field name="partner_id"/><field name="product_id"/><field name="poids_net" sum="Total"/><field name="lot_name"/><field name="state" widget="badge" decoration-info="state=='controle'" decoration-warning="state=='a_controler'"/></list></field>
</record>
<record id="action_ka_ticket" model="ir.actions.act_window">
    <field name="name">Tickets individuels</field>
    <field name="res_model">ka.ticket</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
