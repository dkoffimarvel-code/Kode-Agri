<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_ticket_import_form" model="ir.ui.view">
    <field name="name">ka.ticket.import.ka.form</field>
    <field name="model">ka.ticket.import</field>
    <field name="arch" type="xml">
        <form string="Lot d'import" class="o_ka_form">
            <header>
                <button string="Importer fichier" name="action_importer" type="object" class="btn-primary"/>
                <button string="Supprimer / réimporter" name="action_supprimer_reimporter" type="object" class="btn-secondary"/>
                <button string="Vérifier" name="action_verifier" type="object" class="btn-secondary"/>
                <button string="Valider → générer commandes" name="action_valider" type="object" class="btn-secondary"/>
                <button string="Commandes générées" name="action_open_commandes" type="object" class="btn-secondary" invisible="state != 'valide'"/>
                <button string="Modèle d'import" name="action_modele_import" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="importe,controle,valide"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_tickets" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_tickets"/></span><span class="o_stat_text">Tickets</span></div>
                    </button>
                    <button name="action_open_tickets" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="poids_txt"/></span><span class="o_stat_text">Poids net</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="ka_titre" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Mapping du modèle de pesée : CodeFournisseur → planteur, Poids N → net humide, N_Lot → lot, EUDR → parcelle. La validation génère les commandes (avances + primes). 1 ticket = 1 commande.</div>
                <group invisible="state == 'valide'">
                    <group>
                        <field name="file" string="Fichier pont-bascule (CSV)" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="source" string="Pont-bascule"/>
                    </group>
                </group>
                <div class="o_ka_h3">Tickets importés depuis le fichier de pont-bascule (avant validation)</div>
                <field name="ticket_ids" nolabel="1">
                    <list>
                        <field name="name" string="N_Ticket"/>
                        <field name="date_pesee" string="DateP2"/>
                        <field name="partner_id" string="Fournisseur"/>
                        <field name="product_id" string="Produit"/>
                        <field name="poids_net" string="Poids N"/>
                        <field name="site" string="Site"/>
                        <field name="lot_name" string="Lot" optional="hide"/>
                        <field name="state" string="Statut"/>
                    </list>
                </field>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_ticket_import_tree" model="ir.ui.view">
    <field name="name">ka.ticket.import.ka.tree</field>
    <field name="model">ka.ticket.import</field>
    <field name="arch" type="xml"><list string="ka_ticket_import"><field name="name"/><field name="date"/><field name="source"/><field name="nb_tickets"/><field name="poids_t"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_ticket_import" model="ir.actions.act_window">
    <field name="name">Tickets de pesée</field>
    <field name="res_model">ka.ticket.import</field>
    <field name="view_mode">list,form</field>
</record>
<record id="view_ka_ticket_tree" model="ir.ui.view">
    <field name="name">ka.ticket.ka.tree</field>
    <field name="model">ka.ticket</field>
    <field name="arch" type="xml"><list string="ka_ticket"><field name="name"/><field name="date_pesee"/><field name="partner_id"/><field name="product_id"/><field name="poids_net" sum="Total"/><field name="lot_name"/><field name="state" widget="badge" decoration-info="state=='controle'" decoration-warning="state=='a_controler'"/></list></field>
</record>
<record id="action_ka_ticket" model="ir.actions.act_window">
    <field name="name">Tickets individuels</field>
    <field name="res_model">ka.ticket</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
