<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_avance_form" model="ir.ui.view">
    <field name="name">ka.avance.ka.form</field>
    <field name="model">ka.avance</field>
    <field name="arch" type="xml">
        <form string="Avance" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Soumettre" name="action_soumettre" type="object" class="btn-secondary" invisible="state not in ('brouillon', 'soumise')"/>
                <button string="Approuver" name="action_approuver" type="object" class="btn-primary" invisible="state not in ('brouillon', 'soumise')"/>
                <button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="state not in ('brouillon', 'soumise')"/>
                <button string="Verser" name="action_verser" type="object" class="btn-secondary" invisible="state != 'approuvee'"/>
                <button string="Compte courant planteur" name="action_open_compte" type="object" class="btn-secondary" invisible="not partner_id"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,soumise,approuvee,recuperee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Avance <field name="name" readonly="1" class="oe_inline"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info"><field name="info" readonly="1"/></div>
                <group>
                    <group>
                        <field name="partner_id" string="Planteur" required="1"/>
                        <field name="nature" string="Nature" required="1"/>
                        <field name="amount" string="Montant" required="1" class="fw-bold"/>
                    </group>
                    <group>
                        <field name="regle_id" string="Règle récupération" required="1"/>
                        <field name="plafond" string="Plafond / période"/>
                        <field name="date_octroi" string="Date d'octroi"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span><field name="validation_txt" readonly="1"/></div>
                <notebook>
                    <page string="Circuit de signature" name="circuit">
                        <group>
                            <group>
                                <field name="warehouse_id" string="Site"/>
                            </group>
                            <group>
                                <field name="collectif" string="Collectif" readonly="1"/>
                            </group>
                        </group>
                        <field name="signature_ids" nolabel="1">
                            <list><field name="etape"/><field name="signataire"/><field name="statut" widget="badge" decoration-success="statut=='fait'" decoration-warning="statut=='attente'"/><field name="date"/></list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_avance_tree" model="ir.ui.view">
    <field name="name">ka.avance.ka.tree</field>
    <field name="model">ka.avance</field>
    <field name="arch" type="xml"><list string="ka_avance"><field name="name"/><field name="partner_id"/><field name="nature"/><field name="amount" sum="Total"/><field name="date_octroi"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_avance" model="ir.actions.act_window">
    <field name="name">Avances</field>
    <field name="res_model">ka.avance</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>
