<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_generation_form" model="ir.ui.view">
    <field name="name">ka.generation.ka.form</field>
    <field name="model">ka.generation</field>
    <field name="arch" type="xml">
        <form string="Tâche de génération" class="o_ka_form">
            <header>
                <button string="Sélectionner plage" name="action_selectionner_plage" type="object" class="btn-secondary" invisible="state in ('termine', 'annule')"/>
                <button string="Exécuter la tâche" name="action_lancer" type="object" class="btn-primary" invisible="state in ('termine', 'annule')"/>
                <button string="Annuler" name="action_annuler" type="object" class="btn-secondary" invisible="state in ('termine', 'annule')"/>
                <button string="Planifier (serveur batch)" name="action_planifier" type="object" class="btn-secondary" invisible="state != 'pret'"/>
                <button string="Consulter la trace" name="action_trace" type="object" class="btn-secondary" invisible="not trace"/>
                <field name="state" widget="statusbar" statusbar_visible="pret,simule,termine"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Génération réceptions + factures</h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Plage de dates → groupage de commandes sur une réception et une facture. Interdit : facturer un ticket d'un mois antérieur sur un mois ultérieur (RG-1.7).</div>
                <div class="o_ka_alert" invisible="nb_hors_periode == 0"><field name="nb_hors_periode" readonly="1" class="oe_inline"/> ticket(s) hors du mois de la date de comptabilisation : exécution bloquée (RG-1.7).</div>
                <group>
                    <group>
                        <field name="date_debut" string="Date début pesée" required="1"/>
                        <field name="date_fin" string="Date fin pesée" required="1"/>
                        <field name="date_comptable" string="Date comptabilisation" required="1"/>
                        <field name="nb_commandes" string="Commandes éligibles" class="fw-bold"/>
                        <field name="warehouse_id" string="Site"/>
                    </group>
                    <group>
                        <field name="groupage" string="Groupage" widget="badge"/>
                        <field name="avances_sel" string="Avances à imputer"/>
                        <field name="primes_sel" string="Primes (bonus)"/>
                        <field name="prix_applique" string="Prix appliqué"/>
                        <field name="categorie" string="Catégorie fournisseur"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>À l'exécution : réceptions et factures groupées par plage, imputation des avances, ventilation des primes sur le coût de revient FDT, facturation au prix Apromac du mois.</div>
                <div class="o_ka_note" invisible="not trace"><field name="trace" readonly="1"/></div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_generation_tree" model="ir.ui.view">
    <field name="name">ka.generation.ka.tree</field>
    <field name="model">ka.generation</field>
    <field name="arch" type="xml"><list string="ka_generation"><field name="name"/><field name="date_debut"/><field name="date_fin"/><field name="date_comptable"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_generation" model="ir.actions.act_window">
    <field name="name">Décomptes</field>
    <field name="res_model">ka.generation</field>
    <field name="view_mode">list,form</field>
</record>
<record id="action_ka_decompte_factures" model="ir.actions.act_window">
    <field name="name">Décomptes planteurs</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('move_type', '=', 'in_invoice'), ('partner_id.ka_categorie', '=', 'planteur_coop')]</field>
    <field name="context">{'default_move_type': 'in_invoice'}</field>
</record>
</odoo>
