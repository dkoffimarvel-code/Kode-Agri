<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_flo_vehicule_form" model="ir.ui.view">
    <field name="name">ka.flo.vehicule.ka.form</field>
    <field name="model">ka.flo.vehicule</field>
    <field name="arch" type="xml">
        <form string="Fiche véhicule" class="o_ka_form">
            <header><button string="Nouveau" name="action_creer" type="object" class="btn-primary"/><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Ordre d'entretien" name="action_ordre_entretien" type="object" class="btn-secondary"/><button string="Relevé de compteur" name="action_releve" type="object" class="btn-secondary"/><button string="Immobiliser" name="action_immobiliser" type="object" class="btn-secondary" invisible="state != 'disponible'"/><button string="Remettre à disposition" name="action_disponible" type="object" class="btn-secondary" invisible="state != 'immobilise'"/><field name="state" widget="statusbar" statusbar_visible="disponible,en_mission,en_entretien,immobilise"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_releve" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="compteur_txt"/></span><span class="o_stat_text">Compteur</span></div></button><button name="action_open_pleins" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="conso_txt"/></span><span class="o_stat_text">Conso moy.</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info">Véhicule relié à son immobilisation (module 3). Entretien déclenché au kilométrage (RG-11.1). Documents réglementaires avec alertes d'expiration.</div><div class="o_ka_alert" invisible="not documents_echus">Document obligatoire échu : le véhicule est bloqué à l'affectation (§ 11.4).</div><group><group><field name="name" string="Immatriculation"/><field name="type" string="Type"/><field name="categorie" string="Catégorie d'usage" widget="badge" invisible="not id"/><field name="categorie" string="Catégorie d'usage" invisible="id"/><field name="marque_modele" string="Marque / modèle" invisible="not marque_modele"/><field name="capacite_txt" string="Charge utile" invisible="not capacite_txt"/><field name="documents_echus" invisible="1"/></group><group><field name="odometre" string="Compteur (km)" readonly="1"/><field name="conducteur_id" string="Conducteur affecté"/><field name="immo_id" string="Immobilisation"/><field name="state" string="Statut" widget="badge" decoration-success="state == 'disponible'" decoration-info="state == 'en_mission'" decoration-warning="state == 'en_entretien'" decoration-danger="state == 'immobilise'"/></group></group><notebook><page string="Documents réglementaires" name="documents"><div class="o_ka_h3">Documents réglementaires et échéances</div><field name="document_ids" nolabel="1"><list editable="bottom"><field name="type" string="Document"/><field name="reference" string="Référence"/><field name="date_debut" string="Début" optional="hide"/><field name="echeance" string="Échéance"/><field name="montant" string="Coût" optional="hide"/><field name="obligatoire" optional="hide"/><field name="statut" string="Statut" decoration-success="statut == 'valide'" decoration-warning="statut == 'proche'" decoration-danger="statut == 'echu'"/></list></field></page><page string="Entretien" name="entretien"><div class="o_ka_h3">Plans d'entretien au compteur (RG-11.1)</div><field name="plan_ids" nolabel="1"><list editable="bottom"><field name="intitule" string="Plan"/><field name="type"/><field name="periodicite" string="Périodicité"/><field name="derniere" string="Dernière exécution"/><field name="prochaine" string="Prochain seuil"/><field name="anticipation" optional="hide"/><field name="state" optional="hide"/></list></field><div class="o_ka_h3">Historique d'entretien</div><field name="entretien_ids" nolabel="1" readonly="1"><list><field name="name"/><field name="date_prevue"/><field name="type"/><field name="objet"/><field name="realisation"/><field name="cout_total" sum="Total"/><field name="state" widget="badge"/></list></field></page><page string="Carburant" name="carburant"><field name="plein_ids" nolabel="1" readonly="1"><list><field name="date" string="Date"/><field name="quantite" string="Quantité (L)"/><field name="km" string="Km"/><field name="conso_liste" string="Conso (L/100)"/><field name="support_txt" string="Bon / carte"/><field name="cout" string="Coût" sum="Total"/><field name="derive" column_invisible="1"/></list></field></page><page string="Caractéristiques" name="caracteristiques"><group><group><field name="libelle" string="Libellé"/><field name="marque" string="Marque"/><field name="modele" string="Modèle"/><field name="annee" string="Année"/><field name="unite_compteur" string="Compteur"/></group><group><field name="charge_utile" string="Charge utile (t)"/><field name="capacite_levage" string="Capacité de levage (t)"/><field name="analytic_id" string="Centre de coût"/><field name="zone_id" string="Zone de collecte"/><field name="equipe_id" string="Atelier interne"/></group></group></page><page string="Affectations" name="affectations"><field name="affectation_ids" nolabel="1" readonly="1"><list><field name="date"/><field name="name"/><field name="conducteur_id"/><field name="type_mission"/><field name="distance"/><field name="state" widget="badge"/></list></field><div class="o_ka_h3">Incidents</div><field name="incident_ids" nolabel="1" readonly="1"><list><field name="date"/><field name="type"/><field name="conducteur_id"/><field name="description"/><field name="cout_estime"/></list></field></page><page string="Coût de revient" name="cout"><field name="cout_html" nolabel="1" readonly="1"/></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_flo_vehicule_list" model="ir.ui.view">
    <field name="name">ka.flo.vehicule.ka.list</field>
    <field name="model">ka.flo.vehicule</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="libelle"/><field name="type"/><field name="categorie"/><field name="marque_modele"/><field name="odometre" string="Compteur"/><field name="conducteur_id"/><field name="conso_moyenne" optional="show"/><field name="documents_echus" string="Document échu" optional="show"/><field name="state" widget="badge" decoration-success="state == 'disponible'" decoration-info="state == 'en_mission'" decoration-warning="state == 'en_entretien'" decoration-danger="state == 'immobilise'"/></list></field>
</record>
<record id="view_ka_flo_cout_list" model="ir.ui.view">
    <field name="name">ka.flo.vehicule.ka.list</field>
    <field name="model">ka.flo.vehicule</field>
    <field name="arch" type="xml"><list create="0"><field name="name"/><field name="libelle"/><field name="categorie"/><field name="cout_carburant"/><field name="cout_entretien"/><field name="cout_pneus"/><field name="cout_amortissement"/><field name="cout_assurance"/><field name="cout_total"/><field name="distance"/><field name="cout_unitaire"/></list></field>
</record>
<record id="view_ka_flo_vehicule_search" model="ir.ui.view">
    <field name="name">ka.flo.vehicule.ka.search</field>
    <field name="model">ka.flo.vehicule</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="libelle"/><field name="conducteur_id"/><filter name="disponibles" string="Disponibles" domain="[('state', '=', 'disponible')]"/><filter name="echus" string="Document échu" domain="[('documents_echus', '=', True)]"/><filter name="g_usage" string="Catégorie d'usage" context="{'group_by': 'categorie'}"/><filter name="g_type" string="Type" context="{'group_by': 'type'}"/></search></field>
</record>
<record id="view_ka_flo_document_list" model="ir.ui.view">
    <field name="name">ka.flo.document.ka.list</field>
    <field name="model">ka.flo.document</field>
    <field name="arch" type="xml"><list editable="bottom"><field name="vehicule_id"/><field name="type"/><field name="reference"/><field name="date_debut"/><field name="echeance"/><field name="montant" sum="Total"/><field name="obligatoire"/><field name="statut" widget="badge" decoration-success="statut == 'valide'" decoration-warning="statut == 'proche'" decoration-danger="statut == 'echu'"/></list></field>
</record>
<record id="view_ka_flo_document_search" model="ir.ui.view">
    <field name="name">ka.flo.document.ka.search</field>
    <field name="model">ka.flo.document</field>
    <field name="arch" type="xml"><search><field name="vehicule_id"/><field name="reference"/><filter name="a_echeance" string="Échéance sous 30 jours" domain="[('echeance', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/><filter name="g_type" string="Document" context="{'group_by': 'type'}"/></search></field>
</record>
<record id="view_ka_flo_releve_form" model="ir.ui.view">
    <field name="name">ka.flo.releve.ka.form</field>
    <field name="model">ka.flo.releve</field>
    <field name="arch" type="xml">
        <form string="Relevé de compteur" class="o_ka_form">
            
            <sheet>
                <group><group><field name="vehicule_id" string="Véhicule"/><field name="valeur" string="Compteur relevé"/><field name="date" string="Date"/></group><group></group></group>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_flo_releve_list" model="ir.ui.view">
    <field name="name">ka.flo.releve.ka.list</field>
    <field name="model">ka.flo.releve</field>
    <field name="arch" type="xml"><list><field name="date"/><field name="vehicule_id"/><field name="valeur"/><field name="origine"/></list></field>
</record>
<record id="action_ka_flo_vehicule" model="ir.actions.act_window"><field name="name">Véhicules</field><field name="res_model">ka.flo.vehicule</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_flo_vehicule_search"/></record><record id="action_ka_flo_vehicule_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_vehicule"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_vehicule_list"/></record><record id="action_ka_flo_vehicule_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_vehicule"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_flo_vehicule_form"/></record>
<record id="action_ka_flo_cout" model="ir.actions.act_window"><field name="name">Coût de revient kilométrique</field><field name="res_model">ka.flo.vehicule</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_flo_vehicule_search"/></record><record id="action_ka_flo_cout_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_cout"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_cout_list"/></record><record id="action_ka_flo_cout_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_cout"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_flo_vehicule_form"/></record>
<record id="action_ka_flo_document" model="ir.actions.act_window"><field name="name">Documents</field><field name="res_model">ka.flo.document</field><field name="view_mode">list</field><field name="search_view_id" ref="view_ka_flo_document_search"/></record><record id="action_ka_flo_document_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_document"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_document_list"/></record>
<record id="action_ka_flo_echeancier" model="ir.actions.act_window"><field name="name">Échéancier des documents réglementaires</field><field name="res_model">ka.flo.document</field><field name="view_mode">list</field><field name="context">{'search_default_a_echeance': 1}</field><field name="search_view_id" ref="view_ka_flo_document_search"/></record><record id="action_ka_flo_echeancier_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_echeancier"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_document_list"/></record>
<record id="action_ka_flo_releve" model="ir.actions.act_window"><field name="name">Relevés de compteur</field><field name="res_model">ka.flo.releve</field><field name="view_mode">list,form</field></record>
</odoo>
