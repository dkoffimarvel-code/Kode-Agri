<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_flo_entretien_form" model="ir.ui.view">
    <field name="name">ka.flo.entretien.ka.form</field>
    <field name="model">ka.flo.entretien</field>
    <field name="arch" type="xml">
        <form string="Ordre d'entretien" class="o_ka_form">
            <header><button string="Planifier" name="action_planifier" type="object" class="btn-secondary" invisible="state != 'prevu'"/><button string="Démarrer" name="action_demarrer" type="object" class="btn-secondary" invisible="state not in ('prevu', 'planifie')"/><button string="Clôturer" name="action_cloturer" type="object" class="btn-primary" invisible="state not in ('planifie', 'en_cours')"/><button string="Annuler" name="action_annuler" type="object" class="btn-secondary" invisible="state in ('cloture', 'annule')"/><field name="state" widget="statusbar" statusbar_visible="prevu,en_cours,cloture"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_vehicule" type="object" class="oe_stat_button" invisible="not seuil"><div class="o_stat_info"><span class="o_stat_value"><field name="seuil_txt"/></span><span class="o_stat_text">Seuil</span></div></button><button name="action_open_vehicule" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="type"/></span><span class="o_stat_text">Type</span></div></button><button name="action_open_commande" type="object" class="oe_stat_button" invisible="not commande_id"><div class="o_stat_info"><span class="o_stat_value"><field name="commande_id"/></span><span class="o_stat_text">Commande</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info">Plan d'entretien déclenché au kilométrage (RG-11.1). Pièces issues du magasin (module 2) ; réalisable en interne (module 10) ou en garage externe.</div><group><group><field name="vehicule_id" string="Véhicule"/><field name="objet" string="Objet"/><field name="type" string="Type" widget="badge" decoration-warning="True" invisible="state == 'prevu'"/><field name="type" string="Type" invisible="state != 'prevu'"/><field name="declencheur_txt" string="Déclencheur" widget="badge" invisible="not seuil"/><field name="declencheur" string="Déclencheur" invisible="seuil"/><field name="realisation" string="Réalisation"/><field name="seuil" invisible="1"/></group><group><field name="km_declenchement" string="Km au déclenchement"/><field name="date_prevue" string="Date prévue"/><field name="garage_txt" string="Garage / atelier"/><field name="equipe_id" string="Atelier interne" invisible="realisation != 'interne'"/><field name="prestataire_id" string="Garage externe" invisible="realisation != 'garage'"/><field name="duree_estimee" string="Durée estimée" class="o_ka_u_h"/><field name="km_cloture" string="Compteur à la clôture" invisible="state not in ('en_cours', 'cloture')"/></group></group><div class="o_ka_h3">Opérations et pièces</div><field name="ligne_ids" nolabel="1"><list editable="bottom"><field name="operation" string="Opération"/><field name="product_id" string="Pièce / consommable"/><field name="quantite" string="Quantité"/><field name="prix_unitaire" string="Prix unitaire" optional="hide"/><field name="cout" string="Coût"/></list></field><div class="o_ka_totalbar"><span>Coût de l'entretien</span><field name="cout_txt" nolabel="1" readonly="1"/></div><div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Clôture : mise à jour du compteur et de l'historique du véhicule ; coût imputé au coût de revient kilométrique (module 9).</div><notebook><page string="Prestation externe" name="externe"><group><group><field name="externe" string="Intervention externe"/><field name="prestataire_id" string="Prestataire / garage"/><field name="commande_cadre" string="Prestataire sous contrat-cadre"/></group><group><field name="da_id" string="Demande d'achat"/><field name="ao_id" string="Appel d'offre"/><field name="commande_id" string="Commande"/><field name="commande_state" string="Statut de la commande"/><field name="facture_txt" string="Facturation"/></group></group><div class="o_ka_info">C'est toujours l'OT qui part en premier : fournisseur ponctuel → demande d'achat déjà validée → appel d'offre → commande (RG-11.2) ; prestataire sous contrat-cadre → la commande existante. La clôture exige la commande approuvée et déclenche la réception automatique ; la facture est rapprochée de la commande et de la réception (RG-11.3).</div></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_flo_entretien_list" model="ir.ui.view">
    <field name="name">ka.flo.entretien.ka.list</field>
    <field name="model">ka.flo.entretien</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="date_prevue"/><field name="vehicule_id"/><field name="type"/><field name="objet"/><field name="realisation"/><field name="prestataire_id" optional="show"/><field name="commande_id" optional="hide"/><field name="cout_total" sum="Total"/><field name="state" widget="badge" decoration-success="state == 'cloture'" decoration-info="state in ('planifie', 'en_cours')"/></list></field>
</record>
<record id="view_ka_flo_entretien_search" model="ir.ui.view">
    <field name="name">ka.flo.entretien.ka.search</field>
    <field name="model">ka.flo.entretien</field>
    <field name="arch" type="xml"><search><field name="vehicule_id"/><field name="name"/><field name="prestataire_id"/><filter name="ouverts" string="Ouverts" domain="[('state', 'not in', ('cloture', 'annule'))]"/><filter name="externes" string="Externes" domain="[('externe', '=', True)]"/><filter name="a_facturer" string="Clôturés en attente de facture" domain="[('state', '=', 'cloture'), ('externe', '=', True), ('commande_state', '=', 'recue')]"/><filter name="g_veh" string="Véhicule" context="{'group_by': 'vehicule_id'}"/></search></field>
</record>
<record id="view_ka_flo_plan_list" model="ir.ui.view">
    <field name="name">ka.flo.plan.ka.list</field>
    <field name="model">ka.flo.plan</field>
    <field name="arch" type="xml"><list editable="bottom"><field name="vehicule_id"/><field name="intitule"/><field name="type"/><field name="periodicite"/><field name="derniere"/><field name="prochaine"/><field name="anticipation"/><field name="state"/></list></field>
</record>
<record id="action_ka_flo_entretien" model="ir.actions.act_window"><field name="name">Entretien</field><field name="res_model">ka.flo.entretien</field><field name="view_mode">list,form</field><field name="context">{'search_default_ouverts': 1}</field><field name="search_view_id" ref="view_ka_flo_entretien_search"/></record><record id="action_ka_flo_entretien_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_entretien"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_entretien_list"/></record><record id="action_ka_flo_entretien_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_entretien"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_flo_entretien_form"/></record>
<record id="action_ka_flo_a_facturer" model="ir.actions.act_window"><field name="name">OT clôturés en attente de facturation</field><field name="res_model">ka.flo.entretien</field><field name="view_mode">list,form</field><field name="context">{'search_default_a_facturer': 1}</field><field name="search_view_id" ref="view_ka_flo_entretien_search"/></record><record id="action_ka_flo_a_facturer_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_a_facturer"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_entretien_list"/></record><record id="action_ka_flo_a_facturer_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_a_facturer"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_flo_entretien_form"/></record>
<record id="action_ka_flo_externes" model="ir.actions.act_window"><field name="name">OT externalisés : demandes, appels d'offre, commandes</field><field name="res_model">ka.flo.entretien</field><field name="view_mode">list,form</field><field name="domain">[('externe', '=', True)]</field><field name="search_view_id" ref="view_ka_flo_entretien_search"/></record><record id="action_ka_flo_externes_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_externes"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_entretien_list"/></record><record id="action_ka_flo_externes_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_externes"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_flo_entretien_form"/></record>
<record id="action_ka_flo_plan" model="ir.actions.act_window"><field name="name">Plans d'entretien</field><field name="res_model">ka.flo.plan</field><field name="view_mode">list</field></record><record id="action_ka_flo_plan_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_flo_plan"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_flo_plan_list"/></record>
</odoo>
