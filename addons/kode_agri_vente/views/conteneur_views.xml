<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.4 — Empotage conteneur — affectation des palettes conformes [Saisie] -->
<record id="view_ka_conteneur_form" model="ir.ui.view">
    <field name="name">ka.conteneur.ka.form</field>
    <field name="model">ka.conteneur</field>
    <field name="arch" type="xml">
        <form string="Conteneur" class="o_ka_form">
            <header>
                <button string="Affecter palettes" name="action_allouer" type="object" class="btn-secondary"/>
                <button string="Plomber" name="action_plomber" type="object" class="btn-primary"/>
                <button string="Empoter" name="action_empoter" type="object" class="btn-secondary"/>
                <button string="Imprimer documents" name="action_documents" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="affecte,charge,plombe,empote"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_colis" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="colis_txt"/></span><span class="o_stat_text"><field name="colis_label"/></span></div>
                    </button>
                    <button name="action_open_colis" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="spec_kpi"/></span><span class="o_stat_text">Spécifications</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Conteneur <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Équivalent conteneur · spécifications héritées du sous-contrat</div>
                </div>
                <div class="o_ka_info">Seules les palettes conformes aux spécifications du contrat sont proposées. Capacité : 16 colis (palette) / 17 colis (vrac), paramétrable.</div>
                <group>
                    <group>
                        <field name="sous_contrat_id" string="Sous-contrat" required="1"/>
                        <field name="serie" string="N° série conteneur" required="1"/>
                        <field name="plomb" string="N° de plomb" class="fw-bold" required="state not in ('affecte', 'charge')"/>
                    </group>
                    <group>
                        <field name="mode_chargement" string="Mode chargement" widget="badge"/>
                        <field name="tare" string="Tare conteneur" class="o_ka_u_kg"/>
                        <field name="spec_txt" string="Spécifications"/>
                    </group>
                </group>
                <notebook>
                    <page string="Spécifications" name="specs">
                        <div class="o_ka_h3">Spécifications de l'équivalent conteneur (héritées du sous-contrat)</div>
                        <field name="spec_html" nolabel="1"/>
                        <div class="o_ka_h3">Palettes affectées (conformes aux spécifications du contrat)</div>
                        <field name="palettes_html" nolabel="1"/>
                    </page>
                    <page string="Palettes" name="palettes">
                        <field name="colis_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="palette" string="Palette"/>
                                <field name="lot_id" string="Colis (série)"/>
                                <field name="product_id" string="Article"/>
                                <field name="statut" string="Statut"/>
                                <field name="p0_pri" string="P0 / PRI"/>
                                <field name="conformite" string="Conformité" widget="badge" decoration-success="conformite == 'conforme'" decoration-danger="conformite == 'non_conforme'"/>
                            </list>
                        </field>
                    </page>
                    <page string="Documents" name="documents">
                        <div class="o_ka_info o_ka_noicon">Documents par conteneur (« Imprimer documents ») : bordereau d'expédition, certificat d'analyse par palette et certificat de traitement thermique.</div>
                        <group>
                            <group>
                                <field name="voyage_id" string="Ordre de voyage"/>
                                <field name="armateur" string="Armateur"/>
                                <field name="lot_conteneur_id" string="Article conteneur (série)"/>
                            </group>
                            <group>
                                <field name="date_entree_parc" string="Entrée parc externe"/>
                                <field name="date_entree_port" string="Entrée au port"/>
                                <field name="statut_transitaire" string="Statut transitaire"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_conteneur_tree" model="ir.ui.view">
    <field name="name">ka.conteneur.ka.tree</field>
    <field name="model">ka.conteneur</field>
    <field name="arch" type="xml"><list string="ka_conteneur"><field name="name"/><field name="serie"/><field name="sous_contrat_id"/><field name="plomb"/><field name="colis_txt"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_conteneur" model="ir.actions.act_window"><field name="name">Empotement</field><field name="res_model">ka.conteneur</field><field name="view_mode">list,form</field><field name="context">{'ka_nom_long_ctn': True}</field></record>
<!-- Barre « Ventes › Conteneurs » : liste de tous les équivalents conteneurs -->
<record id="action_ka_conteneur_liste" model="ir.actions.act_window"><field name="name">Conteneurs</field><field name="res_model">ka.conteneur</field><field name="view_mode">list,form</field></record>
</odoo>
