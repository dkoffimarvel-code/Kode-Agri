<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.2 — Contrat de vente — en-tête et conversion des quantités [Approbation] -->
<record id="view_ka_contrat_clt_form" model="ir.ui.view">
    <field name="name">ka.contrat.clt.ka.form</field>
    <field name="model">ka.contrat</field>
    <field name="priority">10</field>
    <field name="arch" type="xml">
        <form string="Contrat de vente" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Envoyer" name="action_soumettre" type="object" class="btn-primary"/>
                <button string="Confirmer" name="action_signer" type="object" class="btn-secondary"/>
                <button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="state != 'a_signer'"/>
                <button string="Créer un sous-contrat" name="action_creer_sous_contrat" type="object" class="btn-secondary" invisible="state != 'signee'"/>
                <button string="Imprimer le contrat" name="action_imprimer" type="object" class="btn-secondary"/>
                <button string="Factures" name="action_open_factures" type="object" class="btn-secondary" invisible="state not in ('signee', 'soldee')"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,a_signer,signee,soldee"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_sous_contrats" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="type" readonly="1"/></span><span class="o_stat_text">Type contrat</span></div>
                    </button>
                    <button name="action_open_livraisons" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="tracabilite" readonly="1"/></span><span class="o_stat_text">Traçabilité</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ctn_kpi"/></span><span class="o_stat_text">Conteneurs</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="balles_kpi"/></span><span class="o_stat_text">Balles</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="partner_id" readonly="1" options="{'no_open': True}"/> · Créé par <field name="modifie_par" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Quantité kg convertie en conteneurs et en balles (RG-5.4). Spécifications mises à jour depuis la fiche client à l'affectation du client final. Le passage de « Devis envoyé » à « Bon de commande » est réservé à la DG.</div>
                <group>
                    <group>
                        <field name="partner_id" string="Client" required="1"/>
                        <field name="type" string="Type de contrat" widget="badge" required="1"/>
                        <field name="product_id" string="Article" widget="badge" decoration-success="1" required="1" options="{'no_create': True}"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" decoration-success="tracabilite == 'eudr'" decoration-warning="tracabilite == 'non_eudr'" required="1"/>
                        <field name="qty_kg" string="Quantité (kg)" class="o_ka_u_kg" required="1"/>
                        <field name="conteneurs_txt" string="→ Conteneurs"/>
                        <field name="balles_txt" string="→ Balles"/>
                        <field name="restant_kg_txt" string="Restant à affecter (kg)"/>
                        <field name="restant_ctn_txt" string="Restant à affecter (conteneurs)"/>
                    </group>
                    <group>
                        <field name="prix_t" string="Prix de vente" class="o_ka_u_eurt" required="1"/>
                        <field name="montant" string="Montant en devise"/>
                        <field name="contre_valeur" string="Montant en FCFA"/>
                        <field name="periode" string="Livraison souhaitée" placeholder="Mois de livraison" class="o_ka_u_mois" required="1"/>
                        <field name="incoterm" string="Incoterm" required="1"/>
                        <field name="ref_client" string="Réf. contrat client" required="1"/>
                        <field name="paiement" string="Paiement"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_currency_id" invisible="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Spécifications (7 tests)" name="specs">
                        <div class="o_ka_h3"><field name="spec_titre"/></div>
                        <field name="spec_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="test" string="Test"/>
                                <field name="libelle" string="Libellé"/>
                                <field name="standard" string="Standard"/>
                                <field name="applique" string="Appliqué (contrat)"/>
                                <field name="source" string="Source"/>
                            </list>
                        </field>
                    </page>
                    <page string="Général" name="general">
                        <group>
                            <group>
                                <field name="emballage" string="Type d'emballage"/>
                                <field name="conditions" string="Conditions contrat"/>
                                <field name="currency_id" string="Devise"/>
                            </group>
                            <group>
                                <field name="port" string="Port d'embarquement"/>
                                <field name="warehouse_id" string="Usine"/>
                                <field name="sale_order_id" string="Commande client"/>
                            </group>
                        </group>
                    </page>
                    <page string="Sous-contrats" name="sous_contrats">
                        <field name="sous_contrat_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name" string="Sous-contrat"/>
                                <field name="poids_kg" string="Poids (kg)" sum="Total"/>
                                <field name="armateur" string="Armateur"/>
                                <field name="booking" string="N° booking"/>
                                <field name="date_embarquement_prevue" string="Embarquement prévu"/>
                                <field name="state" string="Statut" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 5.2b — Spécifications d'un contrat Spot — modifiables par la logistique [Saisie] -->
<record id="view_ka_contrat_spot_form" model="ir.ui.view">
    <field name="name">ka.contrat.spot.ka.form</field>
    <field name="model">ka.contrat</field>
    <field name="arch" type="xml">
        <form string="Contrat de vente Spot" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Modifier spécifications" name="action_modifier_specs" type="object" class="btn-primary"/>
                <button string="Envoyer" name="action_soumettre" type="object" class="btn-secondary"/>
                <button string="Confirmer" name="action_signer" type="object" class="btn-secondary"/>
                <button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="state != 'a_signer'"/>
                <button string="Créer un sous-contrat" name="action_creer_sous_contrat" type="object" class="btn-secondary" invisible="state != 'signee'"/>
                <button string="Imprimer le contrat" name="action_imprimer" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,a_signer,signee,soldee"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_sous_contrats" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="type" readonly="1"/></span><span class="o_stat_text">Type contrat</span></div>
                    </button>
                    <button name="action_open_livraisons" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="tracabilite" readonly="1"/></span><span class="o_stat_text">Traçabilité</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ctn_kpi"/></span><span class="o_stat_text">Conteneurs</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="balles_kpi"/></span><span class="o_stat_text">Balles</span></div>
                    </button>
                    <button name="action_modifier_specs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="spec_mode"/></span><span class="o_stat_text">Spécifications</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="partner_id" readonly="1" options="{'no_open': True}"/> · Vente spot — créé par <field name="modifie_par" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Contrat Spot : les spécifications sont modifiables par le département logistique (champs éditables). Les valeurs du contrat priment sur la fiche client. Le passage de « Devis envoyé » à « Bon de commande » est réservé à la DG.</div>
                <field name="spec_edition" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id" string="Client" required="1"/>
                        <field name="type" string="Type de contrat" widget="badge" required="1"/>
                        <field name="product_id" string="Grade" widget="badge" decoration-success="1" required="1" options="{'no_create': True}"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" decoration-success="tracabilite == 'eudr'" decoration-warning="tracabilite == 'non_eudr'" required="1"/>
                        <field name="qty_kg" string="Quantité (kg)" class="o_ka_u_kg" required="1"/>
                        <field name="conteneurs_txt" string="→ Conteneurs"/>
                        <field name="balles_txt" string="→ Balles"/>
                        <field name="restant_kg_txt" string="Restant à affecter (kg)"/>
                        <field name="restant_ctn_txt" string="Restant à affecter (conteneurs)"/>
                    </group>
                    <group>
                        <field name="prix_t" string="Prix de vente" class="o_ka_u_eurt" required="1"/>
                        <field name="montant" string="Montant en devise"/>
                        <field name="contre_valeur" string="Montant en FCFA"/>
                        <field name="periode" string="Livraison souhaitée" placeholder="Mois de livraison" class="o_ka_u_mois" required="1"/>
                        <field name="incoterm" string="Incoterm" required="1"/>
                        <field name="spec_source" string="Source spécifications" widget="badge" decoration-warning="1"/>
                        <field name="modifie_par" string="Modifié par"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_currency_id" invisible="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Spécifications (7 tests)" name="specs">
                        <div class="o_ka_h3"><field name="spec_titre"/></div>
                        <field name="spec_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="test" string="Test" readonly="1"/>
                                <field name="libelle" string="Libellé"/>
                                <field name="standard" string="Standard" readonly="1"/>
                                <field name="applique" string="Contrat (éditable)" class="fw-bold" readonly="not parent.spec_edition and parent.state != 'en_cours'"/>
                                <field name="modifie_txt" string="Modifié"/>
                            </list>
                        </field>
                        <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Le département logistique édite les spécifications du contrat Spot directement sur les lignes ; les valeurs saisies s'appliquent au contrôle qualité et à l'expédition, en priorité sur la fiche client.</div>
                    </page>
                    <page string="Général" name="general">
                        <group>
                            <group>
                                <field name="emballage" string="Type d'emballage"/>
                                <field name="conditions" string="Conditions contrat"/>
                                <field name="ref_client" string="Réf. contrat client"/>
                                <field name="paiement" string="Paiement"/>
                            </group>
                            <group>
                                <field name="port" string="Port d'embarquement"/>
                                <field name="warehouse_id" string="Usine"/>
                                <field name="currency_id" string="Devise"/>
                                <field name="sale_order_id" string="Commande client"/>
                            </group>
                        </group>
                    </page>
                    <page string="Sous-contrats" name="sous_contrats">
                        <field name="sous_contrat_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name" string="Sous-contrat"/>
                                <field name="poids_kg" string="Poids (kg)" sum="Total"/>
                                <field name="armateur" string="Armateur"/>
                                <field name="booking" string="N° booking"/>
                                <field name="date_embarquement_prevue" string="Embarquement prévu"/>
                                <field name="state" string="Statut" widget="badge"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_contrat_tree" model="ir.ui.view">
    <field name="name">ka.contrat.ka.tree</field>
    <field name="model">ka.contrat</field>
    <field name="arch" type="xml"><list string="ka_contrat"><field name="name"/><field name="partner_id"/><field name="type"/><field name="product_id"/><field name="qty_kg" sum="Total"/><field name="periode"/><field name="state" widget="badge" decoration-info="state == 'en_cours'" decoration-warning="state == 'a_signer'" decoration-success="state in ('signee', 'soldee')" decoration-danger="state == 'refusee'"/></list></field>
</record>
<record id="action_ka_contrat_clt" model="ir.actions.act_window"><field name="name">Contrats de vente</field><field name="res_model">ka.contrat</field><field name="view_mode">list,form</field><field name="domain">[('type','=','clt')]</field><field name="context">{'default_type': 'clt', 'ka_nom_long_contrat': True}</field></record><record id="action_ka_contrat_clt_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_contrat_clt"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_contrat_tree"/></record><record id="action_ka_contrat_clt_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_contrat_clt"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_contrat_clt_form"/></record>
<record id="action_ka_contrat_spot" model="ir.actions.act_window"><field name="name">Contrats de vente</field><field name="res_model">ka.contrat</field><field name="view_mode">list,form</field><field name="domain">[('type','=','spot')]</field><field name="context">{'default_type': 'spot', 'ka_nom_long_contrat': True}</field></record><record id="action_ka_contrat_spot_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_contrat_spot"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_contrat_tree"/></record><record id="action_ka_contrat_spot_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_contrat_spot"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_contrat_spot_form"/></record>
<!-- États : portefeuille des contrats de vente (Long terme et Spot) -->
<record id="action_ka_contrat_etat" model="ir.actions.act_window"><field name="name">Contrats de vente</field><field name="res_model">ka.contrat</field><field name="view_mode">list,pivot,graph</field><field name="context">{'ka_nom_long_contrat': True}</field></record><record id="action_ka_contrat_etat_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_contrat_etat"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_contrat_tree"/></record>
</odoo>
