<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.4b — Bon d'expédition — sortie usine et transfert de stock [Saisie] -->
<record id="view_ka_livraison_form" model="ir.ui.view">
    <field name="name">ka.livraison.ka.form</field>
    <field name="model">ka.livraison</field>
    <field name="arch" type="xml">
        <form string="Bon d'expédition" class="o_ka_form">
            <header>
                <button string="Enregistrer enlèvement" name="action_enregistrer_enlevement" type="object" class="btn-secondary"/>
                <button string="Valider le BL" name="action_valider" type="object" class="btn-primary"/>
                <button string="Planning camions" name="action_planning" type="object" class="btn-secondary"/>
                <button string="Imprimer le bordereau" name="action_bordereau" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="pret,brouillon,empote,parc"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="float-end"><field name="statut_conteneur_txt" widget="badge" decoration-success="statut_conteneur in ('empote', 'au_port', 'embarque')" decoration-warning="statut_conteneur not in ('empote', 'au_port', 'embarque')"/></div>
                    <h1>Bon d'expédition <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Sortie usine → transfert vers le parc terre-plein de l'ordre de voyage</div>
                </div>
                <field name="statut_conteneur" invisible="1"/>
                <div class="o_ka_info">La validation du BL fait sortir le stock usine et génère une commande de transfert vers le parc terre-plein indiqué sur l'ordre de voyage. Le statut « Empoté » est attribué à l'équivalent conteneur et au numéro de série armateur.</div>
                <group>
                    <group>
                        <field name="conteneur_id" string="Conteneur" required="1"/>
                        <field name="voyage_id" string="N° ordre de voyage"/>
                        <field name="transporteur_id" string="Fournisseur transporteur"/>
                        <field name="immatriculation" string="Immatriculation camion"/>
                    </group>
                    <group>
                        <field name="chauffeur" string="Chauffeur"/>
                        <field name="plomb" string="N° de plomb"/>
                        <field name="destination_id" string="Parc terre-plein destination"/>
                        <field name="date_sortie" string="Date sortie usine" required="1"/>
                        <field name="date_arrivee_parc" string="Date d'arrivée au parc terre-plein" invisible="state not in ('empote', 'parc')"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Validation BL → sortie du stock usine, transfert vers parc terre-plein (commande transfert à réceptionner), alimentation du planning des camions (immatriculation + fournisseur transporteur).</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_livraison_tree" model="ir.ui.view">
    <field name="name">ka.livraison.ka.tree</field>
    <field name="model">ka.livraison</field>
    <field name="arch" type="xml"><list string="ka_livraison"><field name="name"/><field name="conteneur_id"/><field name="sous_contrat_id"/><field name="date_sortie"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_livraison" model="ir.actions.act_window"><field name="name">Expéditions</field><field name="res_model">ka.livraison</field><field name="view_mode">list,form</field><field name="context">{'ka_nom_long_bl': True}</field></record>
</odoo>
