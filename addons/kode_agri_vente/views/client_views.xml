<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.1 — Fiche client — création [Saisie] -->
<record id="view_ka_client_form" model="ir.ui.view">
    <field name="name">res.partner.ka.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <form string="Client" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Annuler" special="cancel" class="btn-secondary"/>
                <button string="Activer le client" name="action_activer_client" type="object" class="btn-secondary" invisible="not id or ka_client_state != 'creation'"/>
                <field name="ka_client_state" widget="statusbar" statusbar_visible="creation,actif"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><span invisible="id">Nouvelle fiche client</span><field name="name" readonly="1" invisible="not id"/></h1>
                    <div class="o_ka_sub">Les informations saisies ici sont reprises par défaut sur les contrats du client (adresses, conditions commerciales, grades et spécifications qualité, documents requis à l'expédition).</div>
                </div>
                <field name="ka_client" invisible="1"/>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="o_ka_h3">1. Identification</div>
                        <div class="o_ka_note">Identité et contact commercial du client.</div>
                        <group>
                            <group>
                                <field name="ka_code_client" string="Code client" readonly="1" placeholder="Auto"/>
                                <field name="country_id" string="Pays" required="1" options="{'no_create': True}"/>
                                <field name="email" string="Email" placeholder="contact@client.com"/>
                            </group>
                            <group>
                                <field name="name" string="Raison sociale" required="1" placeholder="Ex. : Continental Reifen GmbH"/>
                                <field name="ka_contact_commercial" string="Interlocuteur" placeholder="Nom du contact"/>
                                <field name="phone" string="Téléphone" placeholder="+00 0 00 00 00 00"/>
                            </group>
                        </group>

                        <div class="o_ka_h3">2. Adresses (export)</div>
                        <div class="o_ka_note">Adresses de facturation et de livraison distinctes.</div>
                        <group string="Adresse de facturation">
                            <field name="street" string="Rue" placeholder="N°, rue"/>
                            <field name="zip" string="Code postal"/>
                            <field name="city" string="Ville"/>
                            <field name="country_id" string="Pays" options="{'no_create': True}"/>
                        </group>
                        <group string="Adresse de livraison">
                            <field name="ka_liv_identique" string="Identique à l'adresse de facturation"/>
                            <field name="ka_liv_street" string="Rue" placeholder="N°, rue" readonly="ka_liv_identique"/>
                            <field name="ka_liv_zip" string="Code postal" readonly="ka_liv_identique"/>
                            <field name="ka_liv_city" string="Ville" readonly="ka_liv_identique"/>
                            <field name="ka_liv_country_id" string="Pays" readonly="ka_liv_identique" options="{'no_create': True}"/>
                        </group>

                        <div class="o_ka_h3">3. Conditions commerciales</div>
                        <div class="o_ka_note">Devise, incoterms et conditions de paiement par défaut.</div>
                        <group>
                            <field name="ka_devise_id" string="Devise" required="1" options="{'no_create': True}"/>
                            <label for="ka_inco_fob" string="Incoterms acceptés"/>
                            <div class="o_ka_docs">
                                <span class="o_ka_doc"><field name="ka_inco_fob" nolabel="1"/><label for="ka_inco_fob" string="FOB"/></span>
                                <span class="o_ka_doc"><field name="ka_inco_cfr" nolabel="1"/><label for="ka_inco_cfr" string="CFR"/></span>
                                <span class="o_ka_doc"><field name="ka_inco_cif" nolabel="1"/><label for="ka_inco_cif" string="CIF"/></span>
                                <span class="o_ka_doc"><field name="ka_inco_cpt" nolabel="1"/><label for="ka_inco_cpt" string="CPT"/></span>
                            </div>
                            <field name="ka_incoterm" string="Incoterm par défaut"/>
                            <field name="ka_paiement" string="Conditions de paiement" widget="radio" required="1"/>
                        </group>
                    </div>
                    <div class="col-lg-6">
                        <div class="o_ka_h3">4. Grades et spécifications qualité</div>
                        <div class="o_ka_note">Grades acceptés et grille des 7 tests utilisée par défaut sur les contrats du client.</div>
                        <group>
                            <label for="ka_grade_tsr10" string="Grades acceptés"/>
                            <div class="o_ka_docs">
                                <span class="o_ka_doc"><field name="ka_grade_tsr10" nolabel="1"/><label for="ka_grade_tsr10" string="TSR10"/></span>
                                <span class="o_ka_doc"><field name="ka_grade_tsr20" nolabel="1"/><label for="ka_grade_tsr20" string="TSR20"/></span>
                                <span class="o_ka_doc"><field name="ka_grade_offspecs" nolabel="1"/><label for="ka_grade_offspecs" string="OFFSPECS"/></span>
                            </div>
                        </group>
                        <field name="ka_spec_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="test" string="Test"/>
                                <field name="libelle" string="Libellé"/>
                                <field name="vmin" string="Min"/>
                                <field name="vmax" string="Max"/>
                            </list>
                        </field>
                        <div class="o_ka_info">Héritées automatiquement par les contrats <b>Long terme</b> (RG-5.3, RG-5.5) ; un contrat <b>Spot</b> peut les ajuster ponctuellement.</div>

                        <div class="o_ka_h3">5. Comptabilité</div>
                        <div class="o_ka_note">Informations comptables et bancaires utilisées pour la facturation et le suivi des règlements.</div>
                        <group>
                            <group>
                                <field name="property_account_receivable_id" string="Compte comptable"/>
                                <field name="ka_delai_reglement" string="Délai de règlement (jours)" class="o_ka_u_jours"/>
                            </group>
                            <group>
                                <field name="ka_regime_taxe" string="Régime de TVA"/>
                                <field name="ka_encours" string="Plafond d'encours autorisé"/>
                                <field name="ka_encours_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Coordonnées bancaires">
                            <field name="ka_banque" string="Banque de domiciliation" placeholder="Nom de la banque"/>
                            <field name="ka_iban" string="IBAN" placeholder="FR76 XXXX XXXX XXXX"/>
                            <field name="ka_bic" string="BIC / SWIFT" placeholder="XXXXXXXX"/>
                        </group>
                        <group string="Contact comptabilité">
                            <field name="ka_compta_nom" string="Nom" placeholder="Nom du contact"/>
                            <field name="ka_compta_email" string="Email" placeholder="compta@client.com"/>
                        </group>
                        <div class="o_ka_info">La banque de domiciliation est reprise par défaut sur les sous-contrats réglés par remise documentaire.</div>

                        <div class="o_ka_h3">6. Documents requis à l'expédition</div>
                        <div class="o_ka_note">Liasse à livrer au client avant clôture du dossier (RG-5.14).</div>
                        <div><field name="ka_doc_analyse" nolabel="1"/> <label for="ka_doc_analyse" string="Certificat d'analyse qualité"/></div>
                        <div><field name="ka_doc_thermique" nolabel="1"/> <label for="ka_doc_thermique" string="Certificat de traitement thermique"/></div>
                        <div><field name="ka_doc_phyto" nolabel="1"/> <label for="ka_doc_phyto" string="Certificat phytosanitaire"/></div>
                        <div><field name="ka_doc_garantie" nolabel="1"/> <label for="ka_doc_garantie" string="Certificat de garantie"/></div>
                        <div><field name="ka_doc_colisage" nolabel="1"/> <label for="ka_doc_colisage" string="Liste de colisage"/></div>
                        <div><field name="ka_doc_bl" nolabel="1"/> <label for="ka_doc_bl" string="Connaissement (BL)"/></div>
                        <div><field name="ka_doc_daex" nolabel="1"/> <label for="ka_doc_daex" string="Déclaration d'exportation (DAEX)"/></div>
                    </div>
                </div>
                <div class="o_ka_hint">* Champs obligatoires</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_client_tree" model="ir.ui.view">
    <field name="name">res.partner.ka.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml"><list string="ka_client"><field name="ka_code_client"/><field name="name"/><field name="country_id"/><field name="ka_cat_client"/><field name="ka_incoterm"/><field name="ka_client_state" widget="badge"/></list></field>
</record>
<record id="action_ka_client" model="ir.actions.act_window"><field name="name">Clients</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('ka_client', '=', True)]</field><field name="context">{'default_ka_client': True, 'default_customer_rank': 1}</field></record>
<record id="action_ka_client_l" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_client"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_client_tree"/></record>
<record id="action_ka_client_f" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_client"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_client_form"/></record>
</odoo>
