<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_client_form" model="ir.ui.view">
    <field name="name">res.partner.ka.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <form string="Client" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Données de base</span><span class="o_ka_c">Tiers</span><span class="o_ka_cur">Clients</span><span class="o_ka_fn">Fonction : GESBPC</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Client</h1><div class="o_ka_sub"><field name="ka_subtitle_client" nolabel="1" readonly="1"/></div></div>
                            <field name="ka_client_state" widget="badge" decoration-info="ka_client_state=='creation'" decoration-success="ka_client_state=='actif'"/>
                        </div>
                        <div class="o_ka_info">Les informations saisies sont reprises par défaut sur les commandes et commandes ouvertes du client : adresses, conditions commerciales, spécifications qualité et documents requis à l'expédition.</div><div class="o_ka_sec">Identification</div><div class="o_ka_grid"><div class="o_ka_f"><label for="ka_code_client" string="Client" class="o_ka_req"/><field name="ka_code_client" readonly="1"/></div><div class="o_ka_f"><label for="name" string="Raison sociale" class="o_ka_req"/><field name="name"/></div><div class="o_ka_f"><label for="country_id" string="Pays" class="o_ka_req"/><field name="country_id"/></div><div class="o_ka_f"><label for="ka_cat_client" string="Catégorie client"/><field name="ka_cat_client"/></div><div class="o_ka_f"><label for="ka_contact_commercial" string="Contact commercial"/><field name="ka_contact_commercial"/></div><div class="o_ka_f"><label for="email" string="E-mail"/><field name="email"/></div><div class="o_ka_f"><label for="phone" string="Téléphone"/><field name="phone"/></div><div class="o_ka_f"><label for="ka_acces_ventes" string="Code d'accès"/><field name="ka_acces_ventes"/></div></div><div class="o_ka_sec">Conditions commerciales et comptabilité</div><div class="o_ka_grid"><div class="o_ka_f"><label for="ka_devise_id" string="Devise" class="o_ka_req"/><field name="ka_devise_id"/></div><div class="o_ka_f"><label for="ka_incoterm" string="Incoterm"/><field name="ka_incoterm"/></div><div class="o_ka_f"><label for="ka_paiement" string="Condition de paiement" class="o_ka_req"/><field name="ka_paiement"/></div><div class="o_ka_f"><label for="ka_banque" string="Banque de domiciliation"/><field name="ka_banque"/></div><div class="o_ka_f"><label for="ka_collectif" string="Collectif" class="o_ka_req"/><field name="ka_collectif"/></div><div class="o_ka_f"><label for="ka_regime_taxe" string="Régime de taxe"/><field name="ka_regime_taxe"/></div><div class="o_ka_f"><label for="ka_delai_reglement" string="Délai de règlement"/><field name="ka_delai_reglement" class="o_ka_u_jours"/></div><div class="o_ka_f"><label for="ka_encours" string="Encours autorisé"/><field name="ka_encours"/></div></div><notebook><page string="Adresses"><field name="child_ids" nolabel="1"><list><field name="name"/><field name="type"/><field name="street"/><field name="city"/><field name="country_id"/></list></field></page><page string="Commercial"><div class="o_ka_info">Les conditions commerciales sont reprises par défaut sur les commandes et commandes ouvertes.</div></page><page string="Spécifications qualité"><div class="o_ka_h3">Spécifications qualité par défaut (7 tests) — table spécifique client</div><field name="ka_spec_ids" nolabel="1"><list editable="bottom"><field name="test" string="Test"/><field name="libelle" string="Libellé"/><field name="vmin" string="Min"/><field name="vmax" string="Max"/></list></field><div class="o_ka_docs"><span>Documents requis à l'expédition :</span><span class="o_ka_doc"><field name="ka_doc_analyse"/> <label for="ka_doc_analyse"/></span><span class="o_ka_doc"><field name="ka_doc_thermique"/> <label for="ka_doc_thermique"/></span><span class="o_ka_doc"><field name="ka_doc_phyto"/> <label for="ka_doc_phyto"/></span><span class="o_ka_doc"><field name="ka_doc_garantie"/> <label for="ka_doc_garantie"/></span><span class="o_ka_doc"><field name="ka_doc_colisage"/> <label for="ka_doc_colisage"/></span><span class="o_ka_doc"><field name="ka_doc_bl"/> <label for="ka_doc_bl"/></span><span class="o_ka_doc"><field name="ka_doc_daex"/> <label for="ka_doc_daex"/></span></div></page><page string="Documents requis"><div class="o_ka_info">Documents requis à l'expédition : voir l'onglet Spécifications qualité.</div></page><page string="Comptabilité"><div class="o_ka_grid"><div class="o_ka_f"><label for="property_account_receivable_id" string="Compte client"/><field name="property_account_receivable_id"/></div><div class="o_ka_f"><label for="property_account_position_id" string="Position fiscale"/><field name="property_account_position_id"/></div></div></page></notebook>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Créer" name="action_creer_client" type="object" class="o_ka_btn o_ka_primary"/><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Annuler" name="action_annuler_client" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_client_tree" model="ir.ui.view">
    <field name="name">res.partner.ka.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml"><list string="ka_client"><field name="ka_code_client"/><field name="name"/><field name="country_id"/><field name="ka_cat_client"/><field name="ka_incoterm"/><field name="ka_client_state" widget="badge"/></list></field>
</record>
<record id="action_ka_client" model="ir.actions.act_window"><field name="name">Clients</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('ka_client', '=', True)]</field><field name="context">{'default_ka_client': True, 'default_customer_rank': 1}</field></record>
<record id="action_ka_client_l" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_client"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_client_tree"/></record>
<record id="action_ka_client_f" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_client"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_client_form"/></record>
</odoo>
