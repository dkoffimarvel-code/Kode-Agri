<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_voyage_form" model="ir.ui.view">
    <field name="name">ka.voyage.ka.form</field>
    <field name="model">ka.voyage</field>
    <field name="arch" type="xml">
        <form string="Ordre de voyage" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Ventes</span><span class="o_ka_c">Logistique export</span><span class="o_ka_cur">Ordres de voyage</span><span class="o_ka_fn">Fonction : YVOY · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Ordre de voyage</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-info="state in ('planifie','affectes','empotage','a_cloturer')" decoration-success="state in ('cloture')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills" statusbar_visible="planifie,affectes,empotage,cloture"/><div class="o_ka_kpis"><div class="o_ka_kpi"><field name="nb_conteneurs" nolabel="1"/><span class="o_ka_kl">Conteneurs</span></div><div class="o_ka_kpi"><field name="limite_detention" nolabel="1"/><span class="o_ka_kl"><field name="limite_label" nolabel="1"/></span></div></div><notebook><page string="Planification de voyage"><div class="o_ka_sec">Étape 1 — planification (avant la prise des conteneurs)</div><div class="o_ka_grid"><div class="o_ka_f"><label for="name" string="N° voyage" class="o_ka_req"/><field name="name" readonly="1"/></div><div class="o_ka_f"><label for="transporteur_id" string="Transporteur" class="o_ka_req"/><field name="transporteur_id"/></div><div class="o_ka_f"><label for="vehicule" string="Véhicule" class="o_ka_req"/><field name="vehicule"/></div><div class="o_ka_f"><label for="type_transport" string="Type de transport" class="o_ka_req"/><field name="type_transport"/></div><div class="o_ka_f"><label for="date_prise_prevue" string="Prise des conteneurs prévue" class="o_ka_req"/><field name="date_prise_prevue"/></div><div class="o_ka_f"><label for="date_chargement_prevu" string="Chargement prévu" class="o_ka_req"/><field name="date_chargement_prevu"/></div><div class="o_ka_f"><label for="parc_armateur" string="Parc armateur" class="o_ka_req"/><field name="parc_armateur"/></div><div class="o_ka_f"><label for="parc_terre_plein" string="Parc terre-plein" class="o_ka_req"/><field name="parc_terre_plein"/></div><div class="o_ka_f"><label for="warehouse_id" string="Usine" class="o_ka_req"/><field name="warehouse_id"/></div></div><field name="line_ids" nolabel="1"><list editable="bottom"><field name="booking" string="N° booking"/><field name="contrat_id" string="Commande ouverte"/><field name="sous_contrat_id" string="Sous-contrat"/><field name="quantite" string="Quantité prévue"/><field name="poids_net_prevu" string="Poids net prévu"/></list></field><div class="o_ka_h3">Étape 2 — conteneurs affectés (article conteneur géré par numéro de série)</div><field name="conteneur_ids" nolabel="1"><list editable="bottom"><field name="armateur" string="Armateur"/><field name="serie" string="N° série conteneur"/><field name="plomb" string="N° plomb"/><field name="sous_contrat_id" string="Sous-contrat"/><field name="date_entree_parc" string="Entrée parc externe"/><field name="tare" string="Tare"/></list></field><p class="o_ka_note">À la validation de l'étape 2, les conteneurs entrent en stock par entrée diverse (coût nul) sur le dépôt d'expédition de l'usine ; l'alerte de détention est calculée par règle de workflow (MAERSK : prise + 13 jours).</p></page><page string="Affectation conteneurs"><div class="o_ka_grid"><div class="o_ka_f"><label for="conducteur" string="Conducteur"/><field name="conducteur"/></div><div class="o_ka_f"><label for="permis_numero" string="N° permis de conduire"/><field name="permis_numero"/></div><div class="o_ka_f"><label for="permis_categorie" string="Catégorie du permis"/><field name="permis_categorie"/></div><div class="o_ka_f"><label for="date_depart" string="Date de départ"/><field name="date_depart"/></div><div class="o_ka_f"><label for="heure_depart" string="Heure de départ"/><field name="heure_depart" widget="float_time"/></div><div class="o_ka_f"><label for="date_prise_effective" string="Date de prise des conteneurs"/><field name="date_prise_effective"/></div><div class="o_ka_f"><label for="priorite" string="Priorité"/><field name="priorite"/></div></div></page><page string="Immobilisation camion"><div class="o_ka_info">Frais d'immobilisation saisis après discussion avec le prestataire ; le motif est obligatoire avant la clôture du voyage (RG-5.19).</div><div class="o_ka_grid"><div class="o_ka_f"><label for="immo_motif" string="Motif de l'immobilisation"/><field name="immo_motif"/></div><div class="o_ka_f"><label for="immo_jours" string="Jours d'immobilisation"/><field name="immo_jours"/></div><div class="o_ka_f"><label for="immo_montant" string="Frais d'immobilisation (FCFA)"/><field name="immo_montant"/></div></div></page></notebook>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider l'affectation" name="action_valider_affectation" type="object" class="o_ka_btn o_ka_primary"/><button string="Clôturer le voyage" name="action_cloturer" type="object" class="o_ka_btn"/><button string="Imprimer" name="action_imprimer" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_voyage_tree" model="ir.ui.view">
    <field name="name">ka.voyage.ka.tree</field>
    <field name="model">ka.voyage</field>
    <field name="arch" type="xml"><list string="ka_voyage"><field name="name"/><field name="transporteur_id"/><field name="vehicule"/><field name="date_prise_prevue"/><field name="nb_conteneurs"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_voyage" model="ir.actions.act_window"><field name="name">Ordres de voyage</field><field name="res_model">ka.voyage</field><field name="view_mode">list,form</field></record>
</odoo>
