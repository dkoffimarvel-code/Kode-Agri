<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.3 — Ordre de voyage [Saisie] -->
<record id="view_ka_voyage_form" model="ir.ui.view">
    <field name="name">ka.voyage.ka.form</field>
    <field name="model">ka.voyage</field>
    <field name="arch" type="xml">
        <form string="Ordre de voyage" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Valider l'étape" name="action_valider_etape" type="object" class="btn-primary"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary"/>
                <field name="etape" widget="statusbar" statusbar_visible="brouillon,planifie,en_cours,a_cloturer,cloture"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_conteneurs_kpi"/></span><span class="o_stat_text">Conteneurs</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="type_transport" readonly="1"/></span><span class="o_stat_text">Type de transport</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="limite_detention"/></span><span class="o_stat_text"><field name="limite_label"/></span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Ordre de voyage <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle"/></div>
                </div>
                <field name="state" invisible="1"/>
                <div class="o_ka_info">L'ordre de voyage comporte 3 onglets de saisie, chacun correspondant à une étape de la réalisation du voyage : Planification de voyage → Affectation conteneurs → Immobilisation camion (le cas échéant).</div>
                <notebook>
                    <page string="Planification de voyage" name="planification">
                        <div class="o_ka_h3">Étape 1 — Planification de voyage (avant la prise des conteneurs)</div>
                        <group>
                            <group>
                                <field name="name" string="Numéro de voyage" readonly="1"/>
                                <field name="transporteur_id" string="Transporteur" required="1"/>
                                <field name="vehicule" string="Véhicule" required="1"/>
                                <field name="trajet" string="Trajet" required="1"/>
                                <field name="date_prise_prevue" string="Date de prise de conteneur prévue" required="1"/>
                                <field name="date_chargement_prevu" string="Date de chargement prévue" required="1"/>
                            </group>
                            <group>
                                <field name="warehouse_id" string="Usine" required="1"/>
                                <field name="port_embarquement" string="Port d'embarquement" required="1"/>
                                <field name="parc_armateur" string="Parc armateur" required="1"/>
                                <field name="appartenance" string="Appartenance" widget="badge" required="1"/>
                                <field name="type_transport" string="Type de transport" required="1"/>
                                <field name="parc_terre_plein" string="Parc terre-plein" required="1"/>
                            </group>
                        </group>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="booking" string="N° booking"/>
                                <field name="contrat_id" string="Contrat"/>
                                <field name="sous_contrat_id" string="Sous-contrat"/>
                                <field name="quantite" string="Quantité prévue"/>
                                <field name="poids_net_prevu" string="Poids net prévu" class="o_ka_u_kg"/>
                            </list>
                        </field>
                        <div class="o_ka_info">Quantité prévue et poids net prévu sont générés automatiquement : quantité toujours égale à 1 ; poids selon le type d'emballage du sous-contrat (Palette = 20 160 kg, Vrac = 21 420 kg).</div>
                    </page>
                    <page string="Affectation conteneurs" name="affectation">
                        <div class="o_ka_h3">Étape 2 — Affectation conteneurs (à la prise des conteneurs au parc armateur)</div>
                        <group>
                            <group>
                                <field name="series_txt" string="N° série conteneur(s)"/>
                                <field name="plombs_txt" string="N° de plomb"/>
                                <field name="conducteur" string="Conducteur"/>
                                <field name="permis_numero" string="N° permis de conduire"/>
                            </group>
                            <group>
                                <field name="permis_categorie" string="Catégorie permis"/>
                                <field name="date_depart" string="Date de départ"/>
                                <field name="heure_depart" string="Heure de départ" widget="float_time"/>
                                <field name="date_prise_effective" string="Date de prise de conteneurs"/>
                                <field name="priorite" string="Priorité"/>
                            </group>
                        </group>
                        <field name="conteneur_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="armateur" string="Armateur" widget="badge"/>
                                <field name="serie" string="N° série conteneur" class="fw-bold"/>
                                <field name="plomb" string="N° série plomb" class="fw-bold"/>
                                <field name="contrat_id" string="Contrat de vente"/>
                                <field name="sous_contrat_id" string="Sous-contrat"/>
                                <field name="booking" string="N° booking"/>
                                <field name="date_entree_parc" string="Entrée parc externe"/>
                                <field name="tare" string="Tare" class="o_ka_u_kg"/>
                                <field name="date_arrivee_parc" string="Arrivée au parc"/>
                            </list>
                        </field>
                        <div class="o_ka_info">À la validation de cette étape, un article conteneur est créé par armateur (géré en numéro de série) ; l'entrée en stock se fait par ajustement positif, coût unitaire zéro, sur le dépôt d'expédition de l'usine.</div>
                    </page>
                    <page string="Immobilisation camion" name="immobilisation">
                        <div class="o_ka_h3">Étape 3 — Immobilisation camion (le cas échéant, avant clôture du voyage)</div>
                        <div class="o_ka_warn_banner">⚠ La saisie des frais d'immobilisation, motif obligatoire, est requise avant la clôture du voyage (RG-5.19). Ces frais sont réceptionnés et facturés par la comptabilité à la clôture, comme la réception du voyage (RG-5.18).</div>
                        <group>
                            <group>
                                <field name="immo_constatee" string="Immobilisation constatée" widget="badge" decoration-warning="immo_constatee == 'oui'"/>
                                <field name="immo_motif" string="Motif de l'immobilisation" required="immo_constatee == 'oui'"/>
                                <field name="immo_prestataire_id" string="Prestataire concerné" required="immo_constatee == 'oui'"/>
                                <field name="immo_discussion" string="Discussion prestataire" widget="badge" decoration-success="immo_discussion == 'confirmee'" decoration-warning="immo_discussion == 'en_cours'" decoration-danger="immo_discussion == 'contestee'" required="immo_constatee == 'oui'"/>
                            </group>
                            <group>
                                <field name="immo_date_debut" string="Date de début" required="immo_constatee == 'oui'"/>
                                <field name="immo_date_fin" string="Date de fin" required="immo_constatee == 'oui'"/>
                                <field name="immo_jours" string="Durée" class="o_ka_u_jours"/>
                                <field name="immo_montant" string="Montant des frais" class="o_ka_u_fcfa" required="immo_constatee == 'oui'"/>
                            </group>
                        </group>
                        <group invisible="not po_voyage_id">
                            <field name="po_voyage_id" string="Réception du voyage"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_voyage_tree" model="ir.ui.view">
    <field name="name">ka.voyage.ka.tree</field>
    <field name="model">ka.voyage</field>
    <field name="arch" type="xml"><list string="ka_voyage"><field name="name"/><field name="transporteur_id"/><field name="vehicule"/><field name="date_prise_prevue"/><field name="nb_conteneurs"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_voyage" model="ir.actions.act_window"><field name="name">Voyages</field><field name="res_model">ka.voyage</field><field name="view_mode">list,form</field></record>
</odoo>
