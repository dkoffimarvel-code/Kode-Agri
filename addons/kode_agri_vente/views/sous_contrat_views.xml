<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 5.2c — Sous-contrat — instructions client et booking [Approbation] -->
<record id="view_ka_sc_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="priority">10</field>
    <field name="arch" type="xml">
        <form string="Sous-contrat" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Valider le booking" name="action_valider_booking" type="object" class="btn-primary"/>
                <button string="Imprimer ordre de transit" name="action_ordre_transit" type="object" class="btn-secondary"/>
                <button string="Scinder le sous-contrat" name="action_scinder" type="object" class="btn-secondary"/>
                <button string="Instructions saisies" name="action_instructions" type="object" class="btn-secondary" invisible="state != 'brouillon'"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,instructions,booke,expedie"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="empotes_kpi"/></span><span class="o_stat_text">Empoté</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="restant_empoter_kpi"/></span><span class="o_stat_text">Restant à empoter</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="embarques_ctn_kpi"/></span><span class="o_stat_text">Embarqué</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="quantite_kpi"/></span><span class="o_stat_text">Quantité</span></div>
                    </button>
                    <button name="action_open_contrat" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="poids_txt"/></span><span class="o_stat_text">Poids à livrer</span></div>
                    </button>
                    <button name="action_open_contrat" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="limite_booking"/></span><span class="o_stat_text">Limite booking</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Sous-contrat <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Créé à réception des instructions client</div>
                </div>
                <div class="o_ka_info"><field name="info_booking"/></div>
                <field name="bmc_requis" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="contrat_id" string="N° contrat de vente 1" required="1" options="{'no_create': True}"/>
                        <field name="contrat2_id" string="N° contrat de vente 2 (optionnel)" options="{'no_create': True}"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" decoration-success="tracabilite == 'eudr'" decoration-warning="tracabilite == 'non_eudr'"/>
                        <field name="warehouse_id" string="Usine" required="1"/>
                        <field name="armateur" string="Armateur" widget="badge" required="1"/>
                        <field name="transitaire_id" string="Transitaire" required="1"/>
                        <field name="navire" string="Navire souhaité" required="1"/>
                        <field name="voyage_no" string="N° voyage" required="1"/>
                        <field name="booking" string="N° booking" required="state != 'brouillon'"/>
                        <field name="bmc" string="N° BMC" required="bmc_requis and state != 'brouillon'"/>
                        <field name="marquage" string="Marquage palette" required="1"/>
                        <field name="product_id" string="Grade de l'article" required="1" options="{'no_create': True}"/>
                        <field name="poids_kg" string="Poids à livrer (kg)" class="o_ka_u_kg" required="1"/>
                        <field name="conversion_txt" string="→ Conversion"/>
                        <field name="conditionnement" string="Conditionnement" required="1"/>
                    </group>
                    <group>
                        <field name="prix_t" string="Prix en devise" class="o_ka_u_eurt"/>
                        <field name="montant" string="Montant en devise"/>
                        <field name="contre_valeur" string="Montant en FCFA"/>
                        <field name="doc_phyto_requis" string="Document phyto"/>
                        <field name="certificat_garantie" string="Certificat garantie"/>
                        <field name="banque" string="Banque domiciliation"/>
                        <field name="paiement" string="Paiement" required="1"/>
                        <field name="country_id" string="Pays destination" required="1"/>
                        <field name="date_embarquement_prevue" string="Date prévue embarq." required="1"/>
                        <field name="date_fermeture_navire" string="Date fermeture navire" required="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Général" name="general">
                        <div class="o_ka_h3">Spécifications (7 tests)</div>
                        <div class="o_ka_note"><field name="spec_note"/></div>
                        <field name="spec_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="test" string="Test"/>
                                <field name="libelle" string="Libellé"/>
                                <field name="standard" string="Standard"/>
                                <field name="applique" string="Appliqué"/>
                                <field name="source" string="Source"/>
                            </list>
                        </field>
                        <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Booking validé → date limite calculée (48 h même mois / 7 j mois précédent). BMC obligatoire pour MAERSK : date BMC = validation booking + 1 jour. Détention conteneur MAERSK : prise + 13 jours.</div>
                        <group>
                            <group>
                                <field name="date_instructions" string="Instructions saisies le"/>
                                <field name="date_booking_valide" string="Booking validé le"/>
                                <field name="date_bmc" string="Date du BMC"/>
                            </group>
                            <group>
                                <field name="date_embarquement_maj" string="Mise à jour de l'embarquement"/>
                                <field name="remarques" string="Autres remarques client"/>
                            </group>
                        </group>
                    </page>
                    <page string="Frais supplémentaires" name="frais">
                        <div class="o_ka_h3">Frais supplémentaires du sous-contrat (RG-5.21)</div>
                        <field name="frais_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="libelle" string="Motif"/>
                                <field name="fournisseur_id" string="Fournisseur"/>
                                <field name="montant" string="Montant" sum="Total"/>
                                <field name="saisi_par_id" string="Saisi par"/>
                            </list>
                        </field>
                        <div class="o_ka_info">À utiliser pour tout frais non prévu (ex. changement de navire) survenant avant l'expédition du sous-contrat. Cette saisie est requise avant la validation de l'expédition (RG-5.21).</div>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 5.2d — Ordre de transit — imprimé depuis le sous-contrat [Consultation] -->
<record id="view_ka_sc_transit_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.transit.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Ordre de transit" class="o_ka_form">
            <header>
                <button string="Générer PDF" name="action_imprimer" type="object" class="btn-primary"/>
                <button string="Envoyer au transitaire" name="action_envoyer_email" type="object" class="btn-secondary"/>
                <button string="Retour au sous-contrat" name="action_retour_sc" type="object" class="btn-secondary"/>
                <field name="ot_state" widget="statusbar" statusbar_visible="prepare,transmis"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Ordre de transit <field name="ot_numero" class="d-inline"/></h1>
                    <div class="o_ka_sub">À destination du transitaire</div>
                </div>
                <group>
                    <group>
                        <field name="armateur" string="Compagnie maritime" required="1"/>
                        <field name="navire_arrivee" string="Navire + arrivée"/>
                        <field name="booking" string="N° booking" required="1"/>
                        <field name="shipper" string="Shipper"/>
                    </group>
                    <group>
                        <field name="notify1" string="Notify party 1" placeholder="—"/>
                        <field name="notify2" string="Notify party 2" placeholder="—"/>
                        <field name="notify3" string="Notify party 3" placeholder="—"/>
                        <field name="consignee" string="Consignee 1" placeholder="—"/>
                        <field name="consignee2" string="Consignee 2" placeholder="—"/>
                    </group>
                </group>
                <div class="o_ka_h3">Marchandise et liasse documentaire</div>
                <table class="o_ka_tbl">
                    <thead><tr><th>Description marchandise</th><th>Liasse documentaire demandée</th></tr></thead>
                    <tbody><tr>
                        <td><field name="description_marchandise" nolabel="1"/></td>
                        <td><field name="liasse_demandee" nolabel="1"/></td>
                    </tr></tbody>
                </table>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>L'ordre de transit reprend les informations du sous-contrat et la liste des documents demandés par le client.</div>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 5.2e — Suivi des dates au départ port [Saisie] -->
<record id="view_ka_sc_jalons_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.jalons.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Suivi départ port" class="o_ka_form">
            <header>
                <button string="Enregistrer dates" special="save" class="btn-primary"/>
                <button string="Clôturer le départ" name="action_cloturer_jalons" type="object" class="btn-secondary"/>
                <field name="depart_state" widget="statusbar" statusbar_visible="en_cours,cloture"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Suivi départ port — <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Jalons et références réglementaires</div>
                </div>
                <group>
                    <group>
                        <field name="date_bl_impression" string="Date impression BL"/>
                        <field name="date_depart_bateau" string="Date départ bateau"/>
                        <field name="date_bl_reception" string="Date réception BL"/>
                        <field name="date_docs_expedies" string="Date expédition doc."/>
                        <field name="date_phyto_reception" string="Date réception phyto"/>
                    </group>
                    <group>
                        <field name="date_bae_reception" string="Date réception bon à embarquer"/>
                        <field name="daex" string="Numéro DAEX"/>
                        <label for="d6_numero" string="Numéro D6 + date"/>
                        <div class="o_row">
                            <field name="d6_numero" nolabel="1"/>
                            <span>·</span>
                            <field name="d6_date" nolabel="1"/>
                        </div>
                        <field name="ae_ec" string="Numéro AE + EC"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Suivi des jalons de départ port jusqu'à la clôture documentaire de l'expédition.</div>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 5.4c — Déclaration d'exportation — DUS et Parafiscalité [Saisie] -->
<record id="view_ka_sc_decl_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.decl.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Déclaration d'exportation" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <field name="decl_state" widget="statusbar" statusbar_visible="recue"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Déclaration d'exportation — <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub"><field name="contrat_id" readonly="1" options="{'no_open': True}"/> · Reçue du transitaire <field name="transitaire_id" readonly="1" options="{'no_open': True}"/></div>
                </div>
                <field name="company_currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="decl_numero" string="N° déclaration d'exportation" required="1"/>
                        <field name="decl_date" string="Date de déclaration" required="1"/>
                    </group>
                    <group>
                        <field name="prix_caf" string="Prix de référence CAF"/>
                        <field name="droits_taxes" string="Droits de douane et taxes (base)"/>
                    </group>
                </group>
                <div class="o_ka_h3">Commande d'achat — DUS <button string="Générer DUS" name="action_generer_dus" type="object" class="btn btn-primary btn-sm ms-2"/></div>
                <field name="dus_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="ligne" string="Ligne"/>
                        <field name="base" string="Base de calcul"/>
                        <field name="taux" string="Taux"/>
                        <field name="montant" string="Montant" class="o_ka_u_fcfa" sum="Total commande DUS"/>
                    </list>
                </field>
                <div class="o_ka_h3">Commande d'achat — Parafiscalité <button string="Générer Parafiscalité" name="action_generer_parafiscalite" type="object" class="btn btn-primary btn-sm ms-2"/></div>
                <field name="parafisc_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="ligne" string="Ligne"/>
                        <field name="base" string="Base de calcul"/>
                        <field name="taux" string="Taux"/>
                        <field name="montant" string="Montant" class="o_ka_u_fcfa" sum="Total commande Parafiscalité"/>
                    </list>
                </field>
                <div class="o_ka_info">Les taux et lignes de chaque commande sont paramétrés dans le système. Agios trésor et gestion crédit se calculent sur les droits de douane et taxes ; TCT sur le prix de référence CAF ; TS douane est un forfait par dossier ; la parafiscalité se calcule sur le poids du contrat.</div>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 5.5 — Transfert des conteneurs vers le port [Saisie] -->
<record id="view_ka_sc_port_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.port.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Transfert conteneurs" class="o_ka_form">
            <header>
                <button string="Actualiser statuts" name="action_actualiser_statuts" type="object" class="btn-secondary"/>
                <button string="Transférer les conteneurs sélectionnés" name="action_transferer_port" type="object" class="btn-primary"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="transferts_kpi"/></span><span class="o_stat_text">Transferts effectués</span></div>
                    </button>
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ctn_transferes_kpi"/></span><span class="o_stat_text">Conteneurs transférés</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Transfert conteneurs — <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Sous-contrat <field name="contrat_id" readonly="1" options="{'no_open': True}"/> · Armateur <field name="armateur" readonly="1"/></div>
                </div>
                <div class="o_ka_info">La logistique consulte chaque jour la plateforme du transitaire pour suivre le statut des conteneurs, puis transfère les numéros de série vers la plateforme de l'armateur à la date d'entrée au port. Cette opération transfère les colis liés vers le port en conservant leur traçabilité. Un sous-contrat peut faire l'objet d'un ou plusieurs transferts.</div>
                <group>
                    <group>
                        <field name="bae_numero" string="N° BAE (bon à embarquer)" required="1"/>
                        <field name="bae_date" string="Date de réception du BAE"/>
                        <field name="transporteur_id" string="Transporteur"/>
                        <field name="proprietaire_parc" string="Propriétaire parc"/>
                    </group>
                    <group>
                        <field name="plateforme_transitaire" string="Plateforme transitaire"/>
                        <field name="plateforme_armateur" string="Plateforme armateur"/>
                    </group>
                </group>
                <div class="o_ka_h3">Conteneurs du sous-contrat — statuts et transfert vers le port</div>
                <field name="conteneur_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="serie" string="N° série conteneur" readonly="1" class="fw-bold"/>
                        <field name="statut_transitaire" string="Statut plateforme transitaire" widget="badge" decoration-success="1"/>
                        <field name="date_entree_port" string="Date d'entrée au port"/>
                        <field name="transfert_label" string="Transfert armateur" widget="badge" decoration-success="transfert_effectue" decoration-warning="not transfert_effectue"/>
                        <field name="transfert_effectue" column_invisible="1"/>
                        <button string="Consulter" name="action_consulter" type="object" class="btn-secondary btn-sm"/>
                    </list>
                </field>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 5.6 — Départ du navire et clôture documentaire [Approbation] -->
<record id="view_ka_sc_depart_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.depart.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Départ du navire" class="o_ka_form">
            <header>
                <button string="Valider le BL vente" name="action_valider_bl" type="object" class="btn-secondary"/>
                <button string="Éditer liste de colisage" name="action_liste_colisage" type="object" class="btn-secondary"/>
                <button string="Expédier le sous-contrat" name="action_valider_livraison" type="object" class="btn-primary"/>
                <button string="Générer la facture" name="action_generer_facture" type="object" class="btn-secondary" invisible="state not in ('expedie', 'cloture') or invoice_id"/>
                <button string="Clôturer le dossier" name="action_cloturer_dossier" type="object" class="btn-secondary" invisible="state != 'expedie'"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_conteneurs" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="embarques_kpi"/></span><span class="o_stat_text">Conteneurs embarqués</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Départ du navire — <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub"><field name="depart_sub"/></div>
                </div>
                <field name="invoice_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="bl_numero" string="N° connaissement (BL)" required="1"/>
                        <field name="date_depart_navire" string="Date de départ du navire" required="1"/>
                    </group>
                    <group>
                        <field name="plateforme_transitaire" string="Plateforme transitaire"/>
                        <field name="tous_embarques_txt" string="Tous les colis embarqués ?" widget="badge" decoration-success="tous_embarques_txt == 'Oui'" decoration-warning="tous_embarques_txt != 'Oui'"/>
                    </group>
                </group>
                <div class="o_ka_info">Tous les conteneurs du sous-contrat ont été embarqués. La logistique expédie le sous-contrat à la date d'embarquement portée sur le BL ; la comptabilité facture ensuite le sous-contrat.</div>
                <div class="o_ka_h3">Conteneurs concernés</div>
                <field name="conteneur_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="serie" string="N° série conteneur" class="fw-bold"/>
                        <field name="embarquement_label" string="Statut embarquement" widget="badge" decoration-success="embarquement_label == 'Embarqué'" decoration-warning="embarquement_label == 'À quai'"/>
                        <field name="sous_contrat_id" string="Sous-contrat"/>
                    </list>
                </field>
                <div class="o_ka_h3">Liasse documentaire client (RG-5.14)</div>
                <div><field name="doc_bl" nolabel="1"/> <label for="doc_bl" string="Connaissement (BL vente)"/></div>
                <div><field name="doc_colisage" nolabel="1"/> <label for="doc_colisage" string="Liste de colisage"/></div>
                <div><field name="doc_analyse" nolabel="1"/> <label for="doc_analyse" string="Certificat d'analyse qualité"/></div>
                <div><field name="doc_facture" nolabel="1"/> <label for="doc_facture" string="Facture client (à émettre à la clôture)"/></div>
                <group>
                    <group>
                        <field name="frais_declares_txt" string="Frais supplémentaires déclarés ?" widget="badge" decoration-success="frais_declares_txt == 'Non'" decoration-warning="frais_declares_txt == 'Oui'"/>
                    </group>
                    <group>
                        <label for="name" string="Onglet « Frais supplémentaires »"/>
                        <button name="action_retour_sc" type="object" class="btn-link p-0 fw-bold">Voir sous-contrat <field name="name" readonly="1" class="d-inline"/></button>
                    </group>
                </group>
                <div class="o_ka_info">En cas de frais supplémentaires (ex. changement de navire), la logistique les inscrit sur le sous-contrat, onglet « Frais supplémentaires », avant de valider l'expédition.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_sc_tree" model="ir.ui.view">
    <field name="name">ka.sous.contrat.ka.tree</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml"><list string="ka_sc"><field name="name"/><field name="contrat_id"/><field name="partner_id"/><field name="poids_kg" sum="Total"/><field name="armateur"/><field name="booking"/><field name="date_embarquement_prevue"/><field name="state" widget="badge"/></list></field>
