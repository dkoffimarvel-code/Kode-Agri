                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Transférer les conteneurs sélectionnés" name="action_transferer_port" type="object" class="o_ka_btn o_ka_primary"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
