                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_sc_port_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Transfert des conteneurs vers le port" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Ventes</span><span class="o_ka_c">Logistique export</span><span class="o_ka_cur">Transferts port</span><span class="o_ka_fn">Fonction : YTRP · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Transfert des conteneurs vers le port</h1><div class="o_ka_sub"><field name="name" nolabel="1" readonly="1"/> — commande ouverte <field name="contrat_id" nolabel="1" readonly="1"/> · armateur <field name="armateur" nolabel="1" readonly="1"/></div></div>
