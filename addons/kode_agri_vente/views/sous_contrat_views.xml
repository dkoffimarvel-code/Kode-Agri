<record id="view_ka_sc_decl_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Déclaration d'exportation — DUS et parafiscalité" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Ventes</span><span class="o_ka_c">Logistique export</span><span class="o_ka_cur">Déclarations d'exportation</span><span class="o_ka_fn">Fonction : YDEX · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Déclaration d'exportation — DUS et parafiscalité</h1><div class="o_ka_sub"><field name="name" nolabel="1" readonly="1"/> — commande ouverte <field name="contrat_id" nolabel="1" readonly="1"/> · reçue du transitaire <field name="transitaire_id" nolabel="1" readonly="1"/></div></div>
