paiement" string="Condition de paiement" class="o_ka_req"/><field name="paiement"/></div></div><div class="o_ka_sec">Booking</div><div class="o_ka_grid"><div class="o_ka_f"><label for="armateur" string="Armateur" class="o_ka_req"/><field name="armateur"/></div><div class="o_ka_f"><label for="transitaire_id" string="Transitaire" class="o_ka_req"/><field name="transitaire_id"/></div><div class="o_ka_f"><label for="navire" string="Navire souhaité" class="o_ka_req"/><field name="navire"/></div><div class="o_ka_f"><label for="voyage_no" string="N° voyage" class="o_ka_req"/><field name="voyage_no"/></div><div class="o_ka_f"><label for="booking" string="N° booking" class="o_ka_req"/><field name="booking"/></div><div class="o_ka_f"><label for="bmc" string="N° BMC" class="o_ka_req"/><field name="bmc"/></div><div class="o_ka_f"><label for="date_embarquement_prevue" string="Embarquement prévu" class="o_ka_req"/><field name="date_embarquement_prevue"/></div><div class="o_ka_f"><label for="date_fermeture_navire" string="Fermeture du navire" class="o_ka_req"/><field name="date_fermeture_navire"/></div><div class="o_ka_f"><label for="prix_t" string="Prix" class="o_ka_req"/><field name="prix_t" readonly="1" class="o_ka_u_eurt"/></div><div class="o_ka_f"><label for="montant" string="Montant en devise"/><field name="montant" readonly="1"/></div><div class="o_ka_f"><label for="contre_valeur" string="Contre-valeur"/><field name="contre_valeur" readonly="1"/></div><div class="o_ka_f"><label for="banque" string="Banque de domiciliation"/><field name="banque"/></div></div><notebook><page string="Général"><field name="remarques" placeholder="Autres remarques client"/><div class="o_ka_grid"><div class="o_ka_f"><label for="date_embarquement_maj" string="Mise à jour de l'embarquement"/><field name="date_embarquement_maj"/></div></div></page><page string="Spécifications"><field name="spec_ids" nolabel="1" readonly="1"><list><field name="test"/><field name="libelle"/><field name="standard"/><field name="applique"/><field name="source"/></list></field></page><page string="Frais supplémentaires"><field name="frais_ids" nolabel="1"><list editable="bottom"><field name="libelle"/><field name="montant" sum="Total"/></list></field></page></notebook>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider le booking" name="action_valider_booking" type="object" class="o_ka_btn o_ka_primary"/><button string="Imprimer l'ordre de transit" name="action_ordre_transit" type="object" class="o_ka_btn"/><button string="Scinder le sous-contrat" name="action_scinder" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_sc_transit_form" model="ir.ui.view">
    <field name="name">ka.sous.contrat.ka.form</field>
    <field name="model">ka.sous.contrat</field>
    <field name="arch" type="xml">
        <form string="Ordre de transit" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Ventes</span><span class="o_ka_c">Commandes ouvertes</span><span class="o_ka_c">Sous-contrats</span><span class="o_ka_cur">Ordre de transit</span><span class="o_ka_fn">Fonction : YSCT · état spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Ordre de transit</h1><div class="o_ka_sub"><field name="ot_numero" nolabel="1" readonly="1"/> — à destination du transitaire</div></div>
                            
                        </div>
                        <div class="o_ka_sec">Expédition</div><div class="o_ka_grid"><div class="o_ka_f"><label for="armateur" string="Compagnie maritime"/><field name="armateur" readonly="1"/></div><div class="o_ka_f"><label for="navire_arrivee" string="Navire et arrivée"/><field name="navire_arrivee" readonly="1"/></div><div class="o_ka_f"><label for="booking" string="N° booking"/><field name="booking" readonly="1"/></div><div class="o_ka_f"><label for="shipper" string="Shipper"/><field name="shipper"/></div><div class="o_ka_f"><label for="notify1" string="Notify party 1"/><field name="notify1"/></div><div class="o_ka_f"><label for="notify2" string="Notify party 2"/><field name="notify2"/></div><div class="o_ka_f"><label for="notify3" string="Notify party 3"/><field name="notify3"/></div><div class="o_ka_f"><label for="consignee" string="Consignee"/><field name="consignee"/></div></div><div class="o_ka_sec">Marchandise et liasse documentaire</div><div class="o_ka_grid"><div class="o_ka_f"><label for="description_marchandise" string="Description de la marchandise"/><field name="description_marchandise"/></div><div class="o_ka_f"><label for="liasse_demandee" string="Liasse documentaire demandée"/><field name="liasse_demandee"/></div></div><p class="o_ka_note">L'ordre de transit reprend les informations du sous-contrat et la liste des documents demandés par le client.</p>
                    </div>
