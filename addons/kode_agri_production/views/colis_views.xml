<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écrans 4.2b — Déclaration du colis — consommation des balles d'un ou plusieurs paniers [Saisie]
     et 4.3c — Déclaration colis de l'OF d'essai [Saisie] (même vue : contenu selon le type d'OF) -->
<record id="view_ka_colis_form" model="ir.ui.view">
    <field name="name">ka.colis.ka.form</field>
    <field name="model">ka.colis</field>
    <field name="arch" type="xml">
        <form string="Déclaration du colis" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Déclarer le colis" name="action_valider" type="object" class="btn-primary" invisible="state != 'brouillon'"/>
                <button string="Déclasser le colis" name="action_declasser" type="object" class="o_ka_btn_danger" invisible="of_type == 'essai' or state == 'annule'"/>
                <button string="Annuler" name="action_annuler" type="object" class="btn-secondary" invisible="state != 'brouillon'"/>
                <button string="Imprimer l'étiquette" name="action_etiquette" type="object" class="btn-secondary" invisible="state != 'valide'"/>
                <field name="of_state" widget="statusbar" statusbar_visible="planifie,lance,produit,specifie" invisible="of_type == 'essai'"/>
                <field name="of_state" widget="statusbar" statusbar_visible="planifie,en_essai,produit,specifie" invisible="of_type != 'essai'"/>
            </header>
            <sheet>
                <field name="of_type" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="texture" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_voir_paniers" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="qty" class="o_ka_u_kg"/></span><span class="o_stat_text" invisible="of_type == 'essai'">Poids série</span><span class="o_stat_text" invisible="of_type != 'essai'">Poids colis</span></div>
                    </button>
                    <button name="action_voir_paniers" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value" invisible="of_type == 'essai'"><field name="balles_label"/></span><span class="o_stat_value" invisible="of_type != 'essai'"><field name="balles_total"/></span><span class="o_stat_text">Balles</span></div>
                    </button>
                    <button name="action_voir_paniers" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="paniers_label"/></span><span class="o_stat_text">Consommés</span></div>
                    </button>
                </div>
                <div class="o_ka_info" invisible="of_type == 'essai'">Étape 3 — Déclaration du colis sérialisé. Le colis consomme les balles d'un ou de plusieurs paniers déclarés. En cas de défaut, il peut être déclassé directement à la production (OFFSPECS).</div>
                <div class="o_ka_info" invisible="of_type != 'essai'">Étape 3 — Déclaration du colis de l'OF d'essai. Le colis consomme les balles des paniers déclarés, comme pour l'OF de production. Le mélange source sera consommé à la clôture, sans consommation matière.</div>
                <div class="oe_title">
                    <div class="o_ka_hint"><field name="titre_label"/></div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group string="Colis" invisible="of_type == 'essai'">
                    <group>
                        <field name="product_id" string="Produit" widget="badge" invisible="state == 'brouillon'"/>
                        <field name="product_id" string="Produit" required="1" invisible="state != 'brouillon'"/>
                        <field name="name" string="N° de série" readonly="1"/>
                        <field name="lot_label" string="N° de lot"/>
                        <field name="statut_id" string="Statut colis" widget="badge" decoration-danger="texture != 'conforme'" decoration-muted="texture == 'conforme'"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="qty" string="Poids net colis" required="1" class="o_ka_u_kg"/>
                        <field name="composition" string="Composition" readonly="1"/>
                        <field name="balles_requises" string="Balles requises"/>
                        <field name="motif" string="Motif de déclassement"/>
                    </group>
                </group>
                <group string="Colis" invisible="of_type != 'essai'">
                    <group>
                        <field name="product_id" string="Produit" widget="badge" invisible="state == 'brouillon'"/>
                        <field name="product_id" string="Produit" required="1" invisible="state != 'brouillon'"/>
                        <field name="qty" string="Poids net colis" required="1" class="o_ka_u_kg"/>
                        <field name="composition" string="Composition" readonly="1"/>
                        <field name="balles_requises" string="Balles requises"/>
                        <field name="conso_matiere" string="Consommation matière mélange" widget="badge" decoration-danger="1"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="statut_label" string="Statut colis" widget="badge" decoration-muted="1"/>
                        <field name="name" string="N° de série" readonly="1"/>
                        <field name="of_id" string="OF d'essai lié" readonly="state != 'brouillon'"/>
                        <field name="melange_source_id" string="Mélange source"/>
                    </group>
                </group>
                <group invisible="of_id">
                    <group>
                        <field name="of_id" string="OF" required="1"/>
                    </group>
                </group>
                <notebook>
                    <page string="Paniers consommés" name="paniers">
                        <field name="panier_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="panier_id" string="N° chrono panier"/>
                                <field name="panier_name" string="N° panier"/>
                                <field name="sechoir_id" string="N° séchoir"/>
                                <field name="balles_avant" string="Balles dispo. avant"/>
                                <field name="balles" string="Balles utilisées" sum="Total balles consommées"/>
                                <field name="balles_restantes" string="Balles restantes" sum="Total"/>
                            </list>
                        </field>
                    </page>
                    <page string="Composants" name="composants">
                        <div class="o_ka_info o_ka_noicon">Le colis consomme 36 balles de 35 kg issues d'un ou plusieurs paniers validés de l'OF.</div>
                        <group>
                            <group>
                                <field name="location_id" string="Emplacement"/>
                            </group>
                        </group>
                    </page>
                    <page string="Qualité" name="qualite">
                        <div class="o_ka_info o_ka_noicon">Le contrôle qualité du colis est rattaché au lot (spécification laboratoire, libération).</div>
                        <group>
                            <group>
                                <field name="texture" string="Défaut de texture"/>
                                <field name="lot_id" string="Lot"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                <div class="o_ka_valid" invisible="of_type == 'essai'"><span class="o_ka_valid_t">Validation / Approbation</span>Traçabilité : le colis hérite le statut de traçabilité (EUDR / NON EUDR) de l'OF de production auquel il est rattaché.</div>
                <div class="o_ka_valid" invisible="of_type != 'essai'"><span class="o_ka_valid_t">Validation / Approbation</span>Traçabilité : comme pour l'OF de production, le colis d'essai hérite le statut de traçabilité de l'OF d'essai auquel il est rattaché.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_colis_tree" model="ir.ui.view">
    <field name="name">ka.colis.ka.tree</field>
    <field name="model">ka.colis</field>
    <field name="arch" type="xml"><list string="ka_colis"><field name="name"/><field name="of_id"/><field name="product_id"/><field name="qty"/><field name="statut_id"/><field name="tracabilite" widget="badge"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_colis" model="ir.actions.act_window"><field name="name">Colis</field><field name="res_model">ka.colis</field><field name="view_mode">list,form</field></record>
</odoo>
