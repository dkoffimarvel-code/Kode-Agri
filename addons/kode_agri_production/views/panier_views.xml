<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écrans 4.4 — Déclaration panier — vue formulaire [Saisie]
     et 4.3b — Déclaration panier de l'OF d'essai [Saisie] (même vue : bandeau et titre selon le type d'OF) -->
<record id="view_ka_panier_form" model="ir.ui.view">
    <field name="name">ka.panier.ka.form</field>
    <field name="model">ka.panier</field>
    <field name="arch" type="xml">
        <form string="Déclaration de panier" class="o_ka_form">
            <header>
                <button string="Passer au contrôle" name="action_passer_controle" type="object" class="btn-primary" invisible="state != 'ouvert'"/>
                <button string="Annuler le contrôle" name="action_annuler_controle" type="object" class="btn-secondary"/>
                <button string="Validé" name="action_valider" type="object" class="btn-secondary" invisible="state in ('valide', 'cloture')"/>
                <button string="Annuler" name="action_annuler" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="ouvert,controle,valide,cloture"/>
            </header>
            <sheet>
                <field name="of_type" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_voir_colis" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="poids_balles" class="o_ka_u_kg"/></span><span class="o_stat_text">Poids des balles</span></div>
                    </button>
                    <button name="action_voir_colis" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_balles"/></span><span class="o_stat_text">Balles</span></div>
                    </button>
                    <button name="action_voir_qc" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="cycle_label"/></span><span class="o_stat_text">Cycle séchage</span></div>
                    </button>
                </div>
                <div class="o_ka_info" invisible="of_type != 'essai'">Étape 2 — Déclaration panier de l'OF d'essai. Même procédure que pour l'OF de production (§ 4.2.5).</div>
                <div class="oe_title">
                    <div class="o_ka_hint"><field name="titre_label"/></div>
                    <h1><field name="chrono" readonly="1"/></h1>
                </div>
                <group string="Suivi des paniers">
                    <group>
                        <field name="cycle_min" string="Cycle (temps) de séchage"/>
                    </group>
                    <group>
                        <field name="nb_pains" string="Nbre pains"/>
                    </group>
                </group>
                <group string="Déclaration panier">
                    <group>
                        <field name="name" string="N° panier"/>
                        <field name="chrono" string="N° chronologique du panier" readonly="1"/>
                        <field name="nb_balles" string="Nbr. des balles"/>
                        <field name="balles_restantes" string="Balles restantes"/>
                        <field name="date_production" string="Date production"/>
                        <field name="temp_bruleur1" string="Temp. brûleur 1"/>
                        <field name="temp_bruleur2" string="Temp. brûleur 2"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="temp_balles" string="Température des balles"/>
                        <field name="heure_sortie" string="Heure de sortie du séchoir"/>
                        <field name="poids_balles" string="Poids des balles"/>
                        <field name="state" string="Statut de panier" readonly="1"/>
                        <field name="user_id" string="Utilisateur"/>
                        <field name="controle_valide" string="Contrôle validé" widget="boolean_toggle"/>
                        <field name="transfert_controle" string="Transfert vers contrôle qualité" widget="boolean_toggle"/>
                        <field name="of_id" string="OF"/>
                        <field name="sechoir_id" string="Séchoir"/>
                    </group>
                </group>
                <notebook>
                    <page string="Colis rattachés" name="colis">
                        <div class="o_ka_note">Lignes de colis rattachés au panier — N° de lot, nombre de balles utilisées, balles restantes.</div>
                        <field name="colis_line_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="colis_id" string="Lot (colis)"/>
                                <field name="balles" string="Balles utilisées" sum="Total"/>
                                <field name="balles_restantes" string="Balles restantes"/>
                            </list>
                        </field>
                    </page>
                    <page string="Contrôles qualité" name="controles">
                        <field name="qc_ids" nolabel="1" readonly="1">
                            <list><field name="name"/><field name="p0"/><field name="pri"/><field name="resultat" widget="badge" decoration-success="resultat == 'conforme'" decoration-danger="resultat == 'non_conforme'"/><field name="state" widget="badge"/></list>
                        </field>
                    </page>
                    <page string="Notes" name="notes">
                        <field name="notes" nolabel="1"/>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_panier_tree" model="ir.ui.view">
    <field name="name">ka.panier.ka.tree</field>
    <field name="model">ka.panier</field>
    <field name="arch" type="xml"><list string="ka_panier"><field name="chrono"/><field name="name"/><field name="of_id"/><field name="date_production"/><field name="sechoir_id"/><field name="nb_balles" sum="Balles"/><field name="balles_restantes"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_panier" model="ir.actions.act_window"><field name="name">Déclaration des paniers</field><field name="res_model">ka.panier</field><field name="view_mode">list,form</field></record>
</odoo>
