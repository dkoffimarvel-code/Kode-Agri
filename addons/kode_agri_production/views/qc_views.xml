<record id="action_ka_qc_panier" model="ir.actions.act_window"><field name="name">Contrôles panier</field><field name="res_model">ka.qc.panier</field><field name="view_mode">list,form</field></record>
<record id="action_ka_qc_liberation" model="ir.actions.act_window"><field name="name">Libération conteneur</field><field name="res_model">ka.qc.liberation</field><field name="view_mode">list,form</field></record>
</odoo>
