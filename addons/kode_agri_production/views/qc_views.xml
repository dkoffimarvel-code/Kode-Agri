<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_qc_reception_form" model="ir.ui.view">
    <field name="name">ka.qc.reception.ka.form</field>
    <field name="model">ka.qc.reception</field>
    <field name="arch" type="xml">
        <form string="Contrôle réception — contaminants" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Qualité</span><span class="o_ka_c">Contrôles</span><span class="o_ka_cur">Contrôle à la réception</span><span class="o_ka_fn">Fonction : YQCREC · fiche technique FDT-REC</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Contrôle réception — contaminants</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-info="state in ('brouillon')" decoration-success="state in ('valide')"/>
                        </div>
                        <div class="o_ka_info">Contrôle créé automatiquement sur chaque ticket de pesée ; non bloquant : la réception et l'entrée en stock du lot ne sont pas interrompues. Types de contaminants paramétrables.</div><div class="o_ka_sec">Pesée</div><div class="o_ka_grid"><div class="o_ka_f"><label for="partner_id" string="Fournisseur"/><field name="partner_id" readonly="1"/></div><div class="o_ka_f"><label for="date_reception" string="Date de réception"/><field name="date_reception" readonly="1"/></div><div class="o_ka_f"><label for="ticket_name" string="N° ticket"/><field name="ticket_name" readonly="1"/></div><div class="o_ka_f"><label for="transport" string="Transport"/><field name="transport" readonly="1"/></div><div class="o_ka_f"><label for="poids1" string="Poids 1"/><field name="poids1" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="poids2" string="Poids 2"/><field name="poids2" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="poids_net" string="Poids net humide"/><field name="poids_net" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div></div><div class="o_ka_h3">Poids des contaminants</div><field name="line_ids" nolabel="1"><list editable="bottom"><field name="type_id" string="Type de contaminant"/><field name="poids" string="Poids" sum="Total contaminants"/></list></field><div class="o_ka_grid"><div class="o_ka_f"><label for="taux" string="Taux de contaminants"/><field name="taux" readonly="1" class="o_ka_u_pct"/></div><div class="o_ka_f"><label for="controleur_id" string="Contrôleur"/><field name="controleur_id"/></div><div class="o_ka_f"><label for="date_heure" string="Date et heure"/><field name="date_heure"/></div></div>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider le contrôle" name="action_valider" type="object" class="o_ka_btn o_ka_primary"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_drc_essai_form" model="ir.ui.view">
    <field name="name">ka.drc.essai.ka.form</field>
    <field name="model">ka.drc.essai</field>
    <field name="arch" type="xml">
        <form string="Essai DRC — lot de fond de tasse" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Qualité</span><span class="o_ka_c">Analyses</span><span class="o_ka_cur">Essais DRC</span><span class="o_ka_fn">Fonction : YDRC · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Essai DRC — lot de fond de tasse</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-success="state in ('conforme')" decoration-warning="state in ('ecart')"/>
                        </div>
                        <div class="o_ka_info">Le DRC est mesuré sur le lot, non sur une réception isolée ; plusieurs essais par lot sont possibles. Le résultat peut mettre à jour le titre (DRC) du lot en gestion du titre.</div><div class="o_ka_sec">Lot</div><div class="o_ka_grid"><div class="o_ka_f"><label for="lot_id" string="Lot" class="o_ka_req"/><field name="lot_id"/></div><div class="o_ka_f"><label for="poids_lot" string="Poids du lot à date"/><field name="poids_lot" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="statut_lot" string="Statut du lot"/><field name="statut_lot" readonly="1"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div></div><div class="o_ka_sec">Échantillon</div><div class="o_ka_grid"><div class="o_ka_f"><label for="date" string="Date de l'essai"/><field name="date"/></div><div class="o_ka_f"><label for="methode" string="Méthode"/><field name="methode"/></div><div class="o_ka_f"><label for="laborantin_id" string="Laborantin"/><field name="laborantin_id"/></div><div class="o_ka_f"><label for="echantillon_g" string="Échantillon prélevé"/><field name="echantillon_g" class="o_ka_u_g"/></div><div class="o_ka_f"><label for="poids_sec_g" string="Poids sec après séchage"/><field name="poids_sec_g" class="o_ka_u_g"/></div></div><div class="o_ka_sec">Résultat</div><div class="o_ka_grid"><div class="o_ka_f"><label for="drc" string="DRC mesuré"/><field name="drc" readonly="1" class="o_ka_u_pct"/></div><div class="o_ka_f"><label for="drc_ref" string="DRC de référence"/><field name="drc_ref" readonly="1" class="o_ka_u_pct"/></div><div class="o_ka_f"><label for="ecart" string="Écart"/><field name="ecart" readonly="1" class="o_ka_u_pt"/></div><div class="o_ka_f"><label for="drc_lot" string="Titre du lot après mise à jour"/><field name="drc_lot" readonly="1" class="o_ka_u_pct"/></div></div>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer l'essai" name="action_enregistrer" type="object" class="o_ka_btn o_ka_primary"/><button string="Mettre à jour le titre du lot" name="action_maj_titre" type="object" class="o_ka_btn"/><button string="Historique des essais" name="action_historique" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_qc_granul_form" model="ir.ui.view">
    <field name="name">ka.qc.granul.ka.form</field>
    <field name="model">ka.qc.granul</field>
    <field name="arch" type="xml">
        <form string="Contrôle granulation — test de granulés" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Qualité</span><span class="o_ka_c">Contrôles</span><span class="o_ka_cur">Contrôles en production</span><span class="o_ka_fn">Fonction : YQCPRD · fiche technique GRANUL</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Contrôle granulation — test de granulés</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="resultat" widget="badge" decoration-success="resultat in ('conforme')" decoration-danger="resultat in ('non_conforme')"/>
                        </div>
                        <div class="o_ka_info">Le test de granulés vérifie la granulométrie avant le séchage ; un résultat non conforme ne bloque pas le passage au séchoir.</div><div class="o_ka_sec">Granulation</div><div class="o_ka_grid"><div class="o_ka_f"><label for="centre" string="Centre de charge"/><field name="centre" readonly="1"/></div><div class="o_ka_f"><label for="poste_id" string="Poste de charge"/><field name="poste_id"/></div><div class="o_ka_f"><label for="of_id" string="OF"/><field name="of_id"/></div><div class="o_ka_f"><label for="date_heure" string="Date et heure"/><field name="date_heure"/></div></div><div class="o_ka_sec">Résultat</div><div class="o_ka_grid"><div class="o_ka_f"><label for="granulo_cible" string="Granulométrie cible"/><field name="granulo_cible" readonly="1"/></div><div class="o_ka_f"><label for="granulo_mesuree" string="Granulométrie mesurée"/><field name="granulo_mesuree"/></div><div class="o_ka_f"><label for="homogeneite" string="Homogénéité"/><field name="homogeneite"/></div><div class="o_ka_f"><label for="corps_etrangers" string="Corps étrangers"/><field name="corps_etrangers"/></div><div class="o_ka_f"><label for="resultat" string="Résultat"/><field name="resultat" readonly="1" widget="badge" decoration-success="resultat=='conforme'" decoration-danger="resultat=='non_conforme'"/></div><div class="o_ka_f"><label for="controleur_id" string="Contrôleur"/><field name="controleur_id"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div></div>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider le contrôle" name="action_valider" type="object" class="o_ka_btn o_ka_primary"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_qc_panier_form" model="ir.ui.view">
    <field name="name">ka.qc.panier.ka.form</field>
    <field name="model">ka.qc.panier</field>
    <field name="arch" type="xml">
        <form string="Contrôle panier — P0 / PRI" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Qualité</span><span class="o_ka_c">Contrôles</span><span class="o_ka_cur">Contrôles en production</span><span class="o_ka_fn">Fonction : YQCPRD · fiche technique PANIER</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Contrôle panier — P0 / PRI</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-info="state in ('brouillon')" decoration-success="state in ('valide')"/>
                        </div>
                        <div class="o_ka_info">Seules les valeurs P0 et PRI sont saisies. La validation est sans impact sur les stocks (RG-4.5) ; la production est notifiée par une règle de workflow.</div><div class="o_ka_sec">Panier</div><div class="o_ka_grid"><div class="o_ka_f"><label for="panier_id" string="Panier"/><field name="panier_id" readonly="1"/></div><div class="o_ka_f"><label for="sechoir_id" string="Séchoir"/><field name="sechoir_id" readonly="1"/></div><div class="o_ka_f"><label for="heure" string="Heure de prélèvement"/><field name="heure" widget="float_time"/></div><div class="o_ka_f"><label for="laborantin_id" string="Laborantin"/><field name="laborantin_id"/></div></div><div class="o_ka_sec">Mesures laboratoire</div><div class="o_ka_grid"><div class="o_ka_f"><label for="p0" string="P0 mesuré" class="o_ka_req"/><field name="p0"/></div><div class="o_ka_f"><label for="pri" string="PRI mesuré" class="o_ka_req"/><field name="pri"/></div><div class="o_ka_f"><label for="grade_vise" string="Grade visé (OF)"/><field name="grade_vise" readonly="1"/></div><div class="o_ka_f"><label for="resultat" string="Résultat"/><field name="resultat" readonly="1" widget="badge" decoration-success="resultat=='conforme'" decoration-danger="resultat=='non_conforme'" decoration-warning="resultat=='a_saisir'"/></div></div>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider le contrôle" name="action_valider" type="object" class="o_ka_btn o_ka_primary"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_qc_liberation_form" model="ir.ui.view">
    <field name="name">ka.qc.liberation.ka.form</field>
    <field name="model">ka.qc.liberation</field>
    <field name="arch" type="xml">
        <form string="Contrôle à libération — équivalent conteneur" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Qualité</span><span class="o_ka_c">Contrôles</span><span class="o_ka_cur">Libération conteneur</span><span class="o_ka_fn">Fonction : YQCLIB · spécifique</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Contrôle à libération — équivalent conteneur</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="badge_label" widget="badge" decoration-danger="nb_bloques &gt; 0" decoration-success="nb_bloques == 0"/>
                        </div>
                        <div class="o_ka_info">La libération fait passer les colis du statut Q au statut A. Validation colis par colis, ou globale si tous sont conformes ; un colis bloqué est remplacé par l'agent d'expédition puis recontrôlé.</div><field name="line_ids" nolabel="1"><list editable="bottom"><field name="a_valider" string=" "/><field name="lot_id" string="Lot (colis)"/><field name="statut" string="Statut"/><field name="p0" string="P0"/><field name="pri" string="PRI"/><field name="ml" string="ML"/><field name="imp" string="Impuretés"/><field name="azote" string="Azote"/><field name="cendres" string="Cendres"/><field name="vm" string="Mat. vol."/><field name="resultat" string="Résultat" widget="badge" decoration-success="resultat=='libere'" decoration-danger="resultat=='bloque'" decoration-warning="resultat=='a_controler'"/></list></field><p class="o_ka_note">Les colis conformes et libérés restent consultables ; la validation globale du conteneur n'est possible que lorsque tous les colis sont au statut A.</p>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Valider les colis sélectionnés" name="action_valider_selection" type="object" class="o_ka_btn"/><button string="Valider le conteneur" name="action_valider_conteneur" type="object" class="o_ka_btn o_ka_primary"/><button string="Imprimer le bon de libération" name="action_bon" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
