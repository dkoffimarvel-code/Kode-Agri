<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 4.8 — Contrôle à la réception de fond de tasse [Saisie] -->
<record id="view_ka_qc_reception_form" model="ir.ui.view">
    <field name="name">ka.qc.reception.ka.form</field>
    <field name="model">ka.qc.reception</field>
    <field name="arch" type="xml">
        <form string="Contrôle réception — poids des contaminants" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Valider le contrôle" name="action_valider" type="object" class="btn-secondary" invisible="state == 'valide'"/>
            </header>
            <sheet>
                <field name="state" invisible="1"/>
                <div class="text-end"><span class="o_ka_tag o_ka_grey">Généré automatiquement · non bloquant</span></div>
                <div class="oe_title">
                    <div class="o_ka_hint">Contrôle réception — poids des contaminants</div>
                    <h1><field name="ticket_name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Ce contrôle est <b>généré automatiquement sur chaque ticket de pesée</b>. Il permet de saisir le poids des contaminants présents dans la livraison (fibre polypropylène, sable, caillou, bois, feuille…). La <b>liste des types de contaminants est paramétrable</b>. Ce contrôle <b>n'est pas bloquant</b>.</div>
                <group string="Pesée">
                    <group>
                        <field name="partner_id" string="Fournisseur / Planteur" readonly="1"/>
                        <field name="ticket_id" string="N° ticket de pesée" required="1" readonly="id"/>
                        <field name="poids1" string="Poids 1" readonly="1" class="o_ka_u_kg"/>
                        <field name="poids_net" string="Poids net" readonly="1" class="o_ka_u_kg"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="date_reception" string="Date de réception" readonly="1"/>
                        <field name="transport" string="Transport" readonly="1"/>
                        <field name="poids2" string="Poids 2" readonly="1" class="o_ka_u_kg"/>
                        <field name="date_heure" string="Date / heure de contrôle"/>
                    </group>
                </group>
                <div class="o_ka_h3">Poids des contaminants <span class="o_ka_hint">types paramétrables — Qualité › Points de contrôle › Types de contaminants</span></div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="type_id" string="Type de contaminant"/>
                        <field name="poids" string="Poids" sum="Total contaminants" class="o_ka_u_kg"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="taux" string="Taux de contaminants (/ poids net)" readonly="1" class="o_ka_u_pct"/>
                    </group>
                    <group>
                        <field name="controleur_id" string="Contrôleur"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Les poids saisis alimentent le suivi qualité fournisseur et le calcul du taux de contaminants par planteur. Cette saisie n'interrompt pas la réception ni l'entrée en stock du fond de tasse. La fiche de contrôle hérite le statut de traçabilité du fournisseur associé à la réception.</div>
            </sheet>
        </form>
    </field>
</record>

<!-- Écran 4.9 — Essai DRC à la réception [Saisie] -->
<record id="view_ka_drc_essai_form" model="ir.ui.view">
    <field name="name">ka.drc.essai.ka.form</field>
    <field name="model">ka.drc.essai</field>
    <field name="arch" type="xml">
        <form string="Essai DRC — lot de fond de tasse" class="o_ka_form">
            <header>
                <button string="Enregistrer l'essai" name="action_enregistrer" type="object" class="btn-primary"/>
                <button string="Mettre à jour le titre du lot" name="action_maj_titre" type="object" class="btn-secondary" invisible="state == 'brouillon'"/>
                <button string="Historique des essais" name="action_historique" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                <div class="text-end"><span class="o_ka_tag o_ka_grey">Non bloquant</span></div>
                <div class="oe_title">
                    <div class="o_ka_hint">Essai DRC — lot de fond de tasse</div>
                    <div class="o_ka_title_tag">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="rang_label" widget="badge" decoration-muted="1"/>
                    </div>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Le DRC est mesuré sur le <b>lot de fond de tasse</b>, et non sur une réception isolée : <b>plusieurs essais peuvent être réalisés sur un même lot</b>. Ce contrôle <b>n'est pas bloquant</b> ; il fournit une estimation utilisée pour dimensionner la transformation.</div>
                <group string="Lot de fond de tasse">
                    <group>
                        <field name="lot_id" string="N° de lot de fond de tasse" required="1"/>
                        <field name="statut_lot" string="Statut du lot" widget="badge" decoration-info="1"/>
                    </group>
                    <group>
                        <field name="poids_lot" string="Poids du lot (à date)" class="o_ka_u_kg"/>
                        <field name="rang" string="N° essai sur ce lot"/>
                    </group>
                </group>
                <group string="Échantillon">
                    <group>
                        <field name="date" string="Date de l'essai"/>
                        <field name="laborantin_id" string="Laborantin"/>
                        <field name="poids_sec_g" string="Poids sec après séchage" class="o_ka_u_g"/>
                    </group>
                    <group>
                        <field name="methode" string="Méthode"/>
                        <field name="echantillon_g" string="Échantillon prélevé" class="o_ka_u_g"/>
                    </group>
                </group>
                <group string="Résultat">
                    <group>
                        <field name="drc" string="DRC mesuré" class="o_ka_u_pct"/>
                        <field name="ecart" string="Écart" class="o_ka_u_pt o_ka_ko_txt" invisible="ecart &gt;= 0"/>
                        <field name="ecart" string="Écart" class="o_ka_u_pt" invisible="ecart &lt; 0"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="drc_ref" string="DRC de référence (paramétrable)" class="o_ka_u_pct"/>
                        <field name="state" string="Statut" widget="badge" decoration-success="state == 'conforme'" decoration-warning="state == 'ecart'" decoration-muted="state == 'brouillon'"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Le DRC mesuré alimente l'estimation de la quantité de TSR à produire (RG-4.8) pour les OF de production rattachés à ce lot de fond de tasse. Cette saisie n'est pas bloquante. La fiche d'essai DRC hérite le statut de traçabilité du lot de fond de tasse auquel elle est rattachée.</div>
            </sheet>
        </form>
    </field>
</record>

<!-- Écran 4.10 — Test de granulés [Saisie] -->
<record id="view_ka_qc_granul_form" model="ir.ui.view">
    <field name="name">ka.qc.granul.ka.form</field>
    <field name="model">ka.qc.granul</field>
    <field name="arch" type="xml">
        <form string="Test de granulés — granulation" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Valider le contrôle" name="action_valider" type="object" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="a_controler,conforme"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="o_ka_hint">Test de granulés — granulation</div>
                    <h1><field name="ka_ref"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Le test de granulés vérifie la <b>conformité de la granulométrie</b> avant l'étape de séchage.</div>
                <group string="Granulation">
                    <group>
                        <field name="centre" string="Centre de charge" readonly="1"/>
                        <field name="of_id" string="N° OF de production" required="1"/>
                    </group>
                    <group>
                        <field name="poste_id" string="Poste de charge"/>
                        <field name="date_heure" string="Date / heure"/>
                    </group>
                </group>
                <group string="Résultat">
                    <group>
                        <field name="granulo_cible" string="Granulométrie cible" readonly="1"/>
                        <field name="homogeneite" string="Homogénéité"/>
                        <field name="resultat" string="Résultat" widget="badge" decoration-success="resultat == 'conforme'" decoration-danger="resultat == 'non_conforme'"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="granulo_mesuree" string="Granulométrie mesurée"/>
                        <field name="corps_etrangers" string="Corps étrangers détectés"/>
                        <field name="controleur_id" string="Contrôleur"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Résultat transmis au poste de séchage. Un lot non conforme bloque le passage au séchoir jusqu'à correction du réglage du shredder. La fiche de contrôle hérite le statut de traçabilité de l'OF de production auquel elle est rattachée.</div>
            </sheet>
        </form>
    </field>
</record>

<!-- Écran 4.12 — Contrôle panier, P0/PRI [Saisie] -->
<record id="view_ka_qc_panier_form" model="ir.ui.view">
    <field name="name">ka.qc.panier.ka.form</field>
    <field name="model">ka.qc.panier</field>
    <field name="arch" type="xml">
        <form string="Contrôle panier — P0 / PRI" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Valider le contrôle" name="action_valider" type="object" class="btn-secondary" invisible="state == 'valide'"/>
            </header>
            <sheet>
                <field name="state" invisible="1"/>
                <div class="text-end"><span class="o_ka_tag o_ka_grey">Sans impact sur les stocks</span></div>
                <div class="oe_title">
                    <div class="o_ka_hint">Contrôle panier — P0 / PRI</div>
                    <h1><field name="chrono"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Le contrôle panier ne comporte qu'une seule saisie : les valeurs <b>P0 et PRI</b>, mesurées par le <b>laboratoire</b> sur l'échantillon du panier (§ 4.2.5). Conformément à la RG-4.5, la validation de ce contrôle est <b>sans impact sur les stocks</b>.</div>
                <group string="Panier">
                    <group>
                        <field name="sechoir_id" string="N° séchoir"/>
                        <field name="of_id" string="OF de production"/>
                        <field name="panier_id" string="Panier" required="1" readonly="id"/>
                    </group>
                    <group>
                        <field name="heure" string="Heure de prélèvement" widget="float_time"/>
                        <field name="laborantin_id" string="Laborantin"/>
                    </group>
                </group>
                <div class="o_ka_h3">Mesures laboratoire <span class="o_ka_hint">seules saisies du contrôle</span></div>
                <group>
                    <group>
                        <field name="p0" string="P0 mesuré" required="1"/>
                        <field name="grade_vise" string="Grade visé (OF)" widget="badge" decoration-info="1"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="pri" string="PRI mesuré" required="1"/>
                        <field name="resultat" string="Résultat" widget="badge" decoration-success="resultat == 'conforme'" decoration-danger="resultat == 'non_conforme'" decoration-warning="resultat == 'a_saisir'"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Les résultats sont transmis à la production par notification (pile) pour ajustement éventuel de la conduite des séchoirs. Cette saisie est sans impact sur les stocks (RG-4.5). La fiche de contrôle panier hérite le statut de traçabilité de la déclaration panier.</div>
            </sheet>
        </form>
    </field>
</record>

<!-- Écran 4.7a — Contrôle à libération, colis de l'équivalent conteneur [Approbation] -->
<record id="view_ka_qc_liberation_form" model="ir.ui.view">
    <field name="name">ka.qc.liberation.ka.form</field>
    <field name="model">ka.qc.liberation</field>
    <field name="arch" type="xml">
        <form string="Contrôle à libération — équivalent conteneur" class="o_ka_form">
            <header>
                <button string="Valider tous les colis (contrôle global)" name="action_valider_conteneur" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <button string="Imprimer le bon de libération conteneur" name="action_bon" type="object" class="btn-secondary"/>
                <button string="Valider les colis sélectionnés" name="action_valider_selection" type="object" class="btn-secondary" invisible="state != 'en_cours'"/>
                <field name="state" widget="statusbar" statusbar_visible="en_cours,libere,expediable"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="o_ka_hint">Contrôle à libération — équivalent conteneur</div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="controleur_id" string="Contrôleur"/>
                    </group>
                </group>
                <div class="o_ka_info">Le contrôle porte sur les <b><field name="nb_label" class="d-inline"/> colis de l'équivalent conteneur</b>. Il peut être réalisé <b>colis par colis</b>, ou de façon <b>globale sur l'ensemble des colis si tous sont conformes</b>. Un colis bloqué peut être <b>remplacé par l'agent d'expédition</b> sur l'équivalent conteneur, puis renvoyé au contrôle qualité pour vérification.</div>
                <div class="o_ka_h3">Colis de l'équivalent conteneur (<field name="nb_label" class="d-inline"/>) <span class="o_ka_hint">validation colis par colis, ou globale si tous conformes</span></div>
                <field name="line_ids" nolabel="1" context="{'list_view_ref': 'kode_agri_production.view_ka_qc_liberation_line_tree'}"/>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span><field name="ka_valid_txt"/></div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_qc_liberation_line_tree" model="ir.ui.view">
    <field name="name">ka.qc.liberation.line.ka.tree</field>
    <field name="model">ka.qc.liberation.line</field>
    <field name="arch" type="xml">
        <list editable="bottom" decoration-danger="resultat == 'bloque'">
            <field name="a_valider" string="Sélection" optional="hide"/>
            <field name="lot_id" string="N° série colis"/>
            <field name="statut" string="Statut colis" widget="badge" decoration-danger="resultat == 'bloque'" decoration-muted="resultat != 'bloque'"/>
            <field name="poids" string="Poids" class="o_ka_u_kg"/>
            <field name="p0" string="P0"/>
            <field name="pri" string="PRI"/>
            <field name="ml" string="ML"/>
            <field name="imp" string="Impuretés" class="o_ka_u_pct"/>
            <field name="azote" string="Azote" class="o_ka_u_pct"/>
            <field name="cendres" string="Cendres" class="o_ka_u_pct"/>
            <field name="vm" string="Mat. vol." class="o_ka_u_pct"/>
            <field name="resultat" string="Conforme"/>
            <button string="Valider →" name="action_valider_ligne" type="object" class="btn-link" invisible="resultat != 'a_controler'"/>
            <button string="Remplacer" name="action_remplacer" type="object" class="btn-link text-danger" invisible="resultat != 'bloque'"/>
        </list>
    </field>
</record>
<record id="view_ka_qc_liberation_line_form" model="ir.ui.view">
    <field name="name">ka.qc.liberation.line.ka.form</field>
    <field name="model">ka.qc.liberation.line</field>
    <field name="arch" type="xml">
        <form string="Remplacer le colis" class="o_ka_form">
            <sheet>
                <div class="o_ka_info">Saisissez le colis de remplacement fourni par l'agent d'expédition : il repasse au statut « À contrôler ».</div>
                <group>
                    <group>
                        <field name="lot_id" string="N° série colis"/>
                        <field name="statut" string="Statut colis"/>
                    </group>
                    <group>
                        <field name="resultat" string="Conforme" readonly="1" force_save="1"/>
                        <field name="poids" string="Poids" class="o_ka_u_kg"/>
                    </group>
                </group>
            </sheet>
            <footer>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Annuler" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

