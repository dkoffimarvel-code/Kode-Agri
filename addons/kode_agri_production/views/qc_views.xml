</record>
<record id="action_ka_qc_reception" model="ir.actions.act_window"><field name="name">Contrôle à la réception</field><field name="res_model">ka.qc.reception</field><field name="view_mode">list,form</field></record>
<record id="action_ka_drc_essai" model="ir.actions.act_window"><field name="name">Essais DRC</field><field name="res_model">ka.drc.essai</field><field name="view_mode">list,form</field></record>
