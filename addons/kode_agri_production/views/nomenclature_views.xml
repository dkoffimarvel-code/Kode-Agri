<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 4.1bis — Nomenclature article TSR, gamme et postes de charge [Paramétrage] -->
<record id="view_ka_bom_form" model="ir.ui.view">
    <field name="name">mrp.bom.ka.form</field>
    <field name="model">mrp.bom</field>
    <field name="arch" type="xml">
        <form string="Nomenclature de fabrication" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Copier la nomenclature" name="action_copier" type="object" class="btn-secondary"/>
                <button string="Calculer le coût standard" name="action_cout_standard" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="o_ka_hint">Nomenclature de fabrication</div>
                    <h1><field name="product_tmpl_id" placeholder="Article composé" options="{'no_open': True}"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">La nomenclature fixe la <b>composition standard</b> de l'article TSR et sa <b>gamme opératoire</b> associée. Le n° d'opération de la gamme est relié à la nomenclature pour <b>déclencher la consommation en poste déduction</b>, et alimente le calcul du coût standard.</div>
                <group string="Nomenclature">
                    <group>
                        <field name="product_tmpl_id" string="Article" required="1"/>
                        <field name="product_qty" string="Quantité produite" class="o_ka_u_kg"/>
                    </group>
                    <group>
                        <field name="type" string="Type de nomenclature"/>
                        <field name="ka_gamme" string="Gamme associée" widget="badge" decoration-info="1"/>
                    </group>
                </group>
                <field name="bom_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="product_id" string="Composant"/>
                        <field name="product_qty" string="Quantité"/>
                        <field name="product_uom_id" string="Unité"/>
                        <field name="operation_id" string="Opération" optional="hide"/>
                    </list>
                </field>
                <div class="o_ka_h3">Gamme opératoire — <field name="ka_gamme" readonly="1" class="d-inline"/> <span class="o_ka_hint">enchaînement des opérations sur les postes de charge</span></div>
                <field name="operation_ids" nolabel="1">
                    <list>
                        <field name="sequence" column_invisible="1"/>
                        <field name="ka_num_op" string="N° opér."/>
                        <field name="ka_type_poste" string="Type"/>
                        <field name="ka_code_poste" string="N°"/>
                        <field name="name" string="Libellé opération"/>
                        <field name="ka_centre" string="Centre de charge"/>
                        <field name="ka_temps_h" string="Temps d'exécution" class="o_ka_u_h"/>
                        <field name="ka_cadence" string="Cadence heure"/>
                        <field name="workcenter_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Le <b>temps d'exécution</b> de chaque opération, combiné au <b>coût du poste ou centre de charge</b> (coût unitaire direct, % coût indirect, frais généraux), permet à Odoo de calculer le <b>coût standard opératoire</b> de l'OF et de <b>planifier la production</b> selon la capacité disponible.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="action_ka_bom" model="ir.actions.act_window"><field name="name">Nomenclatures</field><field name="res_model">mrp.bom</field><field name="view_mode">list,form</field></record><record id="action_ka_bom_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_bom"/><field name="sequence">1</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_bom_form"/></record>

<!-- Entrées « Produits · Gammes · Postes de charge » de l'application Fabrication -->
<record id="action_ka_produits" model="ir.actions.act_window"><field name="name">Produits</field><field name="res_model">product.template</field><field name="view_mode">list,form</field></record>
<record id="view_ka_gamme_tree" model="ir.ui.view">
    <field name="name">mrp.routing.workcenter.ka.tree</field>
    <field name="model">mrp.routing.workcenter</field>
    <field name="priority">99</field>
    <field name="arch" type="xml"><list string="Gammes"><field name="bom_id" string="Nomenclature"/><field name="ka_num_op"/><field name="ka_type_poste"/><field name="ka_code_poste" string="N°"/><field name="name" string="Libellé opération"/><field name="ka_centre"/><field name="ka_temps_h" string="Temps d'exécution"/><field name="ka_cadence" string="Cadence heure"/></list></field>
</record>
<record id="action_ka_gammes" model="ir.actions.act_window"><field name="name">Gammes</field><field name="res_model">mrp.routing.workcenter</field><field name="view_mode">list,form</field><field name="view_id" ref="view_ka_gamme_tree"/></record>
<record id="view_ka_poste_tree" model="ir.ui.view">
    <field name="name">mrp.workcenter.ka.tree</field>
    <field name="model">mrp.workcenter</field>
    <field name="priority">99</field>
    <field name="arch" type="xml"><list string="Postes de charge"><field name="code" string="N°"/><field name="name" string="Poste de charge"/><field name="ka_type_poste"/><field name="ka_centre"/><field name="costs_hour" string="Coût horaire"/></list></field>
</record>
<record id="action_ka_postes" model="ir.actions.act_window"><field name="name">Postes de charge</field><field name="res_model">mrp.workcenter</field><field name="view_mode">list,form</field><field name="view_id" ref="view_ka_poste_tree"/></record>
</odoo>
