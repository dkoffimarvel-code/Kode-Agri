<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_of_melange_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="Ordre de fabrication — mélange" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Production</span><span class="o_ka_c">Planification</span><span class="o_ka_cur">Ordres de fabrication</span><span class="o_ka_fn">Fonction : GESMFG</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Ordre de fabrication — mélange</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="badge_label" widget="badge" decoration-info="state in ('planifie','lance','en_essai')" decoration-success="state in ('produit','specifie','solde')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills" statusbar_visible="planifie,lance,solde"/><div class="o_ka_kpis"><div class="o_ka_kpi"><field name="nb_lots" nolabel="1"/><span class="o_ka_kl">Lots FDT</span></div><div class="o_ka_kpi"><field name="drc_reel" nolabel="1"/><span class="o_ka_kl">DRC réel moyen</span></div><div class="o_ka_kpi"><field name="cout_matiere" nolabel="1"/><span class="o_ka_kl">Coût matière</span></div></div><div class="o_ka_info">Consommation manuelle ou automatique sur DRC réel moyen (paramètre). En manuel, le mélange et les OF liés sont valorisés à la consommation.</div><div class="o_ka_sec">En-tête</div><div class="o_ka_grid"><div class="o_ka_f"><label for="warehouse_id" string="Site" class="o_ka_req"/><field name="warehouse_id"/></div><div class="o_ka_f"><label for="product_id" string="Article lancé" class="o_ka_req"/><field name="product_id"/></div><div class="o_ka_f"><label for="qty" string="Quantité lancée"/><field name="qty" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="date_lancement" string="Date de lancement"/><field name="date_lancement"/></div><div class="o_ka_f"><label for="mode_conso" string="Mode de consommation" class="o_ka_req"/><field name="mode_conso"/></div><div class="o_ka_f"><label for="atelier" string="Atelier"/><field name="atelier"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div><div class="o_ka_f"><label for="drc_reel" string="DRC réel moyen"/><field name="drc_reel" readonly="1" class="o_ka_u_pct"/></div></div><div class="o_ka_h3">Matières — lots de fond de tasse alloués</div><field name="lot_ids" nolabel="1"><list editable="bottom"><field name="lot_id" string="Lot"/><field name="partner_id" string="Fournisseur d'origine"/><field name="godets" string="Godets"/><field name="qty" string="Quantité (kg)"/><field name="drc" string="Titre (DRC)"/><field name="cout_kg" column_invisible="1"/><field name="valorisation" string="Valorisation (FCFA)" sum="Coût matière consommée"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Allocation détaillée des lots" name="action_allocation" type="object" class="o_ka_btn"/><button string="Consommer le fond de tasse" name="action_consommer_fdt" type="object" class="o_ka_btn o_ka_primary"/><button string="Solder l'OF" name="action_solder" type="object" class="o_ka_btn"/><div class="o_ka_side_t">Liens</div><button string="Traçabilité amont / aval" name="action_tracabilite" type="object" class="o_ka_link"/><button string="Essais DRC des lots" name="action_essais_drc" type="object" class="o_ka_link"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_of_production_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="Ordre de fabrication — production TSR" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Production</span><span class="o_ka_c">Planification</span><span class="o_ka_cur">Ordres de fabrication</span><span class="o_ka_fn">Fonction : GESMFG</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Ordre de fabrication — production TSR</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="badge_label" widget="badge" decoration-info="state in ('planifie','lance','en_essai')" decoration-success="state in ('produit','specifie','solde')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills" statusbar_visible="planifie,lance,produit,specifie,solde"/><div class="o_ka_info">Étape 1 — création de l'OF : article TSR, grade visé (objectif, le laboratoire décide) et mélange affecté. Le TSR à produire est estimé avec un DRC de référence de 60 %.</div><div class="o_ka_sec">Article lancé</div><div class="o_ka_grid"><div class="o_ka_f"><label for="product_id" string="Article" class="o_ka_req"/><field name="product_id"/></div><div class="o_ka_f"><label for="grade_vise" string="Grade visé"/><field name="grade_vise"/></div><div class="o_ka_f"><label for="poids_colis" string="Poids net d'un colis" class="o_ka_req"/><field name="poids_colis" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="composition" string="Composition"/><field name="composition" readonly="1"/></div><div class="o_ka_f"><label for="qty_humide" string="Quantité humide affectée"/><field name="qty_humide" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="tsr_estime" string="TSR estimé (DRC 60 %)"/><field name="tsr_estime" readonly="1" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="nb_colis_estime" string="Nombre de colis estimé"/><field name="nb_colis_estime" readonly="1"/></div><div class="o_ka_f"><label for="date_prevue" string="Date prévue"/><field name="date_prevue"/></div><div class="o_ka_f"><label for="bains_par_panier" string="Bains par panier"/><field name="bains_par_panier"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div><div class="o_ka_f"><label for="warehouse_id" string="Site"/><field name="warehouse_id"/></div></div><notebook><page string="Mélange à consommer"><field name="melange_ids" nolabel="1"><list editable="bottom"><field name="melange_of_id" string="OF de mélange"/><field name="lot_melange" string="Lot de mélange"/><field name="qty_humide" string="Quantité humide (kg)" sum="Total"/><field name="drc_ref" string="DRC de référence"/><field name="tsr_estime" string="TSR estimé (kg)" sum="Total"/></list></field><p class="o_ka_note">L'OF hérite le statut de traçabilité (EUDR / NON EUDR) des mélanges affectés ; les colis produits l'héritent à leur tour.</p></page><page string="Composants"><div class="o_ka_info">Nomenclature TSR : 1 kg de TSR consomme 1 kg de fond de tasse actif (caoutchouc sec).</div></page><page string="Opérations"><div class="o_ka_info">Gamme GAM-TSR-01 : prélavage, zone humide, zone sèche, conditionnement.</div></page></notebook>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Lancer l'OF" name="action_lancer" type="object" class="o_ka_btn o_ka_primary" invisible="state != 'planifie'"/><button string="Déclarer les paniers" name="action_declarer_paniers" type="object" class="o_ka_btn"/><button string="Déclarer les colis" name="action_declarer_colis" type="object" class="o_ka_btn"/><button string="Solder" name="action_solder" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_of_essai_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="Ordre de fabrication — essai" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Production</span><span class="o_ka_c">Planification</span><span class="o_ka_cur">Ordres de fabrication</span><span class="o_ka_fn">Fonction : GESMFG</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Ordre de fabrication — essai</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="badge_label" widget="badge" decoration-info="state in ('planifie','lance','en_essai')" decoration-success="state in ('produit','specifie','solde')"/>
                        </div>
                        <field name="state" widget="statusbar" class="o_ka_pills" statusbar_visible="planifie,en_essai,produit,specifie,solde"/><div class="o_ka_info">Étape 1 — OF d'essai : mélange source et échantillon. Le mélange est soldé à la clôture de l'OF, sans mouvement de stock (RG-4.9).</div><div class="o_ka_sec">Essai</div><div class="o_ka_grid"><div class="o_ka_f"><label for="type" string="Type d'OF" class="o_ka_req"/><field name="type"/></div><div class="o_ka_f"><label for="product_id" string="Article" class="o_ka_req"/><field name="product_id"/></div><div class="o_ka_f"><label for="grade_vise" string="Grade visé"/><field name="grade_vise"/></div><div class="o_ka_f"><label for="melange_source_id" string="Mélange source" class="o_ka_req"/><field name="melange_source_id"/></div><div class="o_ka_f"><label for="echantillon_kg" string="Échantillon prévu"/><field name="echantillon_kg" class="o_ka_u_kg"/></div><div class="o_ka_f"><label for="atelier" string="Atelier"/><field name="atelier"/></div><div class="o_ka_f"><label for="date_prevue" string="Date prévue"/><field name="date_prevue"/></div><div class="o_ka_f"><label for="conso_matiere" string="Consommation matière"/><field name="conso_matiere" readonly="1"/></div><div class="o_ka_f"><label for="tracabilite" string="Statut de traçabilité"/><field name="tracabilite" readonly="1" widget="badge" decoration-success="tracabilite=='eudr'" decoration-danger="tracabilite=='non_eudr'"/></div><div class="o_ka_f"><label for="warehouse_id" string="Site"/><field name="warehouse_id"/></div></div><table class="o_ka_tbl"><thead><tr><th>OF de mélange</th><th>Lot de mélange</th><th>Échantillon (kg)</th><th>Consommation</th><th>Unité</th></tr></thead><tbody><tr><td><field name="melange_source_id" nolabel="1" readonly="1"/></td><td><field name="lot_melange_source" nolabel="1" readonly="1"/></td><td><field name="echantillon_kg" nolabel="1" readonly="1"/></td><td>Non — à la clôture</td><td>KG</td></tr></tbody></table>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Lancer l'essai" name="action_lancer" type="object" class="o_ka_btn o_ka_primary" invisible="state != 'planifie'"/><button string="Déclarer les paniers" name="action_declarer_paniers" type="object" class="o_ka_btn"/><button string="Déclarer les colis" name="action_declarer_colis" type="object" class="o_ka_btn"/><button string="Solder" name="action_solder" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_of_tree" model="ir.ui.view">
    <field name="name">ka.of.ka.tree</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml"><list string="ka_of"><field name="name"/><field name="type"/><field name="product_id"/><field name="qty"/><field name="date_lancement"/><field name="tracabilite" widget="badge"/><field name="badge_label" widget="badge"/></list></field>
</record>
<record id="action_ka_of_melange" model="ir.actions.act_window"><field name="name">OF de mélange</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','melange')]</field><field name="context">{'default_type': 'melange'}</field></record><record id="action_ka_of_melange_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_melange"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_melange_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_melange"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_melange_form"/></record>
<record id="action_ka_of_production" model="ir.actions.act_window"><field name="name">OF de production</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','production')]</field><field name="context">{'default_type': 'production'}</field></record><record id="action_ka_of_production_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_production"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_production_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_production"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_production_form"/></record>
<record id="action_ka_of_essai" model="ir.actions.act_window"><field name="name">OF d'essai</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','essai')]</field><field name="context">{'default_type': 'essai'}</field></record><record id="action_ka_of_essai_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_essai"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_essai_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_essai"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_essai_form"/></record>
</odoo>
