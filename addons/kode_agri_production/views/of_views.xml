<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 4.1 — OF de mélange — lancement et consommation FDT [Approbation] -->
<record id="view_ka_of_melange_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="OF de mélange" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Lancer l'OF" name="action_lancer" type="object" class="btn-primary" invisible="state != 'planifie'"/>
                <button string="Consommer FDT" name="action_consommer_fdt" type="object" class="btn-secondary" invisible="state == 'solde'"/>
                <button string="Terminer" name="action_solder" type="object" class="btn-secondary" invisible="state == 'solde'"/>
                <button string="Allocation détaillée des lots" name="action_allocation" type="object" class="btn-secondary"/>
                <button string="Traçabilité amont / aval" name="action_tracabilite" type="object" class="btn-secondary"/>
                <field name="ka_etape_melange" widget="statusbar" statusbar_visible="brouillon,lance,termine"/>
            </header>
            <sheet>
                <field name="state" invisible="1"/>
                <field name="type" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_allocation" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_lots"/></span><span class="o_stat_text">Lots FDT</span></div>
                    </button>
                    <button name="action_essais_drc" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="drc_reel_label"/></span><span class="o_stat_text">Réel moyen</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Consommation manuelle ou automatique (DRC réel moyen). En manuel, le mélange et les OF liés sont valorisés.</div>
                <group>
                    <group>
                        <field name="product_id" string="Produit (mélange)" required="1"/>
                        <field name="mode_conso" string="Mode consommation" widget="badge" invisible="state == 'planifie'"/>
                        <field name="mode_conso" string="Mode consommation" required="1" invisible="state != 'planifie'"/>
                        <field name="qty" string="Quantité visée" class="o_ka_u_kg"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="drc_reel" string="DRC réel moyen" readonly="1" class="o_ka_u_pct"/>
                        <field name="atelier" string="Atelier"/>
                        <field name="date_lancement" string="Date lancement"/>
                        <field name="warehouse_id" string="Site"/>
                    </group>
                </group>
                <div class="o_ka_h3">Lots de fond de tasse consommés</div>
                <field name="lot_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="lot_id" string="Lot FDT"/>
                        <field name="partner_id" string="Planteur d'origine"/>
                        <field name="godets" string="Part" sum="Total"/>
                        <field name="qty" string="Qté (kg)"/>
                        <field name="drc" string="DRC est." class="o_ka_u_pct"/>
                        <field name="cout_kg" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="valorisation" string="Valorisation" sum="Coût matière consommée"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Traçabilité : la généalogie relie les lots FDT consommés au mélange produit (base du calcul du DRC, lien OF essai/production).</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!-- Écran 4.2a — Création de l'OF de production — ajout du mélange à consommer [Saisie] -->
<record id="view_ka_of_production_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="OF de production" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Lancer" name="action_lancer" type="object" class="btn-secondary" invisible="state != 'planifie'"/>
                <button string="Déclarer paniers" name="action_declarer_paniers" type="object" class="btn-secondary"/>
                <button string="Déclarer colis" name="action_declarer_colis" type="object" class="btn-secondary"/>
                <button string="Clôturer" name="action_solder" type="object" class="btn-secondary" invisible="state == 'solde'"/>
                <field name="state" widget="statusbar" statusbar_visible="planifie,lance,produit,specifie"/>
            </header>
            <sheet>
                <field name="type" invisible="1"/>
                <div class="o_ka_info">Étape 1 — Création de l'OF de production. Renseignez l'article TSR à produire, le grade visé (objectif) et affectez le mélange : le système estime le TSR à produire avec un DRC de 60 %.</div>
                <div class="oe_title">
                    <div class="o_ka_hint">Référence OF</div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group string="Article produit">
                    <group>
                        <field name="product_id" string="Produit" widget="badge" invisible="state == 'planifie'"/>
                        <field name="product_id" string="Produit" required="1" invisible="state != 'planifie'"/>
                        <field name="poids_colis" string="Poids net colis" required="1" class="o_ka_u_kg"/>
                        <field name="qty_humide" string="Quantité humide (mélange)" readonly="1" class="o_ka_u_kg"/>
                        <field name="composition" string="Composition" readonly="1"/>
                        <field name="bains_par_panier" string="Bains / panier"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <label for="grade_vise" string="Grade visé"/>
                        <div class="o_row">
                            <field name="grade_vise" widget="badge" decoration-success="grade_vise in ('TSR10', 'TSR20')" decoration-danger="grade_vise == 'OFFSPECS'" invisible="state == 'planifie'"/>
                            <field name="grade_vise" invisible="state != 'planifie'"/>
                            <span class="o_ka_hint">objectif — labo décide</span>
                        </div>
                        <field name="qty_produire_label" string="Quantité à produire"/>
                        <field name="tsr_estime" string="TSR estimé (DRC 60 %)" readonly="1" class="o_ka_u_kg o_ka_ok_txt"/>
                        <field name="date_prevue" string="Date prévue"/>
                    </group>
                </group>
                <notebook>
                    <page string="Mélange à consommer" name="melange">
                        <field name="melange_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="melange_of_id" string="Mélange (OF)"/>
                                <field name="lot_melange" string="Lot mélange"/>
                                <field name="qty_humide" string="Quantité humide (kg)" sum="Total"/>
                                <field name="drc_ref" string="DRC réf." class="o_ka_u_pct"/>
                                <field name="tsr_estime" string="TSR estimé (kg)" sum="Total" decoration-success="1"/>
                                <field name="unite" string="Unité"/>
                            </list>
                        </field>
                    </page>
                    <page string="Composants" name="composants">
                        <div class="o_ka_info o_ka_noicon">Nomenclature TSR : 1 kg de TSR consomme 1 kg de fond de tasse actif (caoutchouc sec).</div>
                    </page>
                    <page string="Divers" name="divers">
                        <group>
                            <group>
                                <field name="warehouse_id" string="Site"/>
                                <field name="date_lancement" string="Date de lancement"/>
                            </group>
                            <group>
                                <field name="nb_colis_estime" string="Nombre de colis estimé"/>
                                <field name="atelier" string="Atelier"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Traçabilité : l'OF de production hérite le statut de traçabilité (EUDR / NON EUDR) du ou des mélanges affectés ; ce statut sera ensuite hérité par les colis produits.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!-- Écran 4.3a — Création de l'OF d'essai [Saisie] -->
<record id="view_ka_of_essai_form" model="ir.ui.view">
    <field name="name">ka.of.ka.form</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml">
        <form string="OF d'essai" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Lancer l'essai" name="action_lancer" type="object" class="btn-secondary" invisible="state != 'planifie'"/>
                <button string="Déclarer paniers" name="action_declarer_paniers" type="object" class="btn-secondary"/>
                <button string="Déclarer colis" name="action_declarer_colis" type="object" class="btn-secondary"/>
                <button string="Clôturer" name="action_solder" type="object" class="btn-secondary" invisible="state == 'solde'"/>
                <field name="state" widget="statusbar" statusbar_visible="planifie,en_essai,produit,specifie"/>
            </header>
            <sheet>
                <field name="type" invisible="1"/>
                <div class="o_ka_info">Étape 1 — Création de l'OF d'essai. Renseignez le mélange source et l'échantillon prélevé : le mélange sera consommé à la clôture, sans consommation matière.</div>
                <div class="oe_title">
                    <div class="o_ka_hint">Référence OF d'essai</div>
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group string="Essai">
                    <group>
                        <field name="product_id" string="Produit" widget="badge" invisible="state == 'planifie'"/>
                        <field name="product_id" string="Produit" required="1" invisible="state != 'planifie'"/>
                        <field name="melange_source_id" string="Mélange source" required="1"/>
                        <field name="echantillon_kg" string="Échantillon prévu" class="o_ka_u_kg"/>
                        <field name="conso_matiere" string="Consommation matière mélange" widget="badge" decoration-danger="1"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="grade_vise" string="Grade visé" widget="badge" decoration-success="grade_vise in ('TSR10', 'TSR20')" decoration-danger="grade_vise == 'OFFSPECS'" invisible="state == 'planifie'"/>
                        <field name="grade_vise" string="Grade visé" invisible="state != 'planifie'"/>
                        <field name="atelier" string="Atelier"/>
                        <field name="date_prevue" string="Date prévue"/>
                        <field name="melange_consomme_a" string="Mélange consommé à"/>
                    </group>
                </group>
                <notebook>
                    <page string="Mélange source" name="melange_source">
                        <table class="o_ka_tbl">
                            <thead><tr><th>Mélange (OF)</th><th>Lot mélange</th><th class="o_ka_num">Échantillon (kg)</th><th>Consommation matière</th><th>Unité</th></tr></thead>
                            <tbody><tr>
                                <td><field name="melange_source_id" nolabel="1" readonly="1"/></td>
                                <td><field name="lot_melange_source" nolabel="1" readonly="1"/></td>
                                <td class="o_ka_num"><field name="echantillon_kg" nolabel="1" readonly="1"/></td>
                                <td>Non — à la clôture</td>
                                <td>kg</td>
                            </tr></tbody>
                            <tfoot><tr><td>Total échantillon</td><td/><td class="o_ka_num"><field name="echantillon_kg" nolabel="1" readonly="1"/></td><td/><td>kg</td></tr></tfoot>
                        </table>
                    </page>
                    <page string="Composants" name="composants">
                        <div class="o_ka_info o_ka_noicon">L'OF d'essai consomme l'échantillon du mélange source « pour mémoire », sans mouvement de stock (RG-4.9).</div>
                    </page>
                    <page string="Divers" name="divers">
                        <group>
                            <group>
                                <field name="warehouse_id" string="Site"/>
                                <field name="date_lancement" string="Date de lancement"/>
                            </group>
                        </group>
                    </page>
                </notebook>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Traçabilité : l'OF d'essai hérite le statut de traçabilité (EUDR / NON EUDR) du mélange source associé.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_of_tree" model="ir.ui.view">
    <field name="name">ka.of.ka.tree</field>
    <field name="model">ka.of</field>
    <field name="arch" type="xml"><list string="ka_of"><field name="name"/><field name="type"/><field name="product_id"/><field name="qty"/><field name="date_lancement"/><field name="tracabilite" widget="badge"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_of_melange" model="ir.actions.act_window"><field name="name">OF de mélange</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','melange')]</field><field name="context">{'default_type': 'melange'}</field></record><record id="action_ka_of_melange_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_melange"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_melange_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_melange"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_melange_form"/></record>
<record id="action_ka_of_production" model="ir.actions.act_window"><field name="name">OF de production</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','production')]</field><field name="context">{'default_type': 'production'}</field></record><record id="action_ka_of_production_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_production"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_production_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_production"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_production_form"/></record>
<record id="action_ka_of_essai" model="ir.actions.act_window"><field name="name">OF d'essai</field><field name="res_model">ka.of</field><field name="view_mode">list,form</field><field name="domain">[('type','=','essai')]</field><field name="context">{'default_type': 'essai'}</field></record><record id="action_ka_of_essai_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_essai"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_of_tree"/></record><record id="action_ka_of_essai_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_of_essai"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_of_essai_form"/></record>
</odoo>
