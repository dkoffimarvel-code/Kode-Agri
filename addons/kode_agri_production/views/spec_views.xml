<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 4.5 — Spécification laboratoire — 7 spécifications, onglet Laboratoire [Approbation] -->
<record id="view_ka_spec_form" model="ir.ui.view">
    <field name="name">ka.spec.ka.form</field>
    <field name="model">ka.spec</field>
    <field name="arch" type="xml">
        <form string="Spécification laboratoire" class="o_ka_form">
            <header>
                <button string="Saisir mesures" name="action_saisir_mesures" type="object" class="btn-secondary"/>
                <button string="Valider la spécification" name="action_valider" type="object" class="btn-primary" invisible="state != 'a_specifier'"/>
                <button string="Imprimer le certificat" name="action_certificat" type="object" class="btn-secondary" invisible="state != 'specifie'"/>
                <field name="state" widget="statusbar" statusbar_visible="a_specifier,specifie"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <div class="o_ka_hint">Spécification — colis</div>
                    <h1><field name="lot_id" placeholder="Colis (n° de série)" required="1" readonly="state != 'a_specifier'" options="{'no_create': True}"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Défaut de texture prime sur les spécifications. Si déclassé texture → OFFSPECS ; bas P0 ou bas P0+PRI → OFFSPECS.</div>
                <group string="Spécifications laboratoire (7)">
                    <group>
                        <field name="r_p0" string="P0" required="1"/>
                        <field name="r_imp" string="Impuretés" class="o_ka_u_pct"/>
                        <field name="r_vm" string="Matière volatile" class="o_ka_u_pct"/>
                    </group>
                    <group>
                        <field name="r_pri" string="PRI" required="1"/>
                        <field name="r_azote" string="Azote" class="o_ka_u_pct"/>
                    </group>
                    <group>
                        <field name="r_ml" string="Viscosité Mooney (ML)"/>
                        <field name="r_cendres" string="Cendres" class="o_ka_u_pct"/>
                    </group>
                </group>
                <group string="Résultat">
                    <group>
                        <field name="texture" string="Texture" widget="badge" decoration-success="texture == 'conforme'" decoration-danger="texture != 'conforme'" invisible="state == 'a_specifier'"/>
                        <field name="texture" string="Texture" invisible="state != 'a_specifier'"/>
                        <field name="tracabilite" string="Statut traçabilité" widget="badge" readonly="1" decoration-success="tracabilite == 'eudr'" decoration-danger="tracabilite == 'non_eudr'"/>
                    </group>
                    <group>
                        <field name="statut_colis" string="Statut colis" widget="badge" decoration-muted="1"/>
                    </group>
                    <group>
                        <field name="product_id" string="Produit créé" readonly="1"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span><field name="ka_valid_txt"/></div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_spec_line_tree" model="ir.ui.view">
    <field name="name">ka.spec.line.ka.tree</field>
    <field name="model">ka.spec.line</field>
    <field name="arch" type="xml">
        <list string="Mesures laboratoire" editable="bottom" create="0" delete="0">
            <field name="test" string="Test" readonly="1"/>
            <field name="resultat" string="Résultat"/>
            <field name="unite" string="Unité"/>
            <field name="seuil" string="Seuil TSR10"/>
            <field name="conformite" string="Conformité" widget="badge" decoration-success="conformite == 'conforme'" decoration-danger="conformite == 'non_conforme'" decoration-warning="conformite == 'a_saisir'"/>
        </list>
    </field>
</record>
<record id="view_ka_spec_tree" model="ir.ui.view">
    <field name="name">ka.spec.ka.tree</field>
    <field name="model">ka.spec</field>
    <field name="arch" type="xml"><list string="ka_spec"><field name="lot_id"/><field name="grade_label"/><field name="texture"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_spec" model="ir.actions.act_window"><field name="name">Laboratoire</field><field name="res_model">ka.spec</field><field name="view_mode">list,form</field></record>
</odoo>
