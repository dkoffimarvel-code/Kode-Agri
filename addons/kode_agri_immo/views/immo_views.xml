<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 3.1 — Fiche immobilisation — création -->
<record id="view_ka_immo_form" model="ir.ui.view">
    <field name="name">ka.immo.ka.form</field>
    <field name="model">ka.immo</field>
    <field name="arch" type="xml">
        <form string="Immobilisation" class="o_ka_form">
            <header>
                <button string="Nouveau" name="action_creer" type="object" class="btn-primary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Calculer amortissement" name="action_calculer" type="object" class="btn-secondary" invisible="state not in ('creation', 'en_service')"/>
                <button string="Confirmer" name="action_confirmer" type="object" class="btn-secondary" invisible="state != 'a_confirmer'"/>
                <button string="Céder" name="action_sortie" type="object" class="btn-secondary" invisible="state != 'en_service'"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary" invisible="not id"/>
                <field name="state" widget="statusbar" statusbar_visible="creation,en_service,sortie"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_plan" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_duree"/></span><span class="o_stat_text">Durée</span></div>
                    </button>
                    <button name="action_open_ecritures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_vnc"/></span><span class="o_stat_text">Valeur nette</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="intitule" placeholder="Désignation de l'immobilisation"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="famille_id" string="Catégorie" invisible="id"/>
                        <field name="famille_id" string="Catégorie" widget="badge" invisible="not id"/>
                        <field name="valeur" string="Valeur d'acquisition" class="fw-bold"/>
                        <field name="date_service" string="Date mise en service"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="methode" string="Méthode"/>
                        <field name="duree" string="Durée d'utilité" class="o_ka_u_ans"/>
                        <field name="analytic_id" string="Compte analytique"/>
                    </group>
                </group>
                <notebook>
                    <page string="Amortissement" name="amortissement">
                        <div class="o_ka_h3">Comptes (hérités de la catégorie)</div>
                        <table class="o_ka_tbl">
                            <thead><tr><th>Type</th><th>Compte</th></tr></thead>
                            <tbody>
                                <tr><td>Immobilisation</td><td><field name="cpt_immo_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Amortissement cumulé</td><td><field name="cpt_amort_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Dotation</td><td><field name="cpt_dotation_txt" nolabel="1" readonly="1"/></td></tr>
                            </tbody>
                        </table>
                        <div class="o_ka_h3">Échéancier</div>
                        <field name="plan_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="date" string="Échéance"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="dotation" string="Dotation" sum="Total"/>
                                <field name="cumul" string="Cumul"/>
                                <field name="vnc" string="VNC"/>
                                <field name="statut" string="Statut"/>
                            </list>
                        </field>
                    </page>
                    <page string="Comptes" name="comptes">
                        <group>
                            <group>
                                <field name="name" string="Référence" readonly="1"/>
                                <field name="partner_id" string="Fournisseur"/>
                            </group>
                            <group>
                                <field name="move_id" string="Facture d'origine"/>
                                <field name="cumul" string="Amortissements cumulés"/>
                                <field name="vnc" string="Valeur nette comptable"/>
                            </group>
                        </group>
                    </page>
                    <page string="Analytique" name="analytique">
                        <group>
                            <group>
                                <field name="analytic_id" string="Compte analytique"/>
                                <field name="site_id" string="Site"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 3.1a — Création manuelle d'une immobilisation -->
<record id="view_ka_immo_manuelle_form" model="ir.ui.view">
    <field name="name">ka.immo.ka.manuelle.form</field>
    <field name="model">ka.immo</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
        <form string="Nouvelle immobilisation" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Calculer amortissement" name="action_calculer" type="object" class="btn-secondary" invisible="state not in ('creation', 'en_service')"/>
                <field name="state" widget="statusbar" statusbar_visible="creation,en_service,sortie"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_plan" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_duree"/></span><span class="o_stat_text">Durée</span></div>
                    </button>
                    <button name="action_open_ecritures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_vnc"/></span><span class="o_stat_text">Valeur nette</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="intitule" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="intitule" string="Désignation" class="fw-bold"/>
                        <field name="famille_id" string="Catégorie" invisible="id"/>
                        <field name="famille_id" string="Catégorie" widget="badge" invisible="not id"/>
                        <field name="valeur" string="Valeur d'acquisition" class="fw-bold"/>
                        <field name="date_service" string="Date mise en service"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="methode" string="Méthode"/>
                        <field name="duree" string="Durée d'utilité" class="o_ka_u_ans"/>
                        <field name="analytic_id" string="Compte analytique"/>
                        <field name="partner_id" string="Fournisseur" placeholder="(facultatif — apport)"/>
                    </group>
                </group>
                <notebook>
                    <page string="Comptes" name="comptes">
                        <div class="o_ka_h3">Comptes (hérités de la catégorie)</div>
                        <table class="o_ka_tbl">
                            <thead><tr><th>Type</th><th>Compte</th></tr></thead>
                            <tbody>
                                <tr><td>Immobilisation</td><td><field name="cpt_immo_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Amortissement cumulé</td><td><field name="cpt_amort_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Dotation</td><td><field name="cpt_dotation_txt" nolabel="1" readonly="1"/></td></tr>
                            </tbody>
                        </table>
                        <p class="o_ka_note fst-italic">Les comptes et la méthode sont préremplis depuis la catégorie ; ils restent modifiables sur la fiche.</p>
                    </page>
                    <page string="Amortissement" name="amortissement">
                        <field name="plan_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="date" string="Échéance"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="dotation" string="Dotation" sum="Total"/>
                                <field name="cumul" string="Cumul"/>
                                <field name="vnc" string="VNC"/>
                                <field name="statut" string="Statut"/>
                            </list>
                        </field>
                    </page>
                    <page string="Analytique" name="analytique">
                        <group>
                            <group>
                                <field name="analytic_id" string="Compte analytique"/>
                                <field name="site_id" string="Site"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 3.1b — Création automatique depuis une facture fournisseur -->
<record id="view_ka_immo_depense_form" model="ir.ui.view">
    <field name="name">ka.immo.ka.facture.form</field>
    <field name="model">ka.immo</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
        <form string="Immobilisation générée depuis une facture" class="o_ka_form">
            <header>
                <button string="Confirmer" name="action_confirmer" type="object" class="btn-primary" invisible="state != 'a_confirmer'"/>
                <button string="Voir la facture" name="action_open_facture" type="object" class="btn-secondary" invisible="not move_id"/>
                <button string="Éclater la dépense" name="action_eclater" type="object" class="btn-secondary" invisible="state != 'a_confirmer'"/>
                <field name="state" widget="statusbar" statusbar_visible="creation,en_service,sortie"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_plan" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_duree"/></span><span class="o_stat_text">Durée</span></div>
                    </button>
                    <button name="action_open_ecritures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="kpi_vnc"/></span><span class="o_stat_text">Valeur nette</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="intitule"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle_auto" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Immobilisation <b>générée automatiquement</b> à la validation de la facture fournisseur <b><field name="ref_facture" readonly="1"/></b> (ligne marquée « immobilisable ») et rattachée à sa catégorie.</div>
                <group>
                    <group>
                        <field name="famille_id" string="Catégorie" widget="badge"/>
                        <field name="valeur" string="Valeur d'acquisition" readonly="1" class="fw-bold"/>
                        <field name="date_service" string="Date mise en service"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="methode" string="Méthode"/>
                        <field name="duree" string="Durée d'utilité" class="o_ka_u_ans"/>
                        <field name="analytic_id" string="Compte analytique"/>
                        <field name="move_id" string="Facture d'origine" readonly="1"/>
                    </group>
                </group>
                <div class="o_ka_h3">Facture fournisseur d'origine — <field name="ref_facture" readonly="1"/></div>
                <field name="facture_ligne_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="name" string="Ligne de facture"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="price_subtotal" string="Montant (FCFA)"/>
                        <field name="ka_immobilisable" string="Immobilisable"/>
                        <field name="ka_immo_txt" string="Immobilisation générée"/>
                    </list>
                </field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 3.2 — Tableau d'amortissement — validation -->
<record id="view_ka_immo_plan_form" model="ir.ui.view">
    <field name="name">ka.immo.ka.plan.form</field>
    <field name="model">ka.immo</field>
    <field name="priority">20</field>
    <field name="arch" type="xml">
        <form string="Tableau d'amortissement" class="o_ka_form" create="0">
            <header>
                <button string="Recalculer" name="action_calculer" type="object" class="btn-secondary" invisible="state not in ('creation', 'en_service') or plan_etat == 'postee'"/>
                <button string="Comptabiliser l'échéance" name="action_comptabiliser_echeance" type="object" class="btn-primary" invisible="state != 'en_service'"/>
                <button string="Imprimer le tableau" name="action_imprimer" type="object" class="btn-secondary"/>
                <field name="plan_etat" widget="statusbar" statusbar_visible="calcule,postee"/>
                <field name="state" invisible="1"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_fiche" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="name" readonly="1"/></span><span class="o_stat_text">Fiche immobilisation</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Tableau d'amortissement</h1>
                    <div class="o_ka_sub"><field name="intitule" readonly="1"/> · <field name="methode" readonly="1"/> · <field name="duree_txt" readonly="1"/> · <field name="plan_badge" readonly="1"/></div>
                </div>
                <field name="plan_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="date" string="Échéance"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="base" string="Base"/>
                        <field name="dotation" string="Dotation" sum="Total"/>
                        <field name="cumul" string="Cumul"/>
                        <field name="vnc" string="VNC"/>
                        <field name="statut" string="Statut"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Chaque échéance comptabilisée passe l'écriture de dotation et impute la charge analytiquement (<field name="analytic_id" readonly="1"/>).</div>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 3.1d — Liste / parc des immobilisations (vue liste) -->
<record id="view_ka_immo_tree" model="ir.ui.view">
    <field name="name">ka.immo.ka.tree</field>
    <field name="model">ka.immo</field>
    <field name="arch" type="xml">
        <list string="Immobilisations">
            <field name="name" string="Référence"/>
            <field name="intitule" string="Désignation"/>
            <field name="famille_id" string="Catégorie"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="valeur" string="Valeur d'acquisition" sum="Total"/>
            <field name="vnc" string="VNC" sum="Total"/>
            <field name="date_service" string="Mise en service"/>
            <field name="state" string="Statut" widget="badge" decoration-info="state == 'en_service'" decoration-warning="state == 'a_confirmer'" decoration-muted="state == 'sortie'"/>
        </list>
    </field>
</record>
<record id="view_ka_immo_search" model="ir.ui.view">
    <field name="name">ka.immo.ka.search</field>
    <field name="model">ka.immo</field>
    <field name="arch" type="xml">
        <search string="Rechercher (réf., désignation, catégorie)">
            <field name="name" string="Référence"/>
            <field name="intitule" string="Désignation"/>
            <field name="famille_id" string="Catégorie"/>
            <field name="site_id" string="Site"/>
            <filter name="en_service" string="En service" domain="[('state', '=', 'en_service')]"/>
            <filter name="a_confirmer" string="À confirmer" domain="[('state', '=', 'a_confirmer')]"/>
            <filter name="cede" string="Cédé" domain="[('state', '=', 'sortie')]"/>
            <group>
                <filter name="par_categorie" string="Catégorie" context="{'group_by': 'famille_id'}"/>
                <filter name="par_site" string="Site" context="{'group_by': 'site_id'}"/>
                <filter name="par_statut" string="Statut" context="{'group_by': 'state'}"/>
            </group>
        </search>
    </field>
</record>
<record id="action_ka_immo" model="ir.actions.act_window"><field name="name">Immobilisations</field><field name="res_model">ka.immo</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_immo_search"/><field name="context">{'search_default_en_service': 1, 'search_default_par_categorie': 1}</field></record><record id="action_ka_immo_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_immo_tree"/></record><record id="action_ka_immo_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_immo_form"/></record>
<record id="action_ka_immo_manuelle" model="ir.actions.act_window"><field name="name">Immobilisations</field><field name="res_model">ka.immo</field><field name="view_mode">form,list</field><field name="search_view_id" ref="view_ka_immo_search"/></record><record id="action_ka_immo_manuelle_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_manuelle"/><field name="sequence">1</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_immo_manuelle_form"/></record><record id="action_ka_immo_manuelle_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_manuelle"/><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_immo_tree"/></record>
<record id="action_ka_immo_depense" model="ir.actions.act_window"><field name="name">Immobilisations</field><field name="res_model">ka.immo</field><field name="view_mode">list,form</field><field name="domain">[('move_id', '!=', False)]</field><field name="search_view_id" ref="view_ka_immo_search"/><field name="context">{'search_default_a_confirmer': 1, 'create': False}</field></record><record id="action_ka_immo_depense_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_depense"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_immo_tree"/></record><record id="action_ka_immo_depense_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_depense"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_immo_depense_form"/></record>
<record id="action_ka_immo_plan" model="ir.actions.act_window"><field name="name">Tableaux d'amortissement</field><field name="res_model">ka.immo</field><field name="view_mode">list,form</field><field name="domain">[('plan_ids', '!=', False)]</field><field name="search_view_id" ref="view_ka_immo_search"/><field name="context">{'create': False}</field></record><record id="action_ka_immo_plan_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_plan"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_immo_tree"/></record><record id="action_ka_immo_plan_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_immo_plan"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_immo_plan_form"/></record>
</odoo>
