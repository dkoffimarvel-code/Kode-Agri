<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 3.1c — Catégorie d'immobilisation (paramétrage des règles) -->
<record id="view_ka_famille_form" model="ir.ui.view">
    <field name="name">ka.immo.famille.ka.form</field>
    <field name="model">ka.immo.famille</field>
    <field name="arch" type="xml">
        <form string="Catégorie d'immobilisation" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-primary"/>
                <button string="Créer" name="action_creer" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_immos" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="nb_immos"/></span><span class="o_stat_text">Immobilisations</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" placeholder="Intitulé de la catégorie"/></h1>
                    <div class="o_ka_sub">Catégorie <field name="code" placeholder="Code" class="d-inline"/> · règles d'amortissement par défaut</div>
                </div>
                <group>
                    <group>
                        <field name="methode" string="Méthode d'amortissement"/>
                        <field name="duree" string="Durée d'utilité" class="o_ka_u_ans"/>
                        <field name="axe" string="Compte analytique"/>
                        <field name="creation_facture" string="Création auto. depuis facture" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <field name="cpt_immo" string="Compte immobilisation"/>
                        <field name="cpt_amort" string="Compte amort. cumulé"/>
                        <field name="cpt_dotation" string="Compte de dotation"/>
                    </group>
                </group>
                <notebook>
                    <page string="Immobilisations rattachées" name="immos">
                        <field name="immo_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="name" string="Référence"/>
                                <field name="intitule" string="Désignation"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="valeur" string="Valeur d'acquisition"/>
                                <field name="state" string="Statut"/>
                            </list>
                        </field>
                    </page>
                    <page string="Comptes" name="comptes">
                        <table class="o_ka_tbl">
                            <thead><tr><th>Type</th><th>Compte</th></tr></thead>
                            <tbody>
                                <tr><td>Immobilisation</td><td><field name="cpt_immo_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Amortissement cumulé</td><td><field name="cpt_amort_txt" nolabel="1" readonly="1"/></td></tr>
                                <tr><td>Dotation</td><td><field name="cpt_dotation_txt" nolabel="1" readonly="1"/></td></tr>
                            </tbody>
                        </table>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_famille_tree" model="ir.ui.view">
    <field name="name">ka.immo.famille.ka.tree</field>
    <field name="model">ka.immo.famille</field>
    <field name="arch" type="xml"><list string="Catégories d'immobilisation"><field name="code"/><field name="name"/><field name="methode"/><field name="duree"/><field name="cpt_immo"/><field name="nb_immos"/></list></field>
</record>
<record id="action_ka_famille" model="ir.actions.act_window"><field name="name">Catégories d'immobilisation</field><field name="res_model">ka.immo.famille</field><field name="view_mode">list,form</field></record>
</odoo>
