<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_facture_vente_form" model="ir.ui.view">
    <field name="name">account.move.ka.form</field>
    <field name="model">account.move</field>
    <field name="arch" type="xml">
        <form string="Facture client" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Confirmer" name="action_valider_ka" type="object" class="btn-primary" invisible="state != 'draft'"/>
                <button string="Enregistrer paiement" name="action_reglement_ka" type="object" class="btn-secondary" invisible="state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
                <button string="Imprimer" name="action_imprimer_ka" type="object" class="btn-secondary"/>
                <field name="ka_etape" widget="statusbar" statusbar_visible="brouillon,comptabilisee,payee"/>
            </header>
            <sheet>
                <field name="move_type" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="payment_state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_ka_ouvrir_devise" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ka_devise_txt"/></span><span class="o_stat_text">Devise</span></div>
                    </button>
                    <button name="action_ka_ouvrir_ecritures" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="ka_montant_txt"/></span><span class="o_stat_text">Montant</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1" placeholder="Brouillon"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="partner_id" string="Client" required="1"/>
                        <field name="ka_contrat_id" string="Contrat"/>
                        <field name="ka_devise_txt" string="Devise" readonly="1"/>
                    </group>
                    <group>
                        <field name="invoice_date" string="Date facture"/>
                        <field name="invoice_payment_term_id" string="Échéance"/>
                        <field name="ka_cours" string="Cours du jour" readonly="1"/>
                    </group>
                </group>
                <field name="invoice_line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="product_id" optional="hide"/>
                        <field name="name" string="Désignation"/>
                        <field name="quantity" string="Qté"/>
                        <field name="price_unit" string="PU (devise)"/>
                        <field name="price_subtotal" string="Montant (devise)" sum="Total facture"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Comptabilisation : produit constaté, créance client en devise. Écart de change suivi entre facturation et encaissement.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_facture_vente_tree" model="ir.ui.view">
    <field name="name">account.move.ka.tree</field>
    <field name="model">account.move</field>
    <field name="arch" type="xml"><list string="ka_facture_vente"><field name="name"/><field name="partner_id"/><field name="invoice_date"/><field name="amount_total" sum="Total"/><field name="currency_id"/><field name="ka_statut_label" widget="badge"/></list></field>
</record>
<record id="action_ka_facture_vente" model="ir.actions.act_window"><field name="name">Factures clients</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type', '=', 'out_invoice')]</field><field name="context">{'default_move_type': 'out_invoice'}</field></record>
<record id="action_ka_facture_vente_l" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_facture_vente"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_facture_vente_tree"/></record>
<record id="action_ka_facture_vente_f" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_facture_vente"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_facture_vente_form"/></record>
</odoo>
