<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rapprochement_form" model="ir.ui.view">
    <field name="name">ka.rapprochement.ka.form</field>
    <field name="model">ka.rapprochement</field>
    <field name="arch" type="xml">
        <form string="Facture fournisseur — contrôle facture" class="o_ka_form">
            <sheet>
                <div class="o_ka_crumbs"><span class="o_ka_c">Accueil</span><span class="o_ka_c">Achats</span><span class="o_ka_c">Factures</span><span class="o_ka_cur">Factures</span><span class="o_ka_fn">Fonction : GESPIH</span></div>
                <div class="o_ka_layout">
                    <div class="o_ka_main">
                        <div class="o_ka_head">
                            <div><h1>Facture fournisseur — contrôle facture</h1><div class="o_ka_sub"><field name="ka_subtitle" nolabel="1" readonly="1"/></div></div>
                            <field name="state" widget="badge" decoration-warning="state in ('attente','a_controler')" decoration-success="state in ('rapprochee')"/>
                        </div>
                        <div class="o_ka_kpis"><div class="o_ka_kpi"><field name="commande_txt" nolabel="1"/><span class="o_ka_kl">Commande</span></div><div class="o_ka_kpi"><field name="reception_txt" nolabel="1"/><span class="o_ka_kl">Réception</span></div><div class="o_ka_kpi"><field name="ecart_txt" nolabel="1"/><span class="o_ka_kl">Écart</span></div></div><div class="o_ka_info">Contrôle à trois niveaux commande / réception / facture avec tolérances. La validation solde le compte des factures non parvenues.</div><div class="o_ka_sec">En-tête</div><div class="o_ka_grid"><div class="o_ka_f"><label for="partner_id" string="Fournisseur" class="o_ka_req"/><field name="partner_id"/></div><div class="o_ka_f"><label for="date_facture" string="Date facture" class="o_ka_req"/><field name="date_facture"/></div><div class="o_ka_f"><label for="echeance" string="Échéance"/><field name="echeance" readonly="1"/></div><div class="o_ka_f"><label for="controle" string="Statut du contrôle"/><field name="controle" readonly="1" widget="badge" decoration-success="controle=='conforme'" decoration-danger="controle=='ecart'"/></div><div class="o_ka_f"><label for="move_id" string="Facture" class="o_ka_req"/><field name="move_id"/></div><div class="o_ka_f"><label for="tol_prix" string="Tolérance prix (%)"/><field name="tol_prix"/></div><div class="o_ka_f"><label for="tol_qty" string="Tolérance quantité"/><field name="tol_qty"/></div></div><field name="line_ids" nolabel="1"><list editable="bottom"><field name="sequence" string="Ligne"/><field name="product_id" string="Article / service"/><field name="recu" string="Reçu"/><field name="facture" string="Facturé"/><field name="ecart_qty" string="Écart"/><field name="prix_net" string="Prix net"/><field name="prix_commande" column_invisible="1"/><field name="montant" string="Montant" sum="Total HT"/></list></field>
                    </div>
                    <aside class="o_ka_side"><div class="o_ka_side_t">Actions</div><button string="Enregistrer" special="save" class="o_ka_btn"/><button string="Mettre en attente" name="action_attente" type="object" class="o_ka_btn"/><button string="Valider la facture" name="action_valider" type="object" class="o_ka_btn o_ka_primary" invisible="state == 'rapprochee'"/><button string="Contrôle facture" name="action_controle" type="object" class="o_ka_btn"/></aside>
                </div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_rapprochement_tree" model="ir.ui.view">
    <field name="name">ka.rapprochement.ka.tree</field>
    <field name="model">ka.rapprochement</field>
    <field name="arch" type="xml"><list string="ka_rapprochement"><field name="name"/><field name="move_id"/><field name="partner_id"/><field name="total_ht"/><field name="controle" widget="badge"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_rapprochement" model="ir.actions.act_window"><field name="name">Contrôle des factures fournisseurs</field><field name="res_model">ka.rapprochement</field><field name="view_mode">list,form</field></record>
</odoo>
