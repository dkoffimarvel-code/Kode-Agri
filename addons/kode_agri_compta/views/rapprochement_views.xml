<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rapprochement_form" model="ir.ui.view">
    <field name="name">ka.rapprochement.ka.form</field>
    <field name="model">ka.rapprochement</field>
    <field name="arch" type="xml">
        <form string="Facture fournisseur — rapprochement" class="o_ka_form">
            <header>
                <button string="Rapprocher réception" name="action_controle" type="object" class="btn-secondary" invisible="state == 'rapprochee'"/>
                <button string="Confirmer" name="action_valider" type="object" class="btn-primary" invisible="state == 'rapprochee'"/>
                <button string="Mettre en attente" name="action_attente" type="object" class="btn-secondary" invisible="state != 'a_controler'"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-secondary" invisible="move_state == 'posted'"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <field name="etape" widget="statusbar" statusbar_visible="brouillon,a_rapprocher,comptabilisee,payee"/>
            </header>
            <sheet>
                <field name="move_state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_ouvrir_commande" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="commande_txt"/></span><span class="o_stat_text">Commande</span></div>
                    </button>
                    <button name="action_ouvrir_reception" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="reception_txt"/></span><span class="o_stat_text">Réception</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="move_id" placeholder="Facture fournisseur à rapprocher" options="{'no_create': True}"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Rapprochement à 3 niveaux : commande ↔ réception ↔ facture. Le compte « biens reçus non facturés » est soldé.</div>
                <group>
                    <group>
                        <field name="partner_id" string="Fournisseur" required="1"/>
                        <field name="commande_txt" string="Commande"/>
                        <field name="reception_txt" string="Réception"/>
                    </group>
                    <group>
                        <field name="date_facture" string="Date facture"/>
                        <field name="echeance" string="Échéance"/>
                        <field name="controle" string="Statut rappro." widget="badge" decoration-success="controle == 'conforme'" decoration-danger="controle == 'ecart'"/>
                    </group>
                </group>
                <div class="o_ka_h3">Lignes facturées (rapprochées à la réception)</div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sequence" column_invisible="1"/>
                        <field name="product_id" string="Article / Service"/>
                        <field name="recu" string="Reçu"/>
                        <field name="facture" string="Facturé"/>
                        <field name="ecart_qty" string="Écart"/>
                        <field name="prix_net" string="PU"/>
                        <field name="prix_commande" column_invisible="1"/>
                        <field name="montant" string="Montant" sum="Total facturé HT"/>
                    </list>
                </field>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Confirmation : solde du compte « biens reçus non facturés », TVA déductible constatée, dette fournisseur enregistrée. Imputation analytique conservée.</div>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_rapprochement_tree" model="ir.ui.view">
    <field name="name">ka.rapprochement.ka.tree</field>
    <field name="model">ka.rapprochement</field>
    <field name="arch" type="xml"><list string="ka_rapprochement"><field name="name"/><field name="move_id"/><field name="partner_id"/><field name="total_ht"/><field name="controle" widget="badge"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_rapprochement" model="ir.actions.act_window"><field name="name">Factures fournisseurs</field><field name="res_model">ka.rapprochement</field><field name="view_mode">list,form</field></record>
</odoo>
