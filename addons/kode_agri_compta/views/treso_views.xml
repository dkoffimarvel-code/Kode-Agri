<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_treso_form" model="ir.ui.view">
    <field name="name">ka.treso.ka.form</field>
    <field name="model">ka.treso</field>
    <field name="arch" type="xml">
        <form string="Planning de trésorerie" class="o_ka_form">
            <header>
                <button string="Hebdomadaire" name="action_hebdo" type="object" class="btn-primary" invisible="mode != 'hebdo'"/>
                <button string="Hebdomadaire" name="action_hebdo" type="object" class="btn-secondary" invisible="mode == 'hebdo'"/>
                <button string="Mensuel" name="action_mensuelle" type="object" class="btn-primary" invisible="mode != 'mensuelle'"/>
                <button string="Mensuel" name="action_mensuelle" type="object" class="btn-secondary" invisible="mode == 'mensuelle'"/>
                <button string="Actualiser" name="action_actualiser" type="object" class="btn-secondary"/>
                <button string="Exporter" name="action_exporter" type="object" class="btn-secondary"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                <field name="mode" invisible="1"/>
                <div class="oe_title">
                    <h1><field name="titre_vue" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="titre" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Chaque rubrique agrège les échéances déjà validées : types de produits (§ 8.3.1, § 8.3.3), type charges (§ 8.2, § 8.5.2), investissement (§ 8.4), remboursements d'emprunts et de crédits spots, impôts et taxes (§ 8.7.5). Le détail des rubriques Type charges et Types de produits est développé par nature ci-dessous.</div>
                <field name="cartes_html" nolabel="1" readonly="1"/>
                <group>
                    <group>
                        <field name="date_ref" string="Situation au"/>
                    </group>
                    <group>
                        <field name="nb_periodes" string="Périodes"/>
                    </group>
                </group>
                <field name="table_html" nolabel="1" readonly="1"/>
                <div class="o_ka_valid" invisible="mode != 'mensuelle'"><span class="o_ka_valid_t">Validation / Approbation</span>Le solde prévisionnel mensuel cumule les six rubriques ci-dessus à partir des échéances déjà validées dans l'ERP. Les rubriques Type charges et Types de produits se déplient par nature (▾) ; toute rubrique modifiée (nouvel engagement, échéance déplacée) recalcule automatiquement la ligne Solde prévisionnel (§ 8.6.4).</div>
                <div class="o_ka_valid" invisible="mode != 'hebdo'"><span class="o_ka_valid_t">Validation / Approbation</span>Le solde prévisionnel hebdomadaire cumule les six rubriques ci-dessus à partir des échéances déjà validées dans l'ERP. Les rubriques Type charges et Types de produits se déplient par nature (▾) ; toute rubrique modifiée (nouvel engagement, échéance déplacée) recalcule automatiquement la ligne Solde prévisionnel (§ 8.6.4).</div>
            </sheet>
        </form>
    </field>
</record>
<!-- Écran 8.5 : même formulaire, ouvert par « Hebdomadaire » (la vue s'adapte au mode du planning). -->
<record id="view_ka_treso_hebdo_form" model="ir.ui.view">
    <field name="name">ka.treso.ka.form.hebdo</field>
    <field name="model">ka.treso</field>
    <field name="inherit_id" ref="view_ka_treso_form"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <xpath expr="//form" position="attributes"><attribute name="string">Planning de trésorerie — vue hebdomadaire</attribute></xpath>
    </field>
</record>
<record id="view_ka_treso_ligne_tree" model="ir.ui.view"><field name="name">ka.treso.ligne.tree</field><field name="model">ka.treso.ligne</field><field name="arch" type="xml"><list string="Prévisions manuelles" editable="bottom"><field name="date"/><field name="rubrique"/><field name="libelle"/><field name="montant" sum="Total"/></list></field></record>
<record id="action_ka_treso_ligne" model="ir.actions.act_window"><field name="name">Prévisions manuelles</field><field name="res_model">ka.treso.ligne</field><field name="view_mode">list</field></record>
<record id="action_ka_treso" model="ir.actions.act_window"><field name="name">Trésorerie</field><field name="res_model">ka.treso</field><field name="res_id" ref="treso_1"/><field name="view_mode">form</field><field name="view_id" ref="view_ka_treso_form"/></record>
</odoo>
