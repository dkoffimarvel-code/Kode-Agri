<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_regul_form" model="ir.ui.view">
    <field name="name">ka.regul.ka.form</field>
    <field name="model">ka.regul</field>
    <field name="arch" type="xml">
        <form string="Régularisation d'arrêté" class="o_ka_form">
            <header>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-primary" invisible="state != 'brouillon'"/>
                <button string="Extourner" name="action_extourner" type="object" class="btn-secondary" invisible="state != 'comptabilisee' or not extourne"/>
                <button string="Reprise de provision" name="action_reprise" type="object" class="btn-secondary" invisible="state != 'comptabilisee' or extourne"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,comptabilisee,extournee"/>
            </header>
            <sheet>
                <field name="currency_id" invisible="1"/>
                <field name="extourne" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_ecritures" type="object" class="oe_stat_button" invisible="not move_id">
                        <div class="o_stat_info"><span class="o_stat_value">Pièces</span><span class="o_stat_text">Consulter les écritures</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1><field name="name" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Toute charge ou produit constaté d'avance, charge à payer ou produit à recevoir comptabilisé à la clôture est automatiquement contre-passé à l'ouverture suivante, à la même date et pour le même montant (RG-8.5).</div>
                <group>
                    <group>
                        <field name="type" string="Nature"/>
                        <field name="libelle" string="Libellé"/>
                        <field name="date_cloture" string="Date de clôture"/>
                        <field name="date_extourne" string="Date d'extourne"/>
                    </group>
                    <group>
                        <field name="compte_charge_id" string="Compte de charge ou de produit"/>
                        <field name="compte_regul_id" string="Compte de régularisation"/>
                        <field name="montant" string="Montant"/>
                        <field name="journal_id" string="Journal"/>
                        <field name="move_extourne_id" string="Pièce d'extourne ou de reprise" invisible="not move_extourne_id"/>
                    </group>
                </group>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_regul_tree" model="ir.ui.view">
    <field name="name">ka.regul.ka.tree</field>
    <field name="model">ka.regul</field>
    <field name="arch" type="xml"><list string="ka_regul"><field name="name"/><field name="type"/><field name="libelle"/><field name="date_cloture"/><field name="montant" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_regul" model="ir.actions.act_window"><field name="name">Régularisations d'arrêté</field><field name="res_model">ka.regul</field><field name="view_mode">list,form</field></record>
<record id="view_ka_schema_tree" model="ir.ui.view"><field name="name">ka.schema.tree</field><field name="model">ka.schema</field><field name="arch" type="xml"><list string="Schémas d'écritures"><field name="rubrique"/><field name="operation"/><field name="debit"/><field name="credit"/><field name="regle"/></list></field></record>
<record id="view_ka_schema_search" model="ir.ui.view"><field name="name">ka.schema.search</field><field name="model">ka.schema</field><field name="arch" type="xml"><search><field name="operation"/><field name="rubrique"/><group><filter name="g_dom" string="Domaine" context="{'group_by': 'domaine'}"/><filter name="g_rub" string="Rubrique" context="{'group_by': 'rubrique'}"/></group></search></field></record>
<record id="action_ka_schema" model="ir.actions.act_window"><field name="name">Schémas d'écritures</field><field name="res_model">ka.schema</field><field name="view_mode">list,form</field><field name="context">{'search_default_g_dom': 1, 'search_default_g_rub': 1}</field></record>
</odoo>
