<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_bab_form" model="ir.ui.view">
    <field name="name">ka.bab.ka.form</field>
    <field name="model">ka.bab</field>
    <field name="arch" type="xml">
        <form string="Bon à budgétiser CAPEX" class="o_ka_form">
            <header>
                <button string="Planifier depuis le budget validé" name="action_planifier" type="object" class="btn-primary" invisible="state not in ('brouillon', 'emis')"/>
                <button string="Nouveau bon" name="action_creer" type="object" class="btn-secondary"/>
                <button string="Soumettre" name="action_soumettre" type="object" class="btn-secondary" invisible="state != 'brouillon'"/>
                <button string="Viser (DAF)" name="action_viser" type="object" class="btn-secondary" invisible="state != 'emis'"/>
                <button string="Approuver (DG)" name="action_approuver" type="object" class="btn-secondary" invisible="state != 'vise'"/>
                <button string="Autoriser (CA)" name="action_autoriser" type="object" class="btn-secondary" invisible="state != 'approuve'"/>
                <button string="Engager" name="action_engager" type="object" class="btn-secondary" invisible="state not in ('approuve', 'autorise')"/>
                <button string="Consulter les engagements" name="action_consulter" type="object" class="btn-secondary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <field name="state" widget="statusbar" statusbar_visible="brouillon,emis,vise,approuve,autorise"/>
            </header>
            <sheet>
                <field name="currency_id" invisible="1"/>
                <div class="oe_title">
                    <h1><field name="titre" readonly="1"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <div class="o_ka_info o_ka_noicon"><field name="info" readonly="1"/></div>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="o_ka_h3">Bon à budgétiser <field name="name" readonly="1" class="oe_inline"/> (dotation)</div>
                        <group>
                            <field name="intitule" string="Libellé"/>
                            <field name="nature" string="Nature d'immobilisation"/>
                            <field name="account_id" string="Compte général"/>
                            <field name="section_id" string="Axe analytique"/>
                            <field name="dotation" string="Dotation"/>
                            <field name="periode" string="Période"/>
                            <field name="regle" string="Règles de suivi"/>
                            <field name="budget_id" string="Budget validé"/>
                        </group>
                    </div>
                    <div class="col-lg-6">
                        <div class="o_ka_h3">Circuit de validation (règles définies par l'entité)</div>
                        <field name="circuit_html" nolabel="1" readonly="1"/>
                    </div>
                </div>
                <div class="o_ka_h3">Exécution et suivi du bon — dotation / engagé / réalisé / disponible</div>
                <field name="mouvement_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="mouvement" string="Mouvement"/>
                        <field name="reference" string="Référence"/>
                        <field name="date" string="Date"/>
                        <field name="engage" string="Engagé" sum="Engagé"/>
                        <field name="realise" string="Réalisé" sum="Réalisé"/>
                        <field name="disponible" string="Disponible"/>
                    </list>
                </field>
                <group>
                    <group>
                        <field name="situation" string="Situation" readonly="1"/>
                    </group>
                    <group>
                        <field name="engage" string="Engagé" readonly="1"/>
                        <field name="realise" string="Réalisé" readonly="1"/>
                        <field name="disponible" string="Disponible" readonly="1"/>
                    </group>
                </group>
                <div class="o_ka_h3">Lignes de commande engagées sur le bon</div>
                <field name="ligne_ids" nolabel="1">
                    <list>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="order_id" string="Commande"/>
                        <field name="name" string="Désignation"/>
                        <field name="price_subtotal" string="Montant" sum="Total"/>
                    </list>
                </field>
                <p class="o_ka_note">Le suivi CAPEX porte sur les bons à budgétiser (et non sur les lignes budgétaires générales) : engagements rattachés au bon, alerte si engagement &gt; dotation (blocage ou dérogation selon les règles de l'entité), alimentation de l'état des investissements.</p>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_bab_tree" model="ir.ui.view">
    <field name="name">ka.bab.ka.tree</field>
    <field name="model">ka.bab</field>
    <field name="arch" type="xml"><list string="ka_bab"><field name="name"/><field name="intitule"/><field name="dotation" sum="Total"/><field name="engage"/><field name="disponible"/><field name="badge_label" widget="badge"/></list></field>
</record>
<record id="action_ka_bab" model="ir.actions.act_window"><field name="name">Bons à budgétiser CAPEX</field><field name="res_model">ka.bab</field><field name="view_mode">list,form</field></record>
</odoo>
