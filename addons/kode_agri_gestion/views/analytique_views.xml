<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_cascade_form" model="ir.ui.view">
    <field name="name">ka.cascade.ka.form</field>
    <field name="model">ka.cascade</field>
    <field name="arch" type="xml">
        <form string="Coût de revient par activité" class="o_ka_form">
            <header>
                <button string="Nouveau" name="action_creer" type="object" class="btn-primary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Importer écritures stock" name="action_importer_stock" type="object" class="btn-secondary"/>
                <button string="Actualiser" name="action_actualiser" type="object" class="btn-secondary"/>
                <button string="Exporter" name="action_exporter" type="object" class="btn-secondary"/>
                <field name="statut" widget="statusbar" statusbar_visible="actif"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_detail" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="cascade_txt"/></span><span class="o_stat_text">Cascade</span></div>
                    </button>
                    <button name="action_marge" type="object" class="oe_stat_button">
                        <div class="o_stat_info"><span class="o_stat_value"><field name="marge_nette_txt"/></span><span class="o_stat_text">Marge nette</span></div>
                    </button>
                </div>
                <div class="oe_title">
                    <h1>Coût de revient par activité</h1>
                    <div class="o_ka_sub"><field name="titre" readonly="1"/></div>
                </div>
                <div class="o_ka_info">Routine : écritures de stock importées dans le journal analytique à tout moment. Chaque charge est imputée à une activité.</div>
                <group>
                    <group>
                        <field name="axe_principal_txt" string="Axe principal" widget="badge"/>
                        <field name="grade_id" string="Axe croisé 1"/>
                        <field name="campagne_id" string="Campagne"/>
                    </group>
                    <group>
                        <field name="site_id" string="Site"/>
                        <field name="devise_vente_txt" string="Devise vente"/>
                        <field name="statut" string="Statut" widget="badge" decoration-success="statut == 'actif'"/>
                    </group>
                </group>
                <div class="o_ka_h3">Cascade du coût de revient export (par activité)</div>
                <field name="table_html" nolabel="1" readonly="1"/>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_repartition_form" model="ir.ui.view">
    <field name="name">ka.repartition.ka.form</field>
    <field name="model">ka.repartition</field>
    <field name="arch" type="xml">
        <form string="Affectation des coûts — unités d'œuvre et clés" class="o_ka_form">
            <header>
                <button string="Saisir unités d'œuvre (jour)" name="action_saisir_uo" type="object" class="btn-primary"/>
                <button string="Lancer la routine (clés %)" name="action_calculer_cles" type="object" class="btn-secondary" invisible="state == 'repartie'"/>
                <button string="Lancer la répartition" name="action_repartir" type="object" class="btn-secondary" invisible="state != 'cles'"/>
                <field name="state" widget="statusbar" statusbar_visible="saisie,cles,repartie"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Affectation des coûts — unités d'œuvre et clés</h1>
                    <div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div>
                </div>
                <group>
                    <group>
                        <field name="emetteur_id" string="Charge indirecte"/>
                    </group>
                    <group>
                        <field name="periode" string="Période"/>
                    </group>
                </group>
                <div class="o_ka_h3"><field name="titre_uo" readonly="1"/></div>
                <field name="uo_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="date" string="Date"/>
                        <field name="emetteur_id" string="Charge indirecte"/>
                        <field name="unite" string="Unité d'œuvre"/>
                        <field name="recepteur_id" string="Centre consommateur"/>
                        <field name="quantite" string="Quantité" sum="Cumul du mois"/>
                    </list>
                </field>
                <div class="row">
                    <div class="col-lg-6">
                        <div class="o_ka_h3">2) Clés de répartition calculées en % à fin de mois (routine)</div>
                        <field name="cle_ids" nolabel="1" readonly="1">
                            <list>
                                <field name="recepteur_id" string="Centre consommateur"/>
                                <field name="quantite" string="UO"/>
                                <field name="pct" string="Clé %"/>
                            </list>
                        </field>
                    </div>
                    <div class="col-lg-6">
                        <div class="o_ka_h3"><field name="titre_repartition" readonly="1"/></div>
                        <field name="table_html" nolabel="1" readonly="1"/>
                    </div>
                </div>
                <p class="o_ka_note">La routine reventile chaque compte général imputé à la charge indirecte (le carburant est réparti, puis le coût des pneus, et ainsi de suite) avec la clé % du mois ; les centres destinataires reçoivent leur quote-part par nature de charge. Montants en MFCFA.<br/>Les répartitions alimentent la cascade du coût de revient (collecte → coût d'achat FDT ; mise à FOB → frais de mise à FOB, etc.).</p>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_repartition_tree" model="ir.ui.view">
    <field name="name">ka.repartition.ka.tree</field>
    <field name="model">ka.repartition</field>
    <field name="arch" type="xml"><list string="ka_repartition"><field name="name"/><field name="emetteur_id"/><field name="periode"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_uo_tree" model="ir.ui.view">
    <field name="name">ka.uo.ka.tree</field>
    <field name="model">ka.uo</field>
    <field name="arch" type="xml"><list string="ka_uo"><field name="date"/><field name="emetteur_id"/><field name="unite"/><field name="recepteur_id"/><field name="quantite" sum="Total"/></list></field>
</record>
<record id="action_ka_cascade" model="ir.actions.act_window"><field name="name">Comptes analytiques</field><field name="res_model">ka.cascade</field><field name="res_id" ref="cascade_1"/><field name="view_mode">form</field></record>
<record id="action_ka_repartition" model="ir.actions.act_window"><field name="name">Affectation des coûts</field><field name="res_model">ka.repartition</field><field name="view_mode">list,form</field></record>
<record id="action_ka_uo" model="ir.actions.act_window"><field name="name">Unités d'œuvre</field><field name="res_model">ka.uo</field><field name="view_mode">list,form</field></record>
</odoo>
