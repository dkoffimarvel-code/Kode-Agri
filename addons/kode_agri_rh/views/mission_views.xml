<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rh_mission_form" model="ir.ui.view">
    <field name="name">ka.rh.mission.ka.form</field>
    <field name="model">ka.rh.mission</field>
    <field name="arch" type="xml">
        <form string="Ordre de mission" class="o_ka_form">
            <header><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Soumettre" name="action_soumettre" type="object" class="btn-secondary" invisible="state != 'brouillon'"/><button string="Approuver" name="action_approuver" type="object" class="btn-primary" invisible="state != 'a_approuver'"/><button string="Verser avance" name="action_verser_avance" type="object" class="btn-secondary" invisible="state != 'en_cours' or avance_versee"/><button string="Décompter" name="action_decompter" type="object" class="btn-secondary" invisible="state != 'en_cours'"/><button string="Régulariser et clôturer" name="action_regulariser" type="object" class="btn-primary" invisible="state != 'a_regulariser'"/><button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="state != 'a_approuver'"/><field name="state" widget="statusbar" statusbar_visible="brouillon,a_approuver,en_cours,a_regulariser,cloturee"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_voir_ecritures" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="duree_txt"/></span><span class="o_stat_text">Durée</span></div></button><button name="action_voir_ecritures" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="avance_txt"/></span><span class="o_stat_text">Avance</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info">Autorisation préalable. L'avance de mission sera régularisée au retour (per diem + frais réels éventuels).</div><group><group><field name="employe_id" string="Missionnaire"/><field name="objet" string="Objet"/><field name="destination" string="Destination"/><field name="date_debut" string="Période" widget="daterange" options="{'end_date_field': 'date_fin'}" required="1"/><field name="date_fin" invisible="1"/><field name="titre_court" string="Intitulé"/></group><group><field name="moyen_transport" string="Moyen de transport"/><field name="vehicule_txt" string="Véhicule de service" invisible="moyen_transport != 'vehicule'"/><field name="zone" string="Barème"/><field name="per_diem" string="Per diem / jour"/><field name="avance_demandee" string="Avance demandée"/><field name="analytic_id" string="Activité analytique" class="o_ka_tag"/><field name="avance_versee" invisible="1"/></group></group><div class="o_ka_h3">Décompte de mission (au retour)</div><field name="decompte_html" nolabel="1" readonly="1"/><group><group><field name="note_ids" string="Notes de frais (frais réels)" widget="many2many_tags" readonly="state in ('cloturee', 'refusee')"/><field name="retenue_paie" string="Trop-perçu retenu sur la paie"/></group><group><field name="solde_avance" string="Solde du compte d'avance"/><field name="bulletin_id" string="Bulletin de retenue" invisible="not bulletin_id"/></group></group><div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Circuit : soumission → approbation → versement avance → décompte au retour → régularisation (trop-perçu retenu sur paie ou complément versé) → comptabilisation.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_rh_mission_list" model="ir.ui.view">
    <field name="name">ka.rh.mission.ka.list</field>
    <field name="model">ka.rh.mission</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="employe_id"/><field name="objet"/><field name="destination"/><field name="date_debut"/><field name="date_fin"/><field name="analytic_id" optional="show"/><field name="avance_versee" sum="Total"/><field name="indemnites" sum="Total"/><field name="frais_reels" sum="Total"/><field name="regularisation" sum="Total"/><field name="state" widget="badge" decoration-warning="state in ('a_approuver', 'a_regulariser')" decoration-success="state == 'cloturee'"/></list></field>
</record>
<record id="view_ka_rh_mission_search" model="ir.ui.view">
    <field name="name">ka.rh.mission.ka.search</field>
    <field name="model">ka.rh.mission</field>
    <field name="arch" type="xml"><search><field name="employe_id"/><field name="name"/><field name="analytic_id"/><filter name="en_cours" string="En cours" domain="[('state', '=', 'en_cours')]"/><filter name="a_regulariser" string="À régulariser" domain="[('state', '=', 'a_regulariser')]"/><filter name="avances" string="Avances versées" domain="[('avance_versee', '&gt;', 0)]"/><filter name="g_emp" string="Collaborateur" context="{'group_by': 'employe_id'}"/><filter name="g_ana" string="Activité" context="{'group_by': 'analytic_id'}"/></search></field>
</record>
<record id="view_ka_rh_mission_pivot" model="ir.ui.view">
    <field name="name">ka.rh.mission.ka.pivot</field>
    <field name="model">ka.rh.mission</field>
    <field name="arch" type="xml"><pivot><field name="analytic_id" type="row"/><field name="date_debut" interval="month" type="col"/><field name="indemnites" type="measure"/><field name="frais_reels" type="measure"/></pivot></field>
</record>
<record id="action_ka_rh_mission" model="ir.actions.act_window"><field name="name">Ordres de mission</field><field name="res_model">ka.rh.mission</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_rh_mission_search"/></record><record id="action_ka_rh_mission_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_mission"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_mission_list"/></record><record id="action_ka_rh_mission_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_mission"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_mission_form"/></record>
<record id="action_ka_rh_mission_avances" model="ir.actions.act_window"><field name="name">Avances sur missions</field><field name="res_model">ka.rh.mission</field><field name="view_mode">list,form</field><field name="context">{'search_default_avances': 1}</field><field name="search_view_id" ref="view_ka_rh_mission_search"/></record><record id="action_ka_rh_mission_avances_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_mission_avances"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_mission_list"/></record><record id="action_ka_rh_mission_avances_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_mission_avances"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_mission_form"/></record>
<record id="action_ka_rh_mission_couts" model="ir.actions.act_window"><field name="name">Coût des missions</field><field name="res_model">ka.rh.mission</field><field name="view_mode">pivot,list</field><field name="search_view_id" ref="view_ka_rh_mission_search"/></record><record id="action_ka_rh_mission_couts_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_mission_couts"/><field name="sequence">1</field><field name="view_mode">pivot</field><field name="view_id" ref="view_ka_rh_mission_pivot"/></record>
</odoo>
