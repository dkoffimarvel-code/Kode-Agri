<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rh_dp_form" model="ir.ui.view">
    <field name="name">ka.rh.demande.personnel.ka.form</field>
    <field name="model">ka.rh.demande.personnel</field>
    <field name="arch" type="xml">
        <form string="Demande de personnel" class="o_ka_form">
            <header><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Soumettre" name="action_soumettre" type="object" class="btn-primary" invisible="state != 'brouillon'"/><button string="Valider" name="action_valider" type="object" class="btn-primary" invisible="state != 'a_valider'"/><button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="state != 'a_valider'"/><button string="Ouvrir le poste" name="action_ouvrir_poste" type="object" class="btn-primary" invisible="state != 'approuvee'"/><field name="state" widget="statusbar" statusbar_visible="brouillon,a_valider,approuvee,poste_ouvert"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_candidatures" type="object" class="oe_stat_button" invisible="state in ('brouillon', 'a_valider')"><div class="o_stat_info"><span class="o_stat_value"><field name="nb_candidatures"/></span><span class="o_stat_text">Candidatures</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><group><group><field name="motif" string="Motif" required="1"/><div class="o_ka_hint" colspan="2">Liste : Remplacement (départ) · Remplacement (mobilité interne) · Création de poste</div><field name="poste" string="Poste concerné"/><field name="type_contrat" string="Type de contrat souhaité"/><field name="effectif" string="Effectif demandé"/><field name="date_souhaitee" string="Date de prise de fonction souhaitée"/><field name="categorie_id" string="Catégorie professionnelle"/><field name="categorie_txt" string="Précision"/><field name="budget" string="Budget / masse salariale"/><field name="ligne_budgetaire" string="Ligne budgétaire"/><field name="affectation_id" string="Atelier ou service"/><field name="demandeur" string="Demandeur"/></group><group></group></group><div class="o_ka_h3">Justification</div><field name="justification" nolabel="1" placeholder="Motif détaillé du besoin…"/><div class="o_ka_info o_ka_noicon"><span class="o_ka_info_t">Circuit de validation</span>Responsable d'atelier → responsable RH → direction (au-delà du seuil budgétaire ou pour une création de poste) → ouverture du poste et publication de l'offre (§7.5.2). Aucune offre n'est diffusée sans demande de personnel approuvée (RG-7.6).</div><group><group><field name="circuit_txt" string="Étape de validation"/><field name="direction_requise" string="Validation direction requise"/></group><group><field name="valide_hierarchie"/><field name="valide_rh"/><field name="valide_direction" invisible="not direction_requise"/></group></group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_rh_dp_list" model="ir.ui.view">
    <field name="name">ka.rh.demande.personnel.ka.list</field>
    <field name="model">ka.rh.demande.personnel</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="poste"/><field name="affectation_id"/><field name="motif"/><field name="effectif"/><field name="date_souhaitee"/><field name="budget" sum="Total"/><field name="nb_candidatures"/><field name="state" widget="badge" decoration-warning="state == 'a_valider'" decoration-success="state in ('approuvee', 'poste_ouvert')"/></list></field>
</record>
<record id="view_ka_rh_candidature_form" model="ir.ui.view">
    <field name="name">ka.rh.candidature.ka.form</field>
    <field name="model">ka.rh.candidature</field>
    <field name="arch" type="xml">
        <form string="Candidature" class="o_ka_form">
            <header><button string="Refuser" name="action_refuser" type="object" class="btn-secondary" invisible="stage in ('recrutee', 'refusee')"/><button string="Planifier un entretien" name="action_planifier_entretien" type="object" class="btn-secondary" invisible="stage in ('recrutee', 'refusee', 'proposition')"/><button string="Faire une offre" name="action_offre" type="object" class="btn-primary" invisible="stage not in ('entretien', 'test')"/><button string="Test technique" name="action_test" type="object" class="btn-secondary" invisible="stage != 'entretien'"/><button string="Recruter" name="action_recruter" type="object" class="btn-primary" invisible="stage != 'proposition'"/><field name="stage" widget="statusbar" statusbar_visible="nouvelle,preselection,entretien,test,proposition,recrutee" options="{'clickable': '1'}"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_employe" type="object" class="oe_stat_button" invisible="not employe_id"><div class="o_stat_info"><span class="o_stat_value"><field name="employe_id"/></span><span class="o_stat_text">Dossier employé</span></div></button></div><div class="oe_title"><h1><span class="o_ka_title_tag"><field name="titre" readonly="1"/><field name="reference" widget="badge" class="ms-3"/></span></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><group><group><field name="name" string="Candidat"/><field name="demande_id" string="Demande de personnel"/></group><group></group></group><notebook><page string="Candidature" name="candidature"><group><group><field name="coordonnees" string="Coordonnées" invisible="not coordonnees"/><field name="email" string="Courriel"/><field name="telephone" string="Téléphone"/><field name="source" string="Source de la candidature"/><field name="cv" string="CV et documents" filename="cv_nom"/><field name="cv_nom" invisible="1"/><field name="diplome" string="Diplôme / niveau"/><field name="pretention" string="Prétention salariale"/><field name="entretien_date" string="Entretien planifié"/></group><group></group></group><div class="o_ka_h3">Grille d'évaluation</div><field name="evaluation_ids" nolabel="1"><list editable="bottom"><field name="critere" string="Critère"/><field name="note" string="Note"/><field name="commentaire" string="Commentaire"/></list></field><div class="o_ka_info o_ka_noicon"><span class="o_ka_info_t">Prochaine étape</span><field name="prochaine_etape" nolabel="1" placeholder="Ex. Test technique programmé le …"/></div></page><page string="Entretiens" name="entretiens"><group><group><field name="entretien_date" string="Entretien planifié"/><field name="type_contrat" string="Type de contrat proposé"/><field name="salaire_propose" string="Rémunération proposée"/><field name="essai_mois" string="Période d'essai (mois)"/></group><group></group></group></page><page string="Documents" name="documents"><group><group><field name="cv" string="CV et lettre de motivation" filename="cv_nom"/><field name="motif_refus" string="Motif de refus"/></group><group></group></group></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_rh_candidature_list" model="ir.ui.view">
    <field name="name">ka.rh.candidature.ka.list</field>
    <field name="model">ka.rh.candidature</field>
    <field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="poste"/><field name="demande_id"/><field name="source"/><field name="entretien_date"/><field name="stage" widget="badge"/></list></field>
</record>
<record id="view_ka_rh_candidature_kanban" model="ir.ui.view">
    <field name="name">ka.rh.candidature.ka.kanban</field>
    <field name="model">ka.rh.candidature</field>
    <field name="arch" type="xml"><kanban default_group_by="stage"><templates><t t-name="card"><div><field name="name" class="fw-bold"/></div><div><field name="poste"/></div><div class="text-muted"><field name="reference"/> · <field name="source"/></div></t></templates></kanban></field>
</record>
<record id="view_ka_rh_candidature_search" model="ir.ui.view">
    <field name="name">ka.rh.candidature.ka.search</field>
    <field name="model">ka.rh.candidature</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="demande_id"/><field name="reference"/><filter name="en_cours" string="En cours" domain="[('stage', 'not in', ('recrutee', 'refusee'))]"/><filter name="entretiens" string="Entretiens" domain="[('stage', '=', 'entretien')]"/><filter name="g_poste" string="Poste" context="{'group_by': 'demande_id'}"/><filter name="g_etape" string="Étape" context="{'group_by': 'stage'}"/></search></field>
</record>
<record id="action_ka_rh_dp" model="ir.actions.act_window"><field name="name">Demandes de personnel</field><field name="res_model">ka.rh.demande.personnel</field><field name="view_mode">list,form</field></record><record id="action_ka_rh_dp_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_dp"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_dp_list"/></record><record id="action_ka_rh_dp_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_dp"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_dp_form"/></record>
<record id="action_ka_rh_postes" model="ir.actions.act_window"><field name="name">Postes</field><field name="res_model">ka.rh.demande.personnel</field><field name="view_mode">list,form</field><field name="domain">[('state', 'in', ('approuvee', 'poste_ouvert', 'pourvu'))]</field></record><record id="action_ka_rh_postes_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_postes"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_dp_list"/></record><record id="action_ka_rh_postes_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_postes"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_dp_form"/></record>
<record id="action_ka_rh_candidature" model="ir.actions.act_window"><field name="name">Candidatures</field><field name="res_model">ka.rh.candidature</field><field name="view_mode">kanban,list,form</field><field name="context">{'search_default_en_cours': 1}</field><field name="search_view_id" ref="view_ka_rh_candidature_search"/></record><record id="action_ka_rh_candidature_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_candidature"/><field name="sequence">1</field><field name="view_mode">kanban</field><field name="view_id" ref="view_ka_rh_candidature_kanban"/></record><record id="action_ka_rh_candidature_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_candidature"/><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_candidature_list"/></record><record id="action_ka_rh_candidature_v2" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_candidature"/><field name="sequence">3</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_candidature_form"/></record>
<record id="action_ka_rh_cand_entretiens" model="ir.actions.act_window"><field name="name">Entretiens</field><field name="res_model">ka.rh.candidature</field><field name="view_mode">list,form</field><field name="context">{'search_default_entretiens': 1}</field><field name="search_view_id" ref="view_ka_rh_candidature_search"/></record><record id="action_ka_rh_cand_entretiens_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_cand_entretiens"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_candidature_list"/></record><record id="action_ka_rh_cand_entretiens_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_cand_entretiens"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_candidature_form"/></record>
</odoo>
