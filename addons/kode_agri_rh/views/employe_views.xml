<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rh_employe_form" model="ir.ui.view">
    <field name="name">ka.rh.employe.ka.form</field>
    <field name="model">ka.rh.employe</field>
    <field name="arch" type="xml">
        <form string="Fiche employé et contrat" class="o_ka_form">
            <header><button string="Nouveau" name="action_creer" type="object" class="btn-primary"/><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Générer contrat" name="action_generer_contrat" type="object" class="btn-secondary"/><button string="Activer" name="action_activer" type="object" class="btn-secondary" invisible="state != 'brouillon'"/><button string="Sortie du personnel" name="action_sortir" type="object" class="btn-secondary" invisible="state != 'actif'" confirm="Confirmer la sortie du collaborateur ?"/><field name="state" widget="statusbar" statusbar_visible="brouillon,actif,sorti"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_bulletins" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="nb_bulletins"/></span><span class="o_stat_text">Bulletins</span></div></button><button name="action_open_demandes" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="nb_demandes"/></span><span class="o_stat_text">Demandes</span></div></button></div><div class="oe_title"><h1><field name="poste"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><group><group><field name="matricule" string="Matricule" readonly="1"/><field name="poste" string="Poste"/><field name="affectation_id" string="Affectation"/><field name="name" string="Nom et prénoms"/></group><group><field name="type_contrat" string="Type contrat" widget="badge" invisible="state == 'brouillon'"/><field name="type_contrat" string="Type contrat" invisible="state != 'brouillon'"/><field name="date_entree" string="Date entrée"/><field name="analytic_id" string="Compte analytique"/><field name="categorie_id" string="Catégorie professionnelle"/></group></group><notebook><page string="Contrat" name="contrat"><div class="o_ka_h3">Éléments de rémunération</div><field name="element_ids" nolabel="1"><list editable="bottom"><field name="rubrique_id" string="Rubrique"/><field name="type" string="Type"/><field name="montant" string="Montant" sum="Total"/></list></field><group><group><field name="contrat_ref" string="Contrat"/><field name="essai_mois" string="Période d'essai (mois)"/><field name="date_fin_essai" string="Fin de période d'essai"/></group><group><field name="date_fin_contrat" string="Fin de contrat (CDD)" invisible="type_contrat != 'cdd'"/><field name="visite_medicale" string="Certificat d'aptitude (visite médicale)"/><field name="date_sortie" string="Date de sortie" invisible="state != 'sorti'"/></group></group></page><page string="Rémunération" name="remuneration"><group><group><field name="salaire_base" string="Salaire de base"/><field name="taux_horaire" string="Taux horaire"/><field name="banque" string="Compte bancaire / mobile money"/></group><group><field name="situation" string="Situation familiale"/><field name="nb_enfants" string="Enfants à charge"/><field name="parts" string="Parts (RICF)"/></group></group></page><page string="Affectation analytique" name="analytique"><group><group><field name="affectation_id" string="Affectation"/><field name="analytic_id" string="Compte analytique"/><field name="responsable" string="Responsable hiérarchique"/></group><group><field name="horaire_hebdo" string="Horaire théorique hebdomadaire"/><field name="badge" string="Badge de pointage"/><field name="pin" string="Code PIN" password="True"/><field name="telephone" string="Téléphone"/><field name="anciennete_txt" string="Ancienneté"/></group></group></page><page string="Compétences" name="competences"><field name="competence_ids" nolabel="1"><list editable="bottom"><field name="competence_id"/><field name="niveau"/><field name="date"/><field name="origine"/></list></field></page><page string="Congés" name="conges"><field name="solde_ids" nolabel="1" readonly="1"><list><field name="type_id"/><field name="acquis"/><field name="pris"/><field name="solde"/></list></field></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_rh_employe_list" model="ir.ui.view">
    <field name="name">ka.rh.employe.ka.list</field>
    <field name="model">ka.rh.employe</field>
    <field name="arch" type="xml"><list><field name="matricule"/><field name="name"/><field name="poste"/><field name="affectation_id"/><field name="type_contrat"/><field name="date_entree"/><field name="salaire_base" sum="Masse salariale"/><field name="state" widget="badge" decoration-success="state == 'actif'" decoration-muted="state == 'sorti'"/></list></field>
</record>
<record id="view_ka_rh_contrat_list" model="ir.ui.view">
    <field name="name">ka.rh.employe.ka.list</field>
    <field name="model">ka.rh.employe</field>
    <field name="arch" type="xml"><list><field name="matricule"/><field name="name"/><field name="contrat_ref"/><field name="type_contrat"/><field name="categorie_id"/><field name="date_entree"/><field name="date_fin_essai"/><field name="date_fin_contrat"/><field name="visite_medicale"/><field name="state" widget="badge"/></list></field>
</record>
<record id="view_ka_rh_employe_search" model="ir.ui.view">
    <field name="name">ka.rh.employe.ka.search</field>
    <field name="model">ka.rh.employe</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="matricule"/><field name="poste"/><field name="affectation_id"/><filter name="actifs" string="Actifs" domain="[('state', '=', 'actif')]"/><filter name="essai" string="En période d'essai" domain="[('date_fin_essai', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/><filter name="g_aff" string="Affectation" context="{'group_by': 'affectation_id'}"/></search></field>
</record>
<record id="view_ka_rh_employe_pivot" model="ir.ui.view">
    <field name="name">ka.rh.employe.ka.pivot</field>
    <field name="model">ka.rh.employe</field>
    <field name="arch" type="xml"><pivot><field name="affectation_id" type="row"/><field name="type_contrat" type="col"/><field name="salaire_base" type="measure"/></pivot></field>
</record>
<record id="action_ka_rh_employe" model="ir.actions.act_window"><field name="name">Employés</field><field name="res_model">ka.rh.employe</field><field name="view_mode">list,form</field><field name="context">{'search_default_actifs': 1}</field><field name="search_view_id" ref="view_ka_rh_employe_search"/></record><record id="action_ka_rh_employe_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_employe"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_employe_list"/></record><record id="action_ka_rh_employe_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_employe"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_employe_form"/></record>
<record id="action_ka_rh_contrat" model="ir.actions.act_window"><field name="name">Contrats</field><field name="res_model">ka.rh.employe</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_rh_employe_search"/></record><record id="action_ka_rh_contrat_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_contrat"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_contrat_list"/></record><record id="action_ka_rh_contrat_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_contrat"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_rh_employe_form"/></record>
<record id="action_ka_rh_effectifs" model="ir.actions.act_window"><field name="name">Effectifs et masse salariale</field><field name="res_model">ka.rh.employe</field><field name="view_mode">pivot,list</field><field name="context">{'search_default_actifs': 1}</field></record><record id="action_ka_rh_effectifs_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_effectifs"/><field name="sequence">1</field><field name="view_mode">pivot</field><field name="view_id" ref="view_ka_rh_employe_pivot"/></record><record id="action_ka_rh_effectifs_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_rh_effectifs"/><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_rh_employe_list"/></record>
</odoo>
