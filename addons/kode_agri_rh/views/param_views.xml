<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_rh_rubrique_form" model="ir.ui.view">
    <field name="name">ka.rh.rubrique.ka.form</field>
    <field name="model">ka.rh.rubrique</field>
    <field name="arch" type="xml">
        <form string="Rubrique de paie" class="o_ka_form">
            
            <sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code" string="Code"/><field name="nature" string="Nature"/><field name="categorie" string="Catégorie"/><field name="mode" string="Mode de calcul"/><field name="base" string="Base de calcul"/><field name="sequence" string="Séquence"/></group><group><field name="soumis_cnps" string="Soumis CNPS"/><field name="soumis_its" string="Soumis ITS"/><field name="affiche" string="Affichée sur le bulletin"/><field name="compte_code" string="Compte"/><field name="taux" string="Taux en vigueur"/><field name="plafond" string="Plafond en vigueur"/></group></group><div class="o_ka_info">Toute modification de taux, de montant ou de plafond se fait par une nouvelle ligne datée : les bulletins déjà confirmés ne sont jamais recalculés avec la nouvelle valeur (RG-7.4).</div><div class="o_ka_h3">Valeurs historisées</div><field name="valeur_ids" nolabel="1"><list editable="bottom"><field name="date_effet"/><field name="taux"/><field name="montant"/><field name="plafond"/></list></field>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_rh_rubrique_list" model="ir.ui.view">
    <field name="name">ka.rh.rubrique.ka.list</field>
    <field name="model">ka.rh.rubrique</field>
    <field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="nature"/><field name="categorie"/><field name="mode"/><field name="taux"/><field name="plafond"/><field name="soumis_cnps"/><field name="soumis_its"/><field name="affiche"/></list></field>
</record>
