<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_mnt_equipement_form" model="ir.ui.view">
    <field name="name">ka.mnt.equipement.ka.form</field>
    <field name="model">ka.mnt.equipement</field>
    <field name="arch" type="xml">
        <form string="Fiche machine" class="o_ka_form">
            <header><button string="Nouveau" name="action_creer" type="object" class="btn-primary"/><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Créer un OT" name="action_creer_ot" type="object" class="btn-secondary"/><button string="Relevé de compteur" name="action_releve" type="object" class="btn-secondary"/><button string="Mettre à l'arrêt" name="action_arreter" type="object" class="btn-secondary" invisible="state != 'service'"/><button string="Remettre en service" name="action_remettre_en_service" type="object" class="btn-secondary" invisible="state != 'arret'"/><button string="Réformer" name="action_reformer" type="object" class="btn-secondary" invisible="state == 'reforme'" confirm="Réformer définitivement l'équipement ?"/><field name="state" widget="statusbar" statusbar_visible="service,arret,reforme"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_releve" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="heures_txt"/></span><span class="o_stat_text">Heures marche</span></div></button><button name="action_open_ots" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="criticite_txt"/></span><span class="o_stat_text">Criticité</span></div></button></div><field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/><div class="oe_title"><h1><field name="name"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info">Équipement rattaché à un poste de charge (module 4) et à son immobilisation (module 3). Compteurs : base des plans préventifs.</div><group><group><field name="code" string="Code équipement"/><field name="designation" string="Désignation"/><field name="atelier" string="Atelier"/><field name="workcenter_id" string="Poste de charge"/><field name="criticite" string="Criticité" widget="badge" decoration-danger="criticite == 'critique'" decoration-warning="criticite == 'important'"/></group><group><field name="marque_modele" string="Marque / modèle" invisible="not marque_modele"/><field name="mise_en_service" string="Mise en service"/><field name="immo_id" string="Immobilisation"/><field name="compteur_heures" string="Compteur heures" readonly="1"/><field name="state" string="Statut" widget="badge" decoration-success="state == 'service'" decoration-danger="state == 'arret'" decoration-muted="state == 'reforme'"/></group></group><notebook><page string="Plans préventifs" name="plans"><div class="o_ka_h3">Plans de maintenance préventive de l'équipement</div><field name="plan_ids" nolabel="1" readonly="1"><list><field name="intitule" string="Plan"/><field name="declencheur" string="Déclencheur"/><field name="periodicite_txt" string="Périodicité"/><field name="prochaine_txt" string="Prochaine échéance" decoration-warning="proche"/><field name="proche" column_invisible="1"/><field name="state" column_invisible="1"/></list></field></page><page string="Sous-ensembles" name="sous_ensembles"><field name="child_ids" nolabel="1"><list><field name="code"/><field name="name"/><field name="niveau"/><field name="criticite" widget="badge"/><field name="state"/></list></field></page><page string="Documents" name="documents"><group><group><field name="numero_serie" string="Numéro de série constructeur"/><field name="fournisseur_id" string="Fournisseur"/><field name="garantie_fin" string="Fin de garantie"/><field name="contrat_ids" string="Contrats de maintenance" widget="many2many_tags"/></group><group><field name="puissance" string="Puissance"/><field name="capacite" string="Capacité"/></group></group><div class="o_ka_info">Manuels, plans, garanties et contrats : pièces jointes de la fiche (trombone du fil de discussion).</div></page><page string="Identification" name="identification"><group><group><field name="marque" string="Marque"/><field name="modele" string="Modèle"/><field name="niveau" string="Niveau"/><field name="parent_id" string="Rattaché à"/><field name="ligne" string="Ligne de production"/><field name="site_id" string="Site"/></group><group><field name="analytic_id" string="Compte analytique équipement"/><field name="equipe_id" string="Équipe de maintenance"/><field name="compteur_tonnage" string="Tonnage traité (t)"/><field name="compteur_cycles" string="Cycles"/></group></group></page><page string="Compteurs" name="compteurs"><field name="releve_ids" nolabel="1" readonly="1"><list><field name="date"/><field name="type"/><field name="valeur"/><field name="origine"/></list></field></page><page string="Fiabilité" name="fiabilite"><group><group><field name="disponibilite" string="Taux de disponibilité (%)"/><field name="mtbf" string="MTBF (h)"/><field name="mttr" string="MTTR (h)"/></group><group><field name="ratio_preventif" string="Préventif / total (%)"/><field name="cout_maintenance" string="Coût de maintenance (12 mois)"/><field name="prochaine_panne" string="Prochaine panne prévisionnelle"/></group></group><div class="o_ka_h3">Historique des interventions (carnet de santé)</div><field name="ot_ids" nolabel="1" readonly="1"><list><field name="name"/><field name="date_demande"/><field name="type"/><field name="objet"/><field name="duree_arret"/><field name="cout_total" sum="Total"/><field name="state" widget="badge"/></list></field></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_mnt_equipement_list" model="ir.ui.view">
    <field name="name">ka.mnt.equipement.ka.list</field>
    <field name="model">ka.mnt.equipement</field>
    <field name="arch" type="xml"><list><field name="complete_code" string="Arborescence" optional="hide"/><field name="code"/><field name="name"/><field name="designation"/><field name="atelier"/><field name="ligne"/><field name="workcenter_id"/><field name="immo_id"/><field name="compteur_heures"/><field name="criticite" widget="badge" decoration-danger="criticite == 'critique'" decoration-warning="criticite == 'important'"/><field name="state" widget="badge" decoration-success="state == 'service'" decoration-danger="state == 'arret'"/></list></field>
</record>
<record id="view_ka_mnt_fiabilite_list" model="ir.ui.view">
    <field name="name">ka.mnt.equipement.ka.list</field>
    <field name="model">ka.mnt.equipement</field>
    <field name="arch" type="xml"><list create="0"><field name="code"/><field name="name"/><field name="atelier"/><field name="criticite" widget="badge" decoration-danger="criticite == 'critique'" decoration-warning="criticite == 'important'"/><field name="nb_ot" string="Interventions"/><field name="disponibilite"/><field name="mtbf"/><field name="mttr"/><field name="ratio_preventif"/><field name="cout_maintenance"/><field name="prochaine_panne"/></list></field>
</record>
<record id="view_ka_mnt_equipement_search" model="ir.ui.view">
    <field name="name">ka.mnt.equipement.ka.search</field>
    <field name="model">ka.mnt.equipement</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="atelier"/><field name="workcenter_id"/><filter name="machines" string="Machines" domain="[('niveau', '=', 'machine')]"/><filter name="critiques" string="Critiques" domain="[('criticite', '=', 'critique')]"/><filter name="arret" string="À l'arrêt" domain="[('state', '=', 'arret')]"/><filter name="g_atelier" string="Atelier" context="{'group_by': 'atelier'}"/><filter name="g_niveau" string="Niveau" context="{'group_by': 'niveau'}"/></search></field>
</record>
<record id="view_ka_mnt_releve_form" model="ir.ui.view">
    <field name="name">ka.mnt.releve.ka.form</field>
    <field name="model">ka.mnt.releve</field>
    <field name="arch" type="xml">
        <form string="Relevé de compteur" class="o_ka_form">
            
            <sheet>
                <group><group><field name="equipement_id" string="Équipement"/><field name="type" string="Compteur"/><field name="valeur" string="Valeur relevée"/><field name="date" string="Date"/></group><group></group></group>
            </sheet>
        </form>
    </field>
</record>
<record id="view_ka_mnt_releve_list" model="ir.ui.view">
    <field name="name">ka.mnt.releve.ka.list</field>
    <field name="model">ka.mnt.releve</field>
    <field name="arch" type="xml"><list><field name="date"/><field name="equipement_id"/><field name="type"/><field name="valeur"/><field name="origine"/></list></field>
</record>
<record id="action_ka_mnt_equipement" model="ir.actions.act_window"><field name="name">Équipements</field><field name="res_model">ka.mnt.equipement</field><field name="view_mode">list,form</field><field name="context">{'search_default_machines': 1}</field><field name="search_view_id" ref="view_ka_mnt_equipement_search"/></record><record id="action_ka_mnt_equipement_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_equipement"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_equipement_list"/></record><record id="action_ka_mnt_equipement_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_equipement"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_equipement_form"/></record>
<record id="action_ka_mnt_fiabilite" model="ir.actions.act_window"><field name="name">Tableau de bord fiabilité</field><field name="res_model">ka.mnt.equipement</field><field name="view_mode">list,form</field><field name="context">{'search_default_machines': 1}</field><field name="search_view_id" ref="view_ka_mnt_equipement_search"/></record><record id="action_ka_mnt_fiabilite_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_fiabilite"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_fiabilite_list"/></record><record id="action_ka_mnt_fiabilite_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_fiabilite"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_equipement_form"/></record>
<record id="action_ka_mnt_releve" model="ir.actions.act_window"><field name="name">Relevés de compteur</field><field name="res_model">ka.mnt.releve</field><field name="view_mode">list,form</field></record>
</odoo>
