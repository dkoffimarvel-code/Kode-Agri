<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_mnt_demande_form" model="ir.ui.view">
    <field name="name">ka.mnt.demande.ka.form</field>
    <field name="model">ka.mnt.demande</field>
    <field name="arch" type="xml">
        <form string="Demande d'intervention" class="o_ka_form">
            <header><button string="Convertir en ordre de travail" name="action_convertir" type="object" class="btn-primary" invisible="state not in ('nouvelle', 'qualification')"/><button string="Traiter en urgence" name="action_urgence" type="object" class="btn-secondary o_ka_btn_danger" invisible="state not in ('nouvelle', 'qualification')"/><button string="Qualifier" name="action_qualifier" type="object" class="btn-secondary" invisible="state != 'nouvelle'"/><field name="state" widget="statusbar" statusbar_visible="nouvelle,qualification,ot,cloture"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_historique" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="nb_interventions"/></span><span class="o_stat_text">Interventions passées</span></div></button><button name="action_open_equipement" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="criticite_txt"/></span><span class="o_stat_text">Criticité équipement</span></div></button><button name="action_open_ot" type="object" class="oe_stat_button" invisible="not ot_id"><div class="o_stat_info"><span class="o_stat_value"><field name="ot_id"/></span><span class="o_stat_text">Ordre de travail</span></div></button></div><div class="oe_title"><h1><field name="titre"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><group><group><field name="equipement_id" string="Équipement"/><field name="workcenter_id" string="Poste de charge"/><field name="sous_ensemble_id" string="Sous-ensemble"/><field name="criticite" string="Criticité" widget="badge" decoration-danger="criticite == 'critique'" decoration-warning="criticite == 'important'"/><field name="etat_equipement" string="État équipement" widget="badge" decoration-danger="etat_equipement == 'arret_total'" decoration-warning="etat_equipement == 'degrade'" invisible="state == 'nouvelle'"/><field name="etat_equipement" string="État équipement" invisible="state != 'nouvelle'"/></group><group><field name="type" string="Type de maintenance" widget="badge" invisible="state == 'nouvelle'"/><field name="type" string="Type de maintenance" invisible="state != 'nouvelle'"/><field name="equipe_id" string="Équipe de maintenance"/><field name="technicien_id" string="Technicien"/><field name="priorite" string="Priorité" widget="priority"/><field name="ot_id" string="Référence OT"/><field name="canal" string="Canal" invisible="state != 'nouvelle'"/></group></group><notebook><page string="Description" name="description"><group><group><field name="nature_panne" string="Nature de la panne"/><field name="description" string="Description détaillée"/></group><group></group></group></page><page string="Qualification" name="qualification"><group><group><field name="qualification" string="Diagnostic du responsable maintenance"/><field name="urgence" string="Traitée en urgence"/></group><group></group></group></page><page string="Pièces jointes" name="pj"><div class="o_ka_info">Photos et documents joints à la demande : trombone du fil de discussion (y compris depuis l'application mobile).</div><group><group><field name="nb_pj" string="Pièces jointes"/></group><group></group></group></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_mnt_demande_list" model="ir.ui.view">
    <field name="name">ka.mnt.demande.ka.list</field>
    <field name="model">ka.mnt.demande</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="titre"/><field name="equipement_id"/><field name="criticite" widget="badge" decoration-danger="criticite == 'critique'" decoration-warning="criticite == 'important'"/><field name="etat_equipement"/><field name="priorite" widget="priority"/><field name="demandeur_id"/><field name="ot_id"/><field name="state" widget="badge" decoration-warning="state == 'qualification'" decoration-success="state == 'cloture'"/></list></field>
</record>
<record id="view_ka_mnt_demande_search" model="ir.ui.view">
    <field name="name">ka.mnt.demande.ka.search</field>
    <field name="model">ka.mnt.demande</field>
    <field name="arch" type="xml"><search><field name="titre"/><field name="equipement_id"/><field name="name"/><filter name="ouvertes" string="À traiter" domain="[('state', 'in', ('nouvelle', 'qualification'))]"/><filter name="g_eq" string="Équipement" context="{'group_by': 'equipement_id'}"/></search></field>
</record>
<record id="action_ka_mnt_demande" model="ir.actions.act_window"><field name="name">Demandes de maintenance</field><field name="res_model">ka.mnt.demande</field><field name="view_mode">list,form</field><field name="context">{'search_default_ouvertes': 1}</field><field name="search_view_id" ref="view_ka_mnt_demande_search"/></record><record id="action_ka_mnt_demande_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_demande"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_demande_list"/></record><record id="action_ka_mnt_demande_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_demande"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_demande_form"/></record>
</odoo>
