<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_mnt_ot_form" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.form</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml">
        <form string="Ordre de travail" class="o_ka_form">
            <header><button string="Planifier" name="action_planifier" type="object" class="btn-secondary" invisible="state not in ('demande', 'attente_piece')"/><button string="Démarrer" name="action_demarrer" type="object" class="btn-secondary" invisible="state not in ('demande', 'planifie')"/><button string="Clôturer" name="action_cloturer" type="object" class="btn-primary" invisible="state not in ('planifie', 'en_cours')"/><button string="Demander pièce" name="action_demander_piece" type="object" class="btn-secondary" invisible="state in ('cloture', 'annule')"/><button string="Externaliser" name="action_externaliser" type="object" class="btn-secondary" invisible="state in ('cloture', 'annule') or commande_id"/><button string="Annuler" name="action_annuler" type="object" class="btn-secondary" invisible="state in ('cloture', 'annule')"/><field name="state" widget="statusbar" statusbar_visible="demande,planifie,en_cours,cloture"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_machine" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="type_txt"/></span><span class="o_stat_text">Type</span></div></button><button name="action_open_machine" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="priorite_txt"/></span><span class="o_stat_text">Priorité</span></div></button><button name="action_open_commande" type="object" class="oe_stat_button" invisible="not commande_id"><div class="o_stat_info"><span class="o_stat_value"><field name="commande_id"/></span><span class="o_stat_text">Commande</span></div></button><button name="action_open_da" type="object" class="oe_stat_button" invisible="not da_id or commande_id"><div class="o_stat_info"><span class="o_stat_value"><field name="da_id"/></span><span class="o_stat_text">Demande d'achat</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info"><field name="info_txt" nolabel="1" readonly="1"/></div><group><group><field name="equipement_id" string="Équipement"/><field name="sous_ensemble_id" string="Sous-ensemble"/><field name="objet" string="Objet"/><field name="type" string="Type" widget="badge" invisible="state == 'demande'" decoration-warning="type == 'correctif'" decoration-info="type == 'preventif'"/><field name="type" string="Type" invisible="state != 'demande'"/><field name="priorite" string="Priorité" widget="badge" invisible="state == 'demande'" decoration-danger="priorite == 'critique'" decoration-warning="priorite == 'haute'"/><field name="priorite" string="Priorité" invisible="state != 'demande'"/></group><group><field name="technicien_id" string="Technicien"/><field name="date_demande" string="Date demande"/><field name="fenetre_txt" string="Fenêtre d'arrêt" invisible="not fenetre_txt"/><field name="fenetre_debut" string="Fenêtre d'arrêt — début" invisible="state not in ('demande', 'planifie')"/><field name="fenetre_fin" string="Fenêtre d'arrêt — fin" invisible="state not in ('demande', 'planifie')"/><field name="duree_arret" string="Durée d'arrêt (h)" widget="float_time"/><field name="equipe_id" string="Équipe"/></group></group><notebook><page string="Main-d'œuvre &amp; pièces" name="mo"><div class="o_ka_h3">Main-d'œuvre et pièces consommées</div><field name="ligne_ids" nolabel="1"><list editable="bottom"><field name="type" string="Type"/><field name="ligne" string="Ligne" readonly="1"/><field name="detail" string="Détail"/><field name="technicien_id" string="Technicien" optional="hide"/><field name="product_id" string="Pièce" optional="show"/><field name="quantite" string="Quantité"/><field name="prix_unitaire" string="Prix / taux" optional="hide"/><field name="cout" string="Coût"/></list></field><div class="o_ka_totalbar"><span>Coût de l'OT</span><field name="cout_txt" nolabel="1" readonly="1"/></div></page><page string="Cause / remède" name="cause"><group><group><field name="cause" string="Cause"/><field name="remede" string="Remède"/><field name="observations" string="Observations"/></group><group><field name="compteur_cloture" string="Compteur à la clôture (h)"/><field name="duree_estimee" string="Durée estimée (h)"/><field name="plan_id" string="Plan préventif"/><field name="demande_id" string="Demande d'intervention"/></group></group></page><page string="Sous-traitance" name="st"><group><group><field name="externe" string="Intervention externe"/><field name="contrat_id" string="Contrat de maintenance"/><field name="prestataire_id" string="Prestataire"/></group><group><field name="da_id" string="Demande d'achat"/><field name="ao_id" string="Appel d'offre"/><field name="commande_id" string="Commande"/><field name="commande_state" string="Statut de la commande"/><field name="facture_txt" string="Facturation"/></group></group><div class="o_ka_info">Sans contrat : demande d'achat → appel d'offre → commande ; prestataire sous contrat : demande d'achat pré-remplie → commande ; la clôture de l'OT vaut réception de la prestation et autorise la facturation (RG-10.3).</div></page></notebook><div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Clôture : remise en service de l'équipement, mise à jour des compteurs et de l'historique (carnet de santé), coût imputé à l'équipement et au coût d'usinage (module 9).</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_mnt_ot_list" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.list</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="date_demande"/><field name="machine_id" string="Équipement"/><field name="objet"/><field name="type" widget="badge" decoration-warning="type == 'correctif'" decoration-info="type == 'preventif'"/><field name="priorite" widget="badge" decoration-danger="priorite == 'critique'" decoration-warning="priorite == 'haute'"/><field name="technicien_id"/><field name="externe" optional="hide"/><field name="duree_arret" widget="float_time" sum="Total"/><field name="cout_total" sum="Total"/><field name="state" widget="badge" decoration-success="state == 'cloture'" decoration-warning="state == 'attente_piece'" decoration-info="state in ('planifie', 'en_cours')"/></list></field>
</record>
<record id="view_ka_mnt_ot_search" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.search</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="machine_id" string="Équipement"/><field name="technicien_id"/><field name="contrat_id"/><filter name="ouverts" string="Ouverts" domain="[('state', 'not in', ('cloture', 'annule'))]"/><filter name="correctifs" string="Correctifs" domain="[('type', '=', 'correctif')]"/><filter name="preventifs" string="Préventifs" domain="[('type', '=', 'preventif')]"/><filter name="externes" string="Externalisés" domain="[('externe', '=', True)]"/><filter name="attente" string="En attente de pièce" domain="[('state', '=', 'attente_piece')]"/><filter name="g_eq" string="Équipement" context="{'group_by': 'machine_id'}"/><filter name="g_type" string="Type" context="{'group_by': 'type'}"/><filter name="g_mois" string="Mois" context="{'group_by': 'date_demande:month'}"/></search></field>
</record>
<record id="view_ka_mnt_ot_pivot" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.pivot</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml"><pivot><field name="machine_id" type="row"/><field name="date_demande" interval="month" type="col"/><field name="cout_total" type="measure"/><field name="cout_mo" type="measure"/><field name="cout_pieces" type="measure"/><field name="cout_st" type="measure"/></pivot></field>
</record>
<record id="view_ka_mnt_ot_calendar" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.calendar</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml"><calendar date_start="fenetre_debut" date_stop="fenetre_fin" color="technicien_id" mode="week" quick_create="0"><field name="machine_id"/><field name="technicien_id"/><field name="type"/></calendar></field>
</record>
<record id="view_ka_mnt_ot_externe_list" model="ir.ui.view">
    <field name="name">ka.mnt.ot.ka.list</field>
    <field name="model">ka.mnt.ot</field>
    <field name="arch" type="xml"><list create="0"><field name="name"/><field name="machine_id" string="Équipement"/><field name="prestataire_id"/><field name="contrat_id"/><field name="da_id"/><field name="ao_id"/><field name="commande_id"/><field name="commande_state"/><field name="facture_txt"/><field name="cout_st" sum="Total"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_mnt_ot" model="ir.actions.act_window"><field name="name">Ordres de travail</field><field name="res_model">ka.mnt.ot</field><field name="view_mode">list,form,calendar,pivot</field><field name="context">{'search_default_ouverts': 1}</field><field name="search_view_id" ref="view_ka_mnt_ot_search"/></record><record id="action_ka_mnt_ot_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_ot"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_ot_list"/></record><record id="action_ka_mnt_ot_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_ot"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_ot_form"/></record>
<record id="action_ka_mnt_charge" model="ir.actions.act_window"><field name="name">Plan de charge maintenance</field><field name="res_model">ka.mnt.ot</field><field name="view_mode">calendar,list,form</field><field name="context">{'search_default_ouverts': 1}</field><field name="search_view_id" ref="view_ka_mnt_ot_search"/></record><record id="action_ka_mnt_charge_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_charge"/><field name="sequence">1</field><field name="view_mode">calendar</field><field name="view_id" ref="view_ka_mnt_ot_calendar"/></record><record id="action_ka_mnt_charge_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_charge"/><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_ot_list"/></record>
<record id="action_ka_mnt_historique" model="ir.actions.act_window"><field name="name">Historique par équipement</field><field name="res_model">ka.mnt.ot</field><field name="view_mode">list,form</field><field name="context">{'search_default_g_eq': 1}</field><field name="search_view_id" ref="view_ka_mnt_ot_search"/></record><record id="action_ka_mnt_historique_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_historique"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_ot_list"/></record><record id="action_ka_mnt_historique_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_historique"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_ot_form"/></record>
<record id="action_ka_mnt_couts" model="ir.actions.act_window"><field name="name">Coûts de maintenance</field><field name="res_model">ka.mnt.ot</field><field name="view_mode">pivot,list</field><field name="domain">[('state', '=', 'cloture')]</field><field name="search_view_id" ref="view_ka_mnt_ot_search"/></record><record id="action_ka_mnt_couts_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_couts"/><field name="sequence">1</field><field name="view_mode">pivot</field><field name="view_id" ref="view_ka_mnt_ot_pivot"/></record><record id="action_ka_mnt_couts_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_couts"/><field name="sequence">2</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_ot_list"/></record>
<record id="action_ka_mnt_externes" model="ir.actions.act_window"><field name="name">Suivi des OT externalisés et des factures</field><field name="res_model">ka.mnt.ot</field><field name="view_mode">list,form</field><field name="domain">[('externe', '=', True)]</field><field name="search_view_id" ref="view_ka_mnt_ot_search"/></record><record id="action_ka_mnt_externes_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_externes"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_ot_externe_list"/></record><record id="action_ka_mnt_externes_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_externes"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_ot_form"/></record>
</odoo>
