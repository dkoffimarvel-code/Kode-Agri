<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_mnt_contrat_list" model="ir.ui.view">
    <field name="name">ka.mnt.contrat.ka.list</field>
    <field name="model">ka.mnt.contrat</field>
    <field name="arch" type="xml"><list><field name="name" string="N° contrat"/><field name="prestataire_id" string="Prestataire"/><field name="perimetre" string="Périmètre"/><field name="type" string="Type"/><field name="tarif_txt" string="Montant / tarif"/><field name="date_fin" string="Échéance"/><field name="state" string="Statut" widget="badge" decoration-success="state == 'actif'" decoration-warning="state == 'a_renouveler'" decoration-danger="state == 'expire'"/></list></field>
</record>
<record id="view_ka_mnt_contrat_search" model="ir.ui.view">
    <field name="name">ka.mnt.contrat.ka.search</field>
    <field name="model">ka.mnt.contrat</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="prestataire_id"/><field name="perimetre"/><filter name="en_vigueur" string="Statut : Actif" domain="[('state', 'in', ('actif', 'a_renouveler', 'expire'))]"/><filter name="a_renouveler" string="À renouveler" domain="[('state', '=', 'a_renouveler')]"/><filter name="g_prest" string="Prestataire" context="{'group_by': 'prestataire_id'}"/></search></field>
</record>
<record id="view_ka_mnt_contrat_form" model="ir.ui.view">
    <field name="name">ka.mnt.contrat.ka.form</field>
    <field name="model">ka.mnt.contrat</field>
    <field name="arch" type="xml">
        <form string="Contrat de maintenance" class="o_ka_form">
            <header><button string="Résilier le contrat" name="action_resilier" type="object" class="btn-secondary o_ka_btn_danger" invisible="state in ('brouillon', 'cloture')" confirm="Résilier ce contrat de maintenance ?"/><button string="Dupliquer pour renouvellement" name="action_renouveler" type="object" class="btn-secondary"/><button string="Générer un OT externalisé" name="action_generer_ot" type="object" class="btn-secondary" invisible="state not in ('actif', 'a_renouveler')"/><button string="Activer" name="action_activer" type="object" class="btn-primary" invisible="state != 'brouillon'"/><button string="Planifier la visite contractuelle" name="action_planifier_visite" type="object" class="btn-secondary" invisible="state != 'actif' or not prochaine_visite"/><field name="state" widget="statusbar" statusbar_visible="brouillon,actif,a_renouveler,cloture"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_ots" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="nb_ot"/></span><span class="o_stat_text">Ordres de travail</span></div></button><button name="action_open_ots" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="cout_txt"/></span><span class="o_stat_text"><field name="cout_label"/></span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="sous_titre" readonly="1"/></div></div><group><group><field name="prestataire_id" string="Prestataire"/><field name="date_debut" string="Date de début"/><field name="date_fin" string="Date de fin"/><field name="reconduction" string="Reconduction tacite"/><field name="contact" string="Contact"/><field name="telephone" string="Téléphone"/></group><group><field name="type" string="Type de contrat" widget="badge" invisible="state == 'brouillon'"/><field name="type" string="Type de contrat" invisible="state != 'brouillon'"/><field name="tarif_txt" string="Tarif" invisible="state == 'brouillon'"/><field name="tarif" string="Montant / tarif" invisible="state != 'brouillon'"/><field name="unite_tarif" string="Unité" invisible="state != 'brouillon'"/><field name="sla" string="Délai garanti (SLA)"/><field name="analytic_id" string="Axe analytique"/></group></group><notebook><page string="Périmètre" name="perimetre"><group><group><field name="perimetre" string="Périmètre"/><field name="periodicite_visite" string="Visites préventives (mois)"/><field name="prochaine_visite" string="Prochaine visite contractuelle"/><field name="product_id" string="Prestation"/></group><group></group></group><field name="equipement_ids" nolabel="1"><list><field name="code"/><field name="name"/><field name="atelier"/><field name="criticite" widget="badge"/></list></field></page><page string="Historique des interventions" name="historique"><field name="ot_ids" nolabel="1" readonly="1"><list><field name="name" string="N° OT"/><field name="date_demande" string="Date"/><field name="machine_id" string="Équipement"/><field name="cout_total" string="Coût"/><field name="state" string="Statut"/></list></field></page><page string="Documents" name="documents"><div class="o_ka_info">Contrat signé, avenants et conditions générales : pièces jointes de la fiche.</div></page></notebook>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="action_ka_mnt_contrat" model="ir.actions.act_window"><field name="name">Contrats de maintenance</field><field name="res_model">ka.mnt.contrat</field><field name="view_mode">list,form</field><field name="context">{'search_default_en_vigueur': 1}</field><field name="search_view_id" ref="view_ka_mnt_contrat_search"/></record><record id="action_ka_mnt_contrat_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_contrat"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_contrat_list"/></record><record id="action_ka_mnt_contrat_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_contrat"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_contrat_form"/></record>
<record id="view_ka_mnt_equipe_list" model="ir.ui.view">
    <field name="name">ka.mnt.equipe.ka.list</field>
    <field name="model">ka.mnt.equipe</field>
    <field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="technicien_ids" widget="many2many_tags"/><field name="taux_horaire"/></list></field>
</record>
<record id="action_ka_mnt_equipe" model="ir.actions.act_window"><field name="name">Équipes de maintenance</field><field name="res_model">ka.mnt.equipe</field><field name="view_mode">list</field></record>
<record id="view_ka_mnt_piece_list" model="ir.ui.view">
    <field name="name">product.product.ka.list</field>
    <field name="model">product.product</field>
    <field name="arch" type="xml"><list decoration-danger="ka_alerte_reappro"><field name="default_code"/><field name="name"/><field name="qty_available" string="En stock"/><field name="ka_stock_mini" string="Stock d'alerte"/><field name="ka_piece_critique" string="Critique"/><field name="standard_price" string="Coût"/></list></field>
</record>
<record id="action_ka_mnt_pieces" model="ir.actions.act_window"><field name="name">Pièces</field><field name="res_model">product.product</field><field name="view_mode">list,form</field><field name="domain">[('ka_piece_mnt', '=', True)]</field><field name="context">{'default_ka_piece_mnt': True, 'default_is_storable': True}</field></record><record id="action_ka_mnt_pieces_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_pieces"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_piece_list"/></record>
<record id="action_ka_mnt_pieces_alerte" model="ir.actions.act_window"><field name="name">Pièces critiques et alertes de réapprovisionnement</field><field name="res_model">product.product</field><field name="view_mode">list,form</field><field name="domain">[('ka_piece_mnt', '=', True), ('ka_alerte_reappro', '=', True)]</field></record><record id="action_ka_mnt_pieces_alerte_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_pieces_alerte"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_piece_list"/></record>
</odoo>
