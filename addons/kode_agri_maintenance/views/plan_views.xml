<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ka_mnt_plan_form" model="ir.ui.view">
    <field name="name">ka.mnt.plan.ka.form</field>
    <field name="model">ka.mnt.plan</field>
    <field name="arch" type="xml">
        <form string="Plan de maintenance préventive" class="o_ka_form">
            <header><button string="Enregistrer" special="save" class="btn-secondary"/><button string="Activer" name="action_activer" type="object" class="btn-primary" invisible="state != 'brouillon'"/><button string="Générer OT à échéance" name="action_generer_ot" type="object" class="btn-secondary" invisible="state != 'actif'"/><field name="state" widget="statusbar" statusbar_visible="brouillon,actif"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_generer_ot" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="periodicite_kpi"/></span><span class="o_stat_text">Périodicité</span></div></button><button name="action_generer_ot" type="object" class="oe_stat_button"><div class="o_stat_info"><span class="o_stat_value"><field name="generation"/></span><span class="o_stat_text">Génération OT</span></div></button></div><div class="oe_title"><h1><field name="titre" readonly="1"/></h1><div class="o_ka_sub"><field name="ka_subtitle" readonly="1"/></div></div><div class="o_ka_info">À l'approche de l'échéance, le système génère automatiquement l'OT préventif avec sa gamme et sa liste de pièces (RG-10.1).</div><group><group><field name="equipement_id" string="Équipement"/><field name="intitule" string="Intitulé"/><field name="declencheur" string="Type de déclencheur" widget="badge" invisible="state == 'brouillon'"/><field name="declencheur" string="Type de déclencheur" invisible="state != 'brouillon'"/><field name="periodicite_txt" string="Périodicité" invisible="state == 'brouillon'" class="fw-bold"/><field name="periodicite" string="Périodicité (compteur)" invisible="state != 'brouillon' or declencheur not in ('heures', 'tonnage', 'cycles')"/><field name="intervalle" string="Intervalle" invisible="state != 'brouillon' or declencheur in ('heures', 'tonnage', 'cycles')"/><field name="unite" string="Unité" invisible="state != 'brouillon' or declencheur in ('heures', 'tonnage', 'cycles')"/></group><group><field name="derniere_txt" string="Dernière exécution"/><field name="prochaine_txt" string="Prochaine échéance" decoration-warning="proche"/><field name="duree_estimee" string="Durée estimée" class="o_ka_u_h"/><field name="proche" invisible="1"/><field name="derniere_valeur" string="Dernière exécution (compteur)" invisible="state != 'brouillon' or declencheur not in ('heures', 'tonnage', 'cycles')"/><field name="derniere_date" string="Dernière exécution (date)" invisible="state != 'brouillon' or declencheur in ('heures', 'tonnage', 'cycles')"/><field name="anticipation" string="Anticipation de génération"/><field name="generation" string="Génération OT"/></group></group><div class="o_ka_h3">Gamme et pièces du plan</div><field name="operation_ids" nolabel="1"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name" string="Opération"/><field name="product_id" string="Pièce / consommable"/><field name="quantite" string="Quantité"/><field name="quantite_txt" string="Quantité" readonly="1" optional="hide"/></list></field><group><group><field name="externe" string="Réalisé par un prestataire"/><field name="contrat_id" string="Contrat de maintenance" invisible="not externe"/></group><group></group></group><div class="o_ka_h3">OT générés</div><field name="ot_ids" nolabel="1" readonly="1"><list><field name="name"/><field name="date_demande"/><field name="technicien_id"/><field name="cout_total"/><field name="state" widget="badge"/></list></field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_mnt_plan_list" model="ir.ui.view">
    <field name="name">ka.mnt.plan.ka.list</field>
    <field name="model">ka.mnt.plan</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="intitule"/><field name="equipement_id"/><field name="declencheur"/><field name="periodicite_txt" string="Périodicité"/><field name="prochaine_txt" string="Prochaine échéance" decoration-warning="proche"/><field name="proche" column_invisible="1"/><field name="generation"/><field name="state" widget="badge" decoration-success="state == 'actif'"/></list></field>
</record>
<record id="view_ka_mnt_plan_search" model="ir.ui.view">
    <field name="name">ka.mnt.plan.ka.search</field>
    <field name="model">ka.mnt.plan</field>
    <field name="arch" type="xml"><search><field name="intitule"/><field name="equipement_id"/><filter name="proches" string="Échéances proches" domain="[('state', '=', 'actif')]"/><filter name="g_eq" string="Équipement" context="{'group_by': 'equipement_id'}"/><filter name="g_decl" string="Déclencheur" context="{'group_by': 'declencheur'}"/></search></field>
</record>
<record id="action_ka_mnt_plan" model="ir.actions.act_window"><field name="name">Préventif</field><field name="res_model">ka.mnt.plan</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_ka_mnt_plan_search"/></record><record id="action_ka_mnt_plan_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_plan"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_mnt_plan_list"/></record><record id="action_ka_mnt_plan_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_mnt_plan"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_mnt_plan_form"/></record>
</odoo>
