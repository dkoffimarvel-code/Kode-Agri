<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_mnt_preventif" model="ir.cron">
        <field name="name">Kode Agri maintenance : génération des OT préventifs à échéance (RG-10.1)</field>
        <field name="model_id" ref="model_ka_mnt_plan"/>
        <field name="state">code</field>
        <field name="code">model._cron_echeances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_mnt_contrats" model="ir.cron">
        <field name="name">Kode Agri maintenance : échéances des contrats et visites contractuelles</field>
        <field name="model_id" ref="model_ka_mnt_contrat"/>
        <field name="state">code</field>
        <field name="code">model._cron_echeances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
