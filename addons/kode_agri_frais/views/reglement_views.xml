<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Règlement du collaborateur (écran 6.4, volet trésorerie) : virement soldant le compte 421000 -->
<record id="view_ka_frais_reglement_form" model="ir.ui.view">
    <field name="name">ka.frais.reglement.ka.form</field>
    <field name="model">ka.frais.reglement</field>
    <field name="arch" type="xml">
        <form string="Remboursement" class="o_ka_form">
            <header>
                <button string="Payer" name="action_regler" type="object" class="btn-primary" invisible="state != 'propose'"/>
                <button string="Voir l'écriture" name="action_voir_piece" type="object" class="btn-secondary"/>
                <button string="Imprimer l'avis de virement" name="action_imprimer" type="object" class="btn-primary" invisible="state != 'rembourse'"/>
                <field name="state" widget="statusbar" statusbar_visible="propose,rembourse"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Remboursement — <field name="note_id" readonly="1" class="d-inline" options="{'no_open': True}"/></h1>
                    <div class="o_ka_sub"><field name="ka_subtitle"/></div>
                </div>
                <field name="currency_id" invisible="1"/>
                <div class="o_ka_info">Paiement : le virement solde le compte tiers salarié (421000) ouvert lors de la comptabilisation, par contrepartie en trésorerie.</div>
                <group>
                    <group>
                        <field name="salarie_id" string="Bénéficiaire" readonly="1"/>
                        <field name="type_reglement" string="Mode de paiement" required="1"/>
                        <field name="iban" string="IBAN (RIB collaborateur)"/>
                    </group>
                    <group>
                        <field name="montant" string="Montant remboursé" readonly="1" class="fw-bold"/>
                        <field name="date" string="Date de paiement" readonly="state != 'propose'"/>
                        <field name="journal_id" string="Banque" required="state == 'propose'" readonly="state != 'propose'"/>
                    </group>
                </group>
                <div class="o_ka_h3 text-uppercase">Règlement généré — référence <field name="name" readonly="1" class="d-inline"/></div>
                <field name="piece_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="compte" string="Compte"/>
                        <field name="intitule" string="Libellé"/>
                        <field name="detail" string="Détail" optional="show"/>
                        <field name="debit" string="Débit" sum="Total"/>
                        <field name="credit" string="Crédit" sum="Total"/>
                    </list>
                </field>
                <div class="alert alert-success" role="status" invisible="state != 'rembourse'"><b class="d-block">Cycle terminé</b>Le rapprochement bancaire clôture la note de frais : la dette envers le collaborateur est soldée et aucune action supplémentaire n'est requise.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_frais_reglement_tree" model="ir.ui.view">
    <field name="name">ka.frais.reglement.ka.tree</field>
    <field name="model">ka.frais.reglement</field>
    <field name="arch" type="xml"><list string="ka_frais_reglement"><field name="name"/><field name="note_id"/><field name="salarie_id"/><field name="montant" sum="Total"/><field name="date"/><field name="state" widget="badge"/></list></field>
</record>
<record id="action_ka_frais_reglement" model="ir.actions.act_window"><field name="name">Remboursements de notes de frais</field><field name="res_model">ka.frais.reglement</field><field name="view_mode">list,form</field></record>
</odoo>
