<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Écran 6.1 — Saisie d'une note de frais [Saisie] -->
<record id="view_ka_frais_saisie_form" model="ir.ui.view">
    <field name="name">ka.frais.note.saisie.ka.form</field>
    <field name="model">ka.frais.note</field>
    <field name="priority">10</field>
    <field name="arch" type="xml">
        <form string="Note de frais" class="o_ka_form">
            <header>
                <button string="Joindre justificatif" name="action_joindre" type="object" class="btn-secondary"/>
                <button string="Enregistrer" special="save" class="btn-secondary"/>
                <button string="Soumettre" name="action_soumettre" type="object" class="btn-primary" invisible="state != 'saisie'"/>
                <field name="etape" widget="statusbar" statusbar_visible="saisie,a_approuver,approuvee,remboursee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="titre"/></h1>
                    <div class="o_ka_sub"><field name="sous_titre"/></div>
                </div>
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="salarie_id" string="Collaborateur" required="1"/>
                        <field name="analytic_id" string="Compte analytique" required="1"/>
                        <field name="intitule" string="Intitulé"/>
                    </group>
                    <group>
                        <field name="date_debut" string="Période" widget="daterange" options="{'end_date_field': 'date_fin'}" required="1"/>
                        <field name="date_fin" invisible="1" required="1"/>
                        <field name="total" string="Total" class="fw-bold"/>
                    </group>
                </group>
                <div class="o_ka_h3">Dépenses</div>
                <field name="line_ids" nolabel="1" readonly="state != 'saisie'">
                    <list editable="bottom" decoration-danger="depassement">
                        <field name="date" string="Date"/>
                        <field name="categorie_id" string="Catégorie"/>
                        <field name="description" string="Description"/>
                        <field name="justificatif" string="Justif."/>
                        <field name="plafond" string="Plafond" optional="hide"/>
                        <field name="montant" string="Montant" sum="Total à rembourser"/>
                        <field name="depassement" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écran 6.2 — Approbation et comptabilisation d'une note de frais [Approbation] -->
<record id="view_ka_frais_appro_form" model="ir.ui.view">
    <field name="name">ka.frais.note.appro.ka.form</field>
    <field name="model">ka.frais.note</field>
    <field name="arch" type="xml">
        <form string="Approbation" class="o_ka_form">
            <header>
                <button string="Approuver" name="action_approuver" type="object" class="btn-primary"/>
                <button string="Refuser" name="action_refuser" type="object" class="btn-secondary"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-secondary"/>
                <button string="Payer" name="action_payer" type="object" class="btn-secondary"/>
                <field name="etape_appro" widget="statusbar" statusbar_visible="saisie,a_approuver,approuvee,remboursee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1>Approbation — <field name="name" readonly="1" class="d-inline"/></h1>
                    <div class="o_ka_sub">Manager : <field name="approbateur" readonly="1" class="d-inline"/></div>
                </div>
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="o_ka_info"><field name="info_imputation"/></div>
                <group>
                    <group>
                        <field name="salarie_id" string="Demandeur" readonly="1"/>
                        <field name="total" string="Montant" class="fw-bold"/>
                        <field name="analytic_id" string="Analytique" readonly="1"/>
                    </group>
                    <group>
                        <label for="justificatifs_txt" string="Justificatifs"/>
                        <button name="action_open_justificatifs" type="object" class="btn-link p-0"><field name="justificatifs_txt" class="d-inline"/></button>
                        <field name="plafonds" string="Politique" widget="badge" decoration-success="plafonds == 'respectes'" decoration-danger="plafonds == 'depasses'"/>
                        <field name="refacturable" string="Refacturable" readonly="state != 'a_approuver'"/>
                    </group>
                </group>
                <div class="o_ka_valid"><span class="o_ka_valid_t">Validation / Approbation</span>Approbation manager → comptabilisation (charge + dette salarié) → remboursement au collaborateur.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<!-- Écrans 6.3 — Comptabilisation d'une note de frais [Comptabilisation] et 6.4 — Remboursement du collaborateur [Remboursement] -->
<record id="view_ka_frais_compta_form" model="ir.ui.view">
    <field name="name">ka.frais.note.compta.ka.form</field>
    <field name="model">ka.frais.note</field>
    <field name="arch" type="xml">
        <form string="Comptabilisation" class="o_ka_form">
            <header>
                <button string="Payer" name="action_payer" type="object" class="btn-primary" invisible="state != 'comptabilisee'"/>
                <button string="Payer" name="action_payer" type="object" class="btn-secondary" invisible="state != 'remboursee'"/>
                <button string="Comptabiliser" name="action_comptabiliser" type="object" class="btn-primary" invisible="state != 'approuvee'"/>
                <button string="Voir l'écriture" name="action_voir_piece" type="object" class="btn-secondary"/>
                <button string="Imprimer" name="action_imprimer" type="object" class="btn-secondary" invisible="state == 'remboursee'"/>
                <button string="Imprimer l'avis de virement" name="action_imprimer_avis" type="object" class="btn-primary" invisible="state != 'remboursee'"/>
                <field name="etape" widget="statusbar" statusbar_visible="saisie,a_approuver,approuvee,remboursee"/>
            </header>
            <sheet>
                <div class="oe_title">
                    <h1><field name="titre_compta"/></h1>
                    <div class="o_ka_sub"><field name="sous_titre_compta"/></div>
                </div>
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="o_ka_info" invisible="state == 'remboursee'">Comptabilisation automatique : charge ventilée par catégorie et par compte analytique, contrepartie logée au compte tiers du salarié.</div>
                <div class="o_ka_info" invisible="state != 'remboursee'">Paiement : le virement solde le compte tiers salarié (421000) ouvert lors de la comptabilisation, par contrepartie en trésorerie.</div>
                <group invisible="state == 'remboursee'">
                    <group>
                        <field name="salarie_id" string="Demandeur" readonly="1"/>
                        <field name="analytic_id" string="Compte analytique" readonly="1"/>
                        <label for="justificatifs_txt" string="Pièce justificative"/>
                        <button name="action_open_justificatifs" type="object" class="btn-link p-0" icon="fa-paperclip"><field name="justificatifs_txt" class="d-inline"/></button>
                    </group>
                    <group>
                        <field name="total" string="Montant comptabilisé" class="fw-bold"/>
                        <field name="date_compta" string="Date comptable"/>
                        <field name="badge_label" string="Statut de l'écriture" widget="badge" decoration-success="state in ('comptabilisee', 'remboursee')" decoration-warning="state == 'approuvee'"/>
                    </group>
                </group>
                <group invisible="state != 'remboursee'">
                    <group>
                        <field name="salarie_id" string="Bénéficiaire" readonly="1"/>
                        <field name="regl_type" string="Mode de paiement"/>
                        <field name="regl_iban" string="IBAN (RIB collaborateur)"/>
                    </group>
                    <group>
                        <field name="total" string="Montant remboursé" class="fw-bold"/>
                        <field name="regl_date" string="Date de paiement"/>
                        <field name="badge_label" string="Statut" widget="badge" decoration-success="1"/>
                    </group>
                </group>
                <div class="o_ka_h3 text-uppercase"><field name="ecriture_titre"/></div>
                <field name="ecriture_html" nolabel="1"/>
                <div class="o_ka_valid" invisible="state == 'remboursee'"><span class="o_ka_valid_t">Comptabilisation → remboursement</span>L'écriture comptabilisée constate la charge et ouvre la dette envers le salarié sur le compte 421000. Cette dette reste ouverte jusqu'au paiement, qui la soldera lors du remboursement (Écran 6.4).</div>
                <div class="alert alert-success" role="status" invisible="state != 'remboursee'"><b class="d-block">Cycle terminé</b>Le rapprochement bancaire clôture la note de frais : la dette envers le collaborateur est soldée et aucune action supplémentaire n'est requise.</div>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>
<record id="view_ka_frais_note_tree" model="ir.ui.view">
    <field name="name">ka.frais.note.ka.tree</field>
    <field name="model">ka.frais.note</field>
    <field name="arch" type="xml"><list string="ka_frais_note"><field name="name"/><field name="intitule"/><field name="salarie_id"/><field name="date_debut"/><field name="analytic_id"/><field name="total" sum="Total"/><field name="state" widget="badge" decoration-info="state == 'saisie'" decoration-warning="state == 'a_approuver'" decoration-success="state in ('approuvee', 'comptabilisee', 'remboursee')" decoration-danger="state == 'refusee'"/></list></field>
</record>
<record id="action_ka_frais_saisie" model="ir.actions.act_window"><field name="name">Mes frais</field><field name="res_model">ka.frais.note</field><field name="view_mode">list,form</field></record><record id="action_ka_frais_saisie_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_saisie"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_frais_note_tree"/></record><record id="action_ka_frais_saisie_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_saisie"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_frais_saisie_form"/></record>
<record id="action_ka_frais_appro" model="ir.actions.act_window"><field name="name">À approuver</field><field name="res_model">ka.frais.note</field><field name="view_mode">list,form</field><field name="domain">[('state','=','a_approuver')]</field></record><record id="action_ka_frais_appro_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_appro"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_frais_note_tree"/></record><record id="action_ka_frais_appro_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_appro"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_frais_appro_form"/></record>
<record id="action_ka_frais_compta" model="ir.actions.act_window"><field name="name">Comptabilisation</field><field name="res_model">ka.frais.note</field><field name="view_mode">list,form</field><field name="domain">[('state','in',('approuvee','comptabilisee','remboursee'))]</field></record><record id="action_ka_frais_compta_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_compta"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_frais_note_tree"/></record><record id="action_ka_frais_compta_v1" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_compta"/><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_ka_frais_compta_form"/></record>
<!-- États : toutes les notes de frais (analyse) -->
<record id="action_ka_frais_etat" model="ir.actions.act_window"><field name="name">Notes de frais</field><field name="res_model">ka.frais.note</field><field name="view_mode">list,pivot,graph</field></record><record id="action_ka_frais_etat_v0" model="ir.actions.act_window.view"><field name="act_window_id" ref="action_ka_frais_etat"/><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_ka_frais_note_tree"/></record>
<record id="action_ka_frais_categorie" model="ir.actions.act_window"><field name="name">Catégories de frais</field><field name="res_model">ka.frais.categorie</field><field name="view_mode">list,form</field></record>
<record id="view_ka_frais_categorie_tree" model="ir.ui.view">
    <field name="name">ka.frais.categorie.ka.tree</field>
    <field name="model">ka.frais.categorie</field>
    <field name="arch" type="xml"><list string="ka_frais_categorie"><field name="code"/><field name="name"/><field name="compte_code"/><field name="plafond" sum="Total"/></list></field>
</record>
</odoo>
