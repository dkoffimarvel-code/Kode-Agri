<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav" position="inside">
            <div class="o_ka_navctx">
                <span class="o_ka_brand"><b>Kode</b> Agri</span>
                <span class="o_ka_sep"/>
                <span>Dossier : <t t-esc="kaContext.dossier"/></span>
                <span class="o_ka_dot">·</span>
                <span>Société : <t t-esc="kaContext.societe"/></span>
            </div>
        </xpath>
    </t>
</templates>
